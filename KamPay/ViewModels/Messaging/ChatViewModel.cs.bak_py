        public IEnumerable<Message> FilteredMessages =>
            SelectedFilterTransactionId == NullTransactionFilter
                ? Messages
                : Messages.Where(m =>
                    m.RelatedTransactionId == SelectedFilterTransactionId ||
                    m.Type == MessageType.System ||
                    m.Type == MessageType.Negotiation);

