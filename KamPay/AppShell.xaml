<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="KamPay.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:KamPay.Views"
    xmlns:vm="clr-namespace:KamPay.ViewModels"
    xmlns:services="clr-namespace:KamPay.Services"
    x:DataType="vm:AppShellViewModel"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False">

    <!-- Login Page - Giriş ekranı için ayrı route -->
    <ShellContent
        Route="LoginPage"
        ContentTemplate="{DataTemplate local:LoginPage}"
        Shell.FlyoutBehavior="Disabled" />

    <!-- Main App - Ana uygulama TabBar -->
    <TabBar Route="MainApp">
        <Tab Title="{Binding HomeTitle}" Icon="home_icon.svg">
            <ShellContent ContentTemplate="{DataTemplate local:ProductListPage}" Route="ProductListPage" />
        </Tab>

        <Tab Title="{Binding ServicesTitle}" Icon="briefcase.png">
            <ShellContent ContentTemplate="{DataTemplate local:ServiceSharingPage}" Route="ServiceSharingPage" />
        </Tab>

        <Tab Title="{Binding GoodDeedBoardTitle}" Icon="good_board.png">
            <ShellContent ContentTemplate="{DataTemplate local:GoodDeedBoardPage}" Route="GoodDeedBoardPage" />
        </Tab>

        <Tab Title="{Binding MessagesTitle}" Icon="message_icon.svg">
            <ShellContent ContentTemplate="{DataTemplate local:MessagesPage}" Route="MessagesPage" />
        </Tab>

        <Tab Title="{Binding ProfileTitle}" Icon="person_icon.png">
            <ShellContent ContentTemplate="{DataTemplate local:ProfilePage}" Route="ProfilePage" />
        </Tab>
        
        <Tab Title="{Binding FavoritesTitle}" Icon="heart_icon.png">
            <ShellContent ContentTemplate="{DataTemplate local:FavoritesPage}" Route="FavoritesPage" />
        </Tab>
    </TabBar>
</Shell>