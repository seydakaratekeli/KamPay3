<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="KamPay.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:KamPay.Views"
    xmlns:services="clr-namespace:KamPay.Services"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False">

    <!-- Login Page - Giriş ekranı için ayrı route -->
    <ShellContent
        Route="LoginPage"
        ContentTemplate="{DataTemplate local:LoginPage}"
        Shell.FlyoutBehavior="Disabled" />

    <!-- Main App - Ana uygulama TabBar -->
    <TabBar Route="MainApp">
        <Tab Title="{Binding Source={x:Static services:LocalizationResourceManager.Instance}, Path=[Home]}" Icon="home_icon.svg">
            <ShellContent ContentTemplate="{DataTemplate local:ProductListPage}" Route="ProductListPage" />
        </Tab>

        <Tab Title="{Binding Source={x:Static services:LocalizationResourceManager.Instance}, Path=[Services]}" Icon="service_icon.svg">
            <ShellContent ContentTemplate="{DataTemplate local:ServiceSharingPage}" Route="ServiceSharingPage" />
        </Tab>

        <Tab Title="{Binding Source={x:Static services:LocalizationResourceManager.Instance}, Path=[GoodDeedBoard]}" Icon="gooddeed_icon.svg">
            <ShellContent ContentTemplate="{DataTemplate local:GoodDeedBoardPage}" Route="GoodDeedBoardPage" />
        </Tab>

        <Tab Title="{Binding Source={x:Static services:LocalizationResourceManager.Instance}, Path=[Messages]}" Icon="messages_icon.svg">
            <ShellContent ContentTemplate="{DataTemplate local:MessagesPage}" Route="MessagesPage" />
        </Tab>

        <Tab Title="{Binding Source={x:Static services:LocalizationResourceManager.Instance}, Path=[Profile]}" Icon="profile_icon.svg">
            <ShellContent ContentTemplate="{DataTemplate local:ProfilePage}" Route="ProfilePage" />
        </Tab>
    </TabBar>
</Shell>