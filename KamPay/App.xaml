<?xml version="1.0" encoding="UTF-8"?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:KamPay.Converters"
             x:Class="KamPay.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 🎨 MODERN MAVİ TEMA PALETİ -->
            <Color x:Key="Primary">#1E88E5</Color>
            <Color x:Key="PrimaryDark">#1565C0</Color>
            <Color x:Key="PrimaryLight">#42A5F5</Color>
            <Color x:Key="Accent">#64B5F6</Color>
            <Color x:Key="Secondary">#26C6DA</Color>
            <Color x:Key="Background">#F5F9FC</Color>
            <Color x:Key="Surface">#FFFFFF</Color>
            <Color x:Key="Error">#EF5350</Color>
            <Color x:Key="Success">#66BB6A</Color>
            <Color x:Key="Warning">#FFA726</Color>
            <Color x:Key="TextPrimary">#212121</Color>
            <Color x:Key="TextSecondary">#757575</Color>
            <Color x:Key="TextHint">#9E9E9E</Color>
            <Color x:Key="Divider">#E0E0E0</Color>
            
            <!-- Gradient Colors -->
            <Color x:Key="GradientStart">#1E88E5</Color>
            <Color x:Key="GradientEnd">#1565C0</Color>

            <!-- 🎭 MODERN STYLES -->
            <Style x:Key="ModernCard" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{StaticResource Surface}"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="HasShadow" Value="True"/>
                <Setter Property="Padding" Value="20"/>
                <Setter Property="Margin" Value="0,8"/>
            </Style>

            <Style x:Key="ModernEntry" TargetType="Entry">
                <Setter Property="BackgroundColor" Value="{StaticResource Surface}"/>
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
                <Setter Property="PlaceholderColor" Value="{StaticResource TextHint}"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="HeightRequest" Value="56"/>
                <Setter Property="Margin" Value="0,8"/>
            </Style>

            <Style x:Key="ModernButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Primary}"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="CornerRadius" Value="28"/>
                <Setter Property="HeightRequest" Value="56"/>
                <Setter Property="Margin" Value="0,8"/>
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup>
                            <VisualState x:Name="Normal"/>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="0.96"/>
                                    <Setter Property="Opacity" Value="0.8"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="TextColor" Value="{StaticResource Primary}"/>
                <Setter Property="BorderColor" Value="{StaticResource Primary}"/>
                <Setter Property="BorderWidth" Value="2"/>
            </Style>

            <Style x:Key="TitleLabel" TargetType="Label">
                <Setter Property="FontSize" Value="32"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="White"/>
            </Style>

            <Style x:Key="SubtitleLabel" TargetType="Label">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="Opacity" Value="0.9"/>
            </Style>

            <!--  Existing Converters -->
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
            <converters:IsNotNullOrEmptyConverter x:Key="IsNotNullOrEmptyConverter"/>
            <converters:IsNotZeroConverter x:Key="IsNotZeroConverter"/>
            <converters:BoolToColorConverter x:Key="BoolToColorConverter" TrueColor="White" FalseColor="#E8F5E9"/>
            <converters:BoolToTextConverter x:Key="BoolToTextConverter"/>
            <converters:IsPendingConverter x:Key="IsPendingConverter"/>
            <converters:ProductCategoryToTextConverter x:Key="ProductCategoryToTextConverter"/>
            <converters:ServiceCategoryToTextConverter x:Key="ServiceCategoryToTextConverter"/>
            <converters:ServiceCategoryToIconConverter x:Key="ServiceCategoryToIconConverter"/>
            <converters:ProductTypeToEmojiConverter x:Key="ProductTypeToEmojiConverter"/>
            <converters:ProductTypeToBadgeTextConverter x:Key="ProductTypeToBadgeTextConverter"/>
            <converters:ProductTypeShowPriceConverter x:Key="ProductTypeShowPriceConverter"/>
            <converters:ProductSortOptionToTextConverter x:Key="ProductSortOptionToTextConverter"/>
            <converters:UnreadToIconConverter x:Key="UnreadToIconConverter"/>
            <converters:DateTimeToTimeAgoConverter x:Key="DateTimeToTimeAgoConverter"/>
            <converters:IsCurrentUserConverter x:Key="IsCurrentUserConverter"/>
            <converters:AllTrueConverter x:Key="AllTrueConverter"/>
            <converters:IsAcceptedConverter x:Key="IsAcceptedConverter"/>
            <converters:IsNegotiatingConverter x:Key="IsNegotiatingConverter"/>
            <converters:IsSaleConverter x:Key="IsSaleConverter"/>
            <converters:IsTradeConverter x:Key="IsTradeConverter"/>
            <converters:SimulatePaymentButtonVisibilityConverter x:Key="SimulatePaymentButtonVisibilityConverter"/>
            <converters:ConfirmDonationButtonVisibilityConverter x:Key="ConfirmDonationButtonVisibilityConverter"/>
            <converters:LessThan100Converter x:Key="LessThan100Converter"/>
            <converters:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
            <converters:PostTypeToTextConverter x:Key="PostTypeToTextConverter"/>
            <converters:PostTypeToIconConverter x:Key="PostTypeToIconConverter"/>
            <converters:ProductTypeConverter x:Key="ProductTypeConverter"/>
            <converters:ProductConditionConverter x:Key="ProductConditionConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>