<?xml version="1.0" encoding="UTF-8"?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:KamPay.Converters"
             xmlns:behaviors="clr-namespace:KamPay.Behaviors"
             x:Class="KamPay.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- MODERN STYLES -->
            <Style x:Key="ModernCard" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{StaticResource Surface}"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="HasShadow" Value="True"/>
                <Setter Property="Padding" Value="20"/>
                <Setter Property="Margin" Value="0,8"/>
            </Style>

            <Style x:Key="ModernEntry" TargetType="Entry">
                <Setter Property="BackgroundColor" Value="{StaticResource Surface}"/>
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
                <Setter Property="PlaceholderColor" Value="{StaticResource TextHint}"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="HeightRequest" Value="56"/>
                <Setter Property="Margin" Value="0,8"/>
            </Style>

            <Style x:Key="ModernButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Primary}"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="CornerRadius" Value="28"/>
                <Setter Property="HeightRequest" Value="56"/>
                <Setter Property="Margin" Value="0,8"/>
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup>
                            <VisualState x:Name="Normal"/>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="0.96"/>
                                    <Setter Property="Opacity" Value="0.8"/>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="TextColor" Value="{StaticResource Primary}"/>
                <Setter Property="BorderColor" Value="{StaticResource Primary}"/>
                <Setter Property="BorderWidth" Value="2"/>
            </Style>

            <Style x:Key="TitleLabel" TargetType="Label">
                <Setter Property="FontSize" Value="32"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="White"/>
            </Style>

            <Style x:Key="SubtitleLabel" TargetType="Label">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="Opacity" Value="0.9"/>
            </Style>

            <!-- ═══════════════════════════════════════ -->
            <!--  MEVCUT CONVERTER'LAR (değişmedi)       -->
            <!-- ═══════════════════════════════════════ -->
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
            <converters:BoolToMultiColorConverter x:Key="BoolToMultiColorConverter"/>
            <converters:IsNotNullOrEmptyConverter x:Key="IsNotNullOrEmptyConverter"/>
            <converters:IsNotZeroConverter x:Key="IsNotZeroConverter"/>
            <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
            <converters:BoolToTextConverter x:Key="BoolToTextConverter"/>
            <converters:IsPendingConverter x:Key="IsPendingConverter"/>
            <converters:ProductCategoryToTextConverter x:Key="ProductCategoryToTextConverter"/>
            <converters:ServiceCategoryToTextConverter x:Key="ServiceCategoryToTextConverter"/>
            <converters:ServiceCategoryToIconConverter x:Key="ServiceCategoryToIconConverter"/>
            <converters:ProductTypeToEmojiConverter x:Key="ProductTypeToEmojiConverter"/>
            <converters:ProductTypeToBadgeTextConverter x:Key="ProductTypeToBadgeTextConverter"/>
            <converters:ProductTypeShowPriceConverter x:Key="ProductTypeShowPriceConverter"/>
            <converters:ProductSortOptionToTextConverter x:Key="ProductSortOptionToTextConverter"/>
            <converters:DateTimeToTimeAgoConverter x:Key="DateTimeToTimeAgoConverter"/>
            <converters:IsCurrentUserConverter x:Key="IsCurrentUserConverter"/>
            <converters:AllTrueConverter x:Key="AllTrueConverter"/>
            <converters:IsAcceptedConverter x:Key="IsAcceptedConverter"/>
            <converters:IsNegotiatingConverter x:Key="IsNegotiatingConverter"/>
            <converters:SimulatePaymentButtonVisibilityConverter x:Key="SimulatePaymentButtonVisibilityConverter"/>
            <converters:ConfirmDonationButtonVisibilityConverter x:Key="ConfirmDonationButtonVisibilityConverter"/>
            <converters:LessThan100Converter x:Key="LessThan100Converter"/>
            <converters:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
            <converters:PostTypeToTextConverter x:Key="PostTypeToTextConverter"/>
            <converters:PostTypeToIconConverter x:Key="PostTypeToIconConverter"/>
            <converters:ProductTypeConverter x:Key="ProductTypeConverter"/>
            <converters:ProductConditionConverter x:Key="ProductConditionConverter"/>
            <converters:ProductToStatusTextConverter x:Key="ProductToStatusTextConverter"/>
            <converters:ProductToStatusColorConverter x:Key="ProductToStatusColorConverter"/>
            <converters:ProductToPriceTextConverter x:Key="ProductToPriceTextConverter"/>

            <!-- ═══════════════════════════════════════════════════════ -->
            <!--  ✅ FAZ 6 YENİ: Genel amaçlı fiyat format converter    -->
            <!--  Kullanım: {Binding Price, Converter={StaticResource PriceFormatConverter}} -->
            <!--  Çıktı: "₺1.500,00"  |  ConverterParameter="NoSymbol" → "1.500,00" -->
            <!-- ═══════════════════════════════════════════════════════ -->
            <converters:PriceFormatConverter x:Key="PriceFormatConverter"/>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!--  ✅ FAZ 7 YENİ: Pazarlık durum metni (mevcut + kalan süre)     -->
            <!--  Kullanım: {Binding ., Converter={StaticResource NegotiationStatusTextConverter}} -->
            <!--  ConverterParameter="TimeOnly" → sadece "⏱️ 23s 45dk kaldı"   -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <converters:NegotiationStatusTextConverter x:Key="NegotiationStatusTextConverter"/>

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!--  ✅ FAZ 7 YENİ: Pazarlık arka plan rengi                       -->
            <!--  Normal → AccentOrange | Son 2 saat → Error | Dolmuş → Gray    -->
            <!--  Kullanım: BackgroundColor="{Binding ., Converter={StaticResource NegotiationTimerColorConverter}}" -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <converters:NegotiationTimerColorConverter x:Key="NegotiationTimerColorConverter"/>

        </ResourceDictionary>
    </Application.Resources>
</Application>
