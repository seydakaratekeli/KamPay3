<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>KamPay</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- EOL workload uyarısını kapat -->
		<CheckEolWorkloads>false</CheckEolWorkloads>

		<ApplicationTitle>KamPay</ApplicationTitle>
		<ApplicationId>com.companyname.kampay</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<TargetPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">36.0</TargetPlatformVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<TargetPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">14.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup>
	  <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
	<!-- Gelişmiş kod kırpma (kullanılmayan kodları siler), dosya boyutunu küçültür -->
	<TrimMode>full</TrimMode>

	<!-- Android için Native AOT (Ahead-of-Time) derlemesi, ilk açılış hızını devasa oranda artırır -->
	<PublishAot Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">true</PublishAot>

	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>


	<ItemGroup>
		<EmbeddedResource Include="appsettings.json">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<MauiImage Remove="Resources\Images\default_avatar.png" />
		<MauiImage Remove="Resources\Images\dotnet_bot.png" />
	</ItemGroup>


	<ItemGroup>
		<EmbeddedResource Update="Resources\Languages\AppResources.resx">
			<Generator>PublicResXFileCodeGenerator</Generator>
			<LastGenOutput>AppResources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
		<EmbeddedResource Update="Resources\Languages\AppResources.en.resx">
			<DependentUpon>AppResources.resx</DependentUpon>
		</EmbeddedResource>
		<Compile Update="Resources\Languages\AppResources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>AppResources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="9.0.0" />
		<!-- <PackageReference Include="CommunityToolkit.Maui.Core" Version="9.0.0" /> Toolkit zaten Core barındırır, ekstra yazmaya gerek yok -->
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
		<PackageReference Include="FFImageLoading.Maui" Version="1.2.4" />
		<PackageReference Include="FirebaseDatabase.net" Version="4.2.0" />
		<PackageReference Include="FirebaseStorage.net" Version="1.0.3" />
		<!--  Firebase Authentication -->
		<PackageReference Include="FirebaseAuthentication.net" Version="3.7.2" />
		<PackageReference Include="LiteDB" Version="5.0.21" />
		<PackageReference Include="Mapsui.Maui" Version="5.0.0" />

		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<!-- <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" /> .NET 10'da Legacy Renderer yoksa kapalı olmalı, yavaşlatır -->
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.5" />
		<PackageReference Include="SkiaSharp" Version="3.119.1" />
		<PackageReference Include="ZXing.Net.Maui" Version="0.4.0" />
		<PackageReference Include="ZXing.Net.Maui.Controls" Version="0.4.0" />

		<!-- .NET 10 SEBEBİYLE KAPATILAN PAKETLER: AndroidX ve çakışma çözücü paketler .NET 10 MAUI içinde native günceldir.
			 (ÖZEL Glide Handler dosyanız hata verirse sadece Glide'ı tekrar açın) -->
		<!-- <PackageReference Include="Xamarin.Android.Glide" Version="4.16.0.14" Condition="$(TargetFramework.Contains('android'))" /> -->
		<!-- <PackageReference Include="Xamarin.AndroidX.RecyclerView" Version="1.4.0.3" Condition="$(TargetFramework.Contains('android'))" /> -->
		<!-- <PackageReference Include="Xamarin.AndroidX.Collection" Version="1.5.0.3" Condition="$(TargetFramework.Contains('android'))" /> -->
		<!-- <PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.5.0.3" Condition="$(TargetFramework.Contains('android'))" /> -->
		<!-- <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime" Version="2.9.2.1" Condition="$(TargetFramework.Contains('android'))" /> -->
		<!-- <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" Version="2.9.2.1" Condition="$(TargetFramework.Contains('android'))" /> -->
	</ItemGroup>

