<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KamPay.ViewModels"
             xmlns:models="clr-namespace:KamPay.Models"
             xmlns:converters="clr-namespace:KamPay.Converters"
             xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
             xmlns:res="clr-namespace:KamPay.Services"
             x:Class="KamPay.Views.OffersPage"
             x:DataType="vm:OffersViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F5F9FC">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#1E88E5</Color>
            <Color x:Key="PrimaryDark">#1565C0</Color>
            <Color x:Key="Surface">#FFFFFF</Color>
            <Color x:Key="Background">#F5F9FC</Color>
            <Color x:Key="TextPrimary">#212121</Color>
            <Color x:Key="TextSecondary">#757575</Color>
            <Color x:Key="AccentGreen">#4CAF50</Color>
            <Color x:Key="AccentOrange">#FF9800</Color>
            <Color x:Key="AccentRed">#F44336</Color>

            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
            <converters:IsAcceptedConverter x:Key="IsAcceptedConverter" />
            <converters:IsPendingConverter x:Key="IsPendingConverter" />
            <converters:ConfirmDonationButtonVisibilityConverter x:Key="ConfirmDonationButtonVisibilityConverter"/>
            <converters:SimulatePaymentButtonVisibilityConverter x:Key="SimulatePaymentButtonVisibilityConverter"/>
            <converters:IsSaleConverter x:Key="IsSaleConverter"/>
            <converters:IsTradeConverter x:Key="IsTradeConverter"/>
            <converters:AllTrueConverter x:Key="AllTrueConverter"/>
            <converters:IsCurrentUserConverter x:Key="IsCurrentUserConverter"/>
            <converters:ProductTypeToEmojiConverter x:Key="ProductTypeToEmojiConverter"/>
            <converters:IsNegotiatingConverter x:Key="IsNegotiatingConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ✨ GRADIENT HEADER -->
        <Grid Grid.Row="0" x:Name="HeaderSection">
            <BoxView>
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1E88E5" Offset="0.0" />
                        <GradientStop Color="#1565C0" Offset="1.0" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

            <Ellipse x:Name="Circle1" 
                     WidthRequest="150" 
                     HeightRequest="150"
                     Fill="White"
                     Opacity="0.05"
                     HorizontalOptions="End"
                     VerticalOptions="Start"
                     Margin="0,-60,-60,0"/>

            <Label Text="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[OffersTitle]}"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="White"
                   Margin="20,50,20,20"
                   HorizontalTextAlignment="Center"/>
        </Grid>

        <!-- ✨ TAB BUTTONS -->
        <Grid Grid.Row="1" 
              ColumnDefinitions="*,*" 
              Padding="15,10" 
              ColumnSpacing="10" 
              BackgroundColor="White"
              x:Name="TabSection">

            <Border Grid.Column="0"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="0"
                    HeightRequest="45"
                    BackgroundColor="{Binding IsIncomingSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#1E88E5|White'}">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource Primary}" Offset="0,2" Radius="6" Opacity="0.3"/>
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectIncomingCommand}"/>
                </Border.GestureRecognizers>
                <Label Text="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[IncomingOffers]}"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{Binding IsIncomingSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='White|#1E88E5'}"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"/>
            </Border>

            <Border Grid.Column="1"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="0"
                    HeightRequest="45"
                    BackgroundColor="{Binding IsOutgoingSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#1E88E5|White'}">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource Primary}" Offset="0,2" Radius="6" Opacity="0.3"/>
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectOutgoingCommand}"/>
                </Border.GestureRecognizers>
                <Label Text="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[OutgoingOffers]}"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{Binding IsOutgoingSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='White|#1E88E5'}"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"/>
            </Border>
        </Grid>

        <!-- ✨ MAIN CONTENT -->
        <Grid Grid.Row="2">
            <RefreshView Command="{Binding RefreshOffersCommand}"
                         IsRefreshing="{Binding IsRefreshing}"
                         RefreshColor="{StaticResource Primary}"
                         x:Name="ContentSection">

                <Grid>
                    <!-- GELEN TEKLİFLER -->
                    <CollectionView ItemsSource="{Binding IncomingOffers}"
                                    IsVisible="{Binding IsIncomingSelected}"
                                    Margin="15,10">

                        <CollectionView.EmptyView>
                            <Grid VerticalOptions="Center" HorizontalOptions="Center" Padding="30">
                                <Border BackgroundColor="White"
                                        StrokeThickness="0"
                                        Padding="30"
                                        WidthRequest="280"
                                        HeightRequest="200">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20"/>
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Opacity="0.08" Radius="15" Offset="0,4"/>
                                    </Border.Shadow>
                                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label Text="📥" FontSize="60" HorizontalTextAlignment="Center"/>
                                        <Label Text="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[NoIncomingOffers]}"
                                               FontSize="16"
                                               TextColor="{StaticResource TextSecondary}"
                                               HorizontalTextAlignment="Center"
                                               FontAttributes="Bold"/>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Transaction">
                                <Border Margin="0,0,0,12"
                                        StrokeShape="RoundRectangle 16"
                                        StrokeThickness="0"
                                        BackgroundColor="White"
                                        Padding="15">
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Offset="0,2" Radius="10" Opacity="0.08"/>
                                    </Border.Shadow>

                                    <VerticalStackLayout Spacing="12">
                                        <Grid ColumnDefinitions="90,*" ColumnSpacing="12">
                                            <Border Grid.Column="0"
                                                    StrokeShape="RoundRectangle 12"
                                                    StrokeThickness="0"
                                                    WidthRequest="90"
                                                    HeightRequest="90">
                                                <ffimageloading:CachedImage 
                                                    Source="{Binding ProductThumbnailUrl}"
                                                    Aspect="AspectFill"
                                                    LoadingPlaceholder="loading_image.png"
                                                    ErrorPlaceholder="error_image.png"/>
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Label Grid.Column="0"
                                                           Text="{Binding ProductTitle}"
                                                           TextColor="{StaticResource TextPrimary}"
                                                           FontAttributes="Bold"
                                                           FontSize="16"
                                                           LineBreakMode="TailTruncation"
                                                           MaxLines="1"/>
                                                    <Label Grid.Column="1"
                                                           Text="{Binding StatusText}"
                                                           FontSize="11"
                                                           TextColor="{StaticResource Primary}"
                                                           FontAttributes="Bold"/>
                                                </Grid>

                                                <Label Text="{Binding BuyerName, StringFormat='Talep Eden: {0}'}"
                                                       FontSize="13"
                                                       TextColor="{StaticResource TextSecondary}"/>

                                                <Label Text="{Binding Message}"
                                                       FontSize="13"
                                                       MaxLines="2"
                                                       LineBreakMode="TailTruncation"
                                                       TextColor="{StaticResource TextPrimary}"/>

                                                <Label Text="{Binding Price, StringFormat='{0} ₺'}"
                                                       TextColor="{StaticResource Primary}"
                                                       FontAttributes="Bold"
                                                       FontSize="18"/>
                                            </VerticalStackLayout>
                                        </Grid>

                                        <Border IsVisible="{Binding IsNegotiating}"
                                               StrokeShape="RoundRectangle 12"
                                               StrokeThickness="0"
                                               BackgroundColor="{StaticResource AccentOrange}"
                                               Padding="12">
                                            <VerticalStackLayout Spacing="5">
                                                <Label FontAttributes="Bold" TextColor="White" FontSize="13">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding Type, Converter={StaticResource ProductTypeToEmojiConverter}}"/>
                                                            <Span Text=" Pazarlık Devam Ediyor"/>
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <Label Text="{Binding NegotiationStatusText}"
                                                       TextColor="White"
                                                       FontSize="12"/>
                                            </VerticalStackLayout>
                                        </Border>

                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                                            <Button Grid.Column="1"
                                                    Text="💬"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:OffersViewModel}}, Path=MessagePartnerCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#E3F2FD"
                                                    TextColor="{StaticResource Primary}"
                                                    WidthRequest="45"
                                                    HeightRequest="45"
                                                    CornerRadius="22"
                                                    FontSize="18"
                                                    Padding="0"/>

                                            <Button Grid.Column="2"
                                                    Text="💰"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:OffersViewModel}}, Path=SendCounterOfferCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#FFF3E0"
                                                    TextColor="{StaticResource AccentOrange}"
                                                    WidthRequest="45"
                                                    HeightRequest="45"
                                                    CornerRadius="22"
                                                    FontSize="18"
                                                    Padding="0">
                                                <Button.IsVisible>
                                                    <MultiBinding Converter="{StaticResource AllTrueConverter}">
                                                        <Binding Path="Type" Converter="{StaticResource IsSaleConverter}"/>
                                                        <Binding Path="Status" Converter="{StaticResource IsPendingConverter}"/>
                                                        <Binding Path="SellerId" Converter="{StaticResource IsCurrentUserConverter}"/>
                                                    </MultiBinding>
                                                </Button.IsVisible>
                                            </Button>

                                            <Button Grid.Column="3"
                                                    Text="✓"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:OffersViewModel}}, Path=AcceptOfferCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="{StaticResource AccentGreen}"
                                                    TextColor="White"
                                                    WidthRequest="45"
                                                    HeightRequest="45"
                                                    CornerRadius="22"
                                                    FontSize="20"
                                                    Padding="0"
                                                    IsVisible="{Binding Status, Converter={StaticResource IsPendingConverter}}"/>

                                            <Button Grid.Column="4"
                                                    Text="✕"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:OffersViewModel}}, Path=RejectOfferCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="{StaticResource AccentRed}"
                                                    TextColor="White"
                                                    WidthRequest="45"
                                                    HeightRequest="45"
                                                    CornerRadius="22"
                                                    FontSize="20"
                                                    Padding="0"
                                                    IsVisible="{Binding Status, Converter={StaticResource IsPendingConverter}}"/>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- GİDEN TEKLİFLER -->
                    <CollectionView ItemsSource="{Binding OutgoingOffers}"
                                    IsVisible="{Binding IsOutgoingSelected}"
                                    Margin="15,10">

                        <CollectionView.EmptyView>
                            <Grid VerticalOptions="Center" HorizontalOptions="Center" Padding="30">
                                <Border BackgroundColor="White"
                                        StrokeThickness="0"
                                        Padding="30"
                                        WidthRequest="280"
                                        HeightRequest="200">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20"/>
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Opacity="0.08" Radius="15" Offset="0,4"/>
                                    </Border.Shadow>
                                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center" VerticalOptions="Center">
										<Label Text="📤" FontSize="60" HorizontalTextAlignment="Center"/>
                                        <Label Text="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[NoOutgoingOffers]}"
                                               FontSize="16"
                                               TextColor="{StaticResource TextSecondary}"
                                               HorizontalTextAlignment="Center"
                                               FontAttributes="Bold"/>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Transaction">
                                <Border Margin="0,0,0,12"
                                        StrokeShape="RoundRectangle 16"
                                        StrokeThickness="0"
                                        BackgroundColor="White"
                                        Padding="15">
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Offset="0,2" Radius="10" Opacity="0.08"/>
                                    </Border.Shadow>

                                    <VerticalStackLayout Spacing="12">
                                        <Grid ColumnDefinitions="90,*" ColumnSpacing="12">
                                            <Border Grid.Column="0"
                                                    StrokeShape="RoundRectangle 12"
                                                    StrokeThickness="0"
                                                    WidthRequest="90"
                                                    HeightRequest="90">
                                                <ffimageloading:CachedImage 
                                                    Source="{Binding ProductThumbnailUrl}"
                                                    Aspect="AspectFill"
                                                    LoadingPlaceholder="loading_image.png"
                                                    ErrorPlaceholder="error_image.png"/>
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Label Grid.Column="0"
                                                           Text="{Binding ProductTitle}"
                                                           FontAttributes="Bold"
                                                           FontSize="16"
                                                           TextColor="{StaticResource TextPrimary}"
                                                           LineBreakMode="TailTruncation"
                                                           MaxLines="1"/>
                                                    <Label Grid.Column="1"
                                                           Text="{Binding StatusText}"
                                                           FontSize="11"
                                                           TextColor="{StaticResource Primary}"
                                                           FontAttributes="Bold"/>
                                                </Grid>

                                                <Label Text="{Binding SellerName, StringFormat='Satıcı: {0}'}"
                                                       FontSize="13"
                                                       TextColor="{StaticResource TextSecondary}"/>

                                                <Label Text="{Binding Message}"
                                                       FontSize="13"
                                                       MaxLines="2"
                                                       LineBreakMode="TailTruncation"
                                                       TextColor="{StaticResource TextPrimary}"/>

                                                <Label Text="{Binding Price, StringFormat='{0} ₺'}"
                                                       TextColor="{StaticResource Primary}"
                                                       FontAttributes="Bold"
                                                       FontSize="18"/>
                                            </VerticalStackLayout>
                                        </Grid>

                                        <Border IsVisible="{Binding IsNegotiating}"
                                               StrokeShape="RoundRectangle 12"
                                               StrokeThickness="0"
                                               BackgroundColor="{StaticResource AccentOrange}"
                                               Padding="12">
                                            <VerticalStackLayout Spacing="5">
                                                <Label FontAttributes="Bold" TextColor="White" FontSize="13">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding Type, Converter={StaticResource ProductTypeToEmojiConverter}}"/>
                                                            <Span Text=" Pazarlık Devam Ediyor"/>
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <Label Text="{Binding NegotiationStatusText}"
                                                       TextColor="White"
                                                       FontSize="12"/>
                                            </VerticalStackLayout>
                                        </Border>

                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                            <Button Grid.Column="1"
                                                    Text="💬"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:OffersViewModel}}, Path=MessagePartnerCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#E3F2FD"
                                                    TextColor="{StaticResource Primary}"
                                                    WidthRequest="45"
                                                    HeightRequest="45"
                                                    CornerRadius="22"
                                                    FontSize="18"
                                                    Padding="0"/>

                                            <Button Grid.Column="2"
                                                    Text="✓"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:OffersViewModel}}, Path=CompletePaymentCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="{StaticResource AccentGreen}"
                                                    TextColor="White"
                                                    WidthRequest="45"
                                                    HeightRequest="45"
                                                    CornerRadius="22"
                                                    FontSize="20"
                                                    Padding="0"
                                                    IsVisible="{Binding Path=., Converter={StaticResource SimulatePaymentButtonVisibilityConverter}}"/>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </RefreshView>

            <!-- Loading Overlay -->
            <Grid IsVisible="{Binding IsLoading}"
                  BackgroundColor="#F5F9FC"
                  ZIndex="1100"
                  InputTransparent="False">
                <Border BackgroundColor="White"
                        WidthRequest="100"
                        HeightRequest="100"
                        StrokeThickness="0"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.15" Radius="15" Offset="0,8"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                        <ActivityIndicator IsRunning="True"
                                           Color="{StaticResource Primary}"
                                           WidthRequest="40"
                                           HeightRequest="40" />
                        <Label Text="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[OffersLoading]}"
                               TextColor="{StaticResource Primary}"
                               FontSize="13" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
