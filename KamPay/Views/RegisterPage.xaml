<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KamPay.ViewModels"
             xmlns:services="clr-namespace:KamPay.Services"
             xmlns:converters="clr-namespace:KamPay.Converters"
             x:DataType="vm:RegisterViewModel"
             x:Class="KamPay.Views.RegisterPage"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:IsNotNullOrEmptyConverter x:Key="IsNotNullOrEmptyConverter" />
            <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
            <converters:BoolToMultiColorConverter x:Key="BoolToMultiColorConverter" />
            <converters:BoolToTextConverter x:Key="BoolToTextConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1E88E5" Offset="0.0" />
                    <GradientStop Color="#1565C0" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <Grid Opacity="0.1">
            <Ellipse x:Name="Circle1" 
                     WidthRequest="250" 
                     HeightRequest="250"
                     Fill="White"
                     HorizontalOptions="End"
                     VerticalOptions="Start"
                     Margin="0,-100,-100,0"/>

            <Ellipse x:Name="Circle2" 
                     WidthRequest="180" 
                     HeightRequest="180"
                     Fill="White"
                     HorizontalOptions="Start"
                     VerticalOptions="End"
                     Margin="-80,0,0,-80"/>
        </Grid>

        <ScrollView>
            <VerticalStackLayout Spacing="0" Padding="30,50,30,30">

                <VerticalStackLayout x:Name="HeaderSection" Spacing="8" Margin="0,0,0,30">
                    <Label Text="✨" 
                           FontSize="40"
                           HorizontalOptions="Center"/>

                    <Label Text="{Binding Source={x:Static services:LocalizationResourceManager.Instance}, Path=[Register]}" 
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"/>

                    <Label Text="Hemen başla ve topluluğa katıl!" 
                           FontSize="14"
                           TextColor="White"
                           Opacity="0.9"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- ✅ Kayıt formu - Artık her zaman görünür -->
                <Border x:Name="RegisterFormCard" 
                        BackgroundColor="White" 
                        StrokeThickness="0"
                        Padding="24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" 
                                Opacity="0.15" 
                                Radius="20" 
                                Offset="0,8"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="14">

                        <Border BackgroundColor="#F5F9FC" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Grid Padding="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Label Text="👤" FontSize="18" VerticalOptions="Center" Margin="0,0,12,0"/>

                                <Entry Grid.Column="1"
                                       Placeholder="{Binding Source={x:Static services:LocalizationResourceManager.Instance}, Path=[FirstName]}"
                                       Text="{Binding FirstName}"
                                       TextColor="#212121"
                                       PlaceholderColor="#9E9E9E"
                                       BackgroundColor="Transparent"
                                       FontSize="15"
                                       HeightRequest="48"/>
                            </Grid>
                        </Border>

                        <Border BackgroundColor="#F5F9FC" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Grid Padding="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Label Text="👥" FontSize="18" VerticalOptions="Center" Margin="0,0,12,0"/>

                                <Entry Grid.Column="1"
                                       Placeholder="{Binding Source={x:Static services:LocalizationResourceManager.Instance}, Path=[LastName]}"
                                       Text="{Binding LastName}"
                                       TextColor="#212121"
                                       PlaceholderColor="#9E9E9E"
                                       BackgroundColor="Transparent"
                                       FontSize="15"
                                       HeightRequest="48"/>
                            </Grid>
                        </Border>

                        <Border BackgroundColor="#F5F9FC" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Grid Padding="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Label Text="📧" FontSize="18" VerticalOptions="Center" Margin="0,0,12,0"/>

                                <Entry Grid.Column="1"
                                       Placeholder="{Binding Source={x:Static services:LocalizationResourceManager.Instance}, Path=[Email]}"
                                       Text="{Binding Email}"
                                       Keyboard="Email"
                                       TextColor="#212121"
                                       PlaceholderColor="#9E9E9E"
                                       BackgroundColor="Transparent"
                                       FontSize="15"
                                       HeightRequest="48"/>
                            </Grid>
                        </Border>

                        <Border BackgroundColor="#F5F9FC" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Grid Padding="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Label Text="🔒" FontSize="18" VerticalOptions="Center" Margin="0,0,12,0"/>

                                <Entry Grid.Column="1"
                                       Placeholder="{Binding Source={x:Static services:LocalizationResourceManager.Instance}, Path=[Password]}"
                                       Text="{Binding Password}"
                                       IsPassword="True"
                                       TextColor="#212121"
                                       PlaceholderColor="#9E9E9E"
                                       BackgroundColor="Transparent"
                                       FontSize="15"
                                       HeightRequest="48"/>
                            </Grid>
                        </Border>

                        <Border BackgroundColor="#F5F9FC" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Grid Padding="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Label Text="🔐" FontSize="18" VerticalOptions="Center" Margin="0,0,12,0"/>

                                <Entry Grid.Column="1"
                                       Placeholder="{Binding Source={x:Static services:LocalizationResourceManager.Instance}, Path=[ConfirmPassword]}"
                                       Text="{Binding PasswordConfirm}"
                                       IsPassword="True"
                                       TextColor="#212121"
                                       PlaceholderColor="#9E9E9E"
                                       BackgroundColor="Transparent"
                                       FontSize="15"
                                       HeightRequest="48"/>
                            </Grid>
                        </Border>

                        <Border IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                                BackgroundColor="#FFEBEE"
                                StrokeThickness="0"
                                Padding="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Label Text="{Binding ErrorMessage}"
                                   TextColor="#EF5350"
                                   FontSize="12"
                                   FontAttributes="Bold"/>
                        </Border>

                        <Button Text="{Binding Source={x:Static services:LocalizationResourceManager.Instance}, Path=[Register]}"
                                Command="{Binding RegisterCommand}"
                                BackgroundColor="#1E88E5"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="16"
                                CornerRadius="28"
                                HeightRequest="54"
                                Margin="0,6,0,0"
                                IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
                            <Button.Shadow>
                                <Shadow Brush="#1E88E5" Opacity="0.3" Radius="10" Offset="0,4"/>
                            </Button.Shadow>
                        </Button>

                        <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,12"/>

                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label Text="{Binding Source={x:Static services:LocalizationResourceManager.Instance}, Path=[AlreadyHaveAccount]}"
                                   TextColor="#757575"
                                   FontSize="14"/>
                            <Label Text="{Binding Source={x:Static services:LocalizationResourceManager.Instance}, Path=[Login]}"
                                   TextColor="#1E88E5"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextDecorations="Underline">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoToLoginCommand}"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <Label Text="KamPay © 2025" 
                       TextColor="White"
                       FontSize="12"
                       Opacity="0.7"
                       HorizontalOptions="Center"
                       Margin="0,20,0,0"/>

            </VerticalStackLayout>
        </ScrollView>

        <Grid IsVisible="{Binding IsLoading}" 
              BackgroundColor="#80000000"
              ZIndex="999">
            <Border BackgroundColor="White"
                    WidthRequest="120"
                    HeightRequest="120"
                    StrokeThickness="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.2" Radius="20" Offset="0,10"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="12" 
                                     HorizontalOptions="Center" 
                                     VerticalOptions="Center">
                    <ActivityIndicator IsRunning="True" 
                                       Color="#1E88E5"
                                       WidthRequest="40"
                                       HeightRequest="40"/>
                    <Label Text="Yükleniyor..." 
                           TextColor="#1E88E5"
                           FontSize="12"
                           FontAttributes="Bold"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>