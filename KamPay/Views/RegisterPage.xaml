<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KamPay.ViewModels"
             xmlns:services="clr-namespace:KamPay.Services"
             x:DataType="vm:RegisterViewModel"
             x:Class="KamPay.Views.RegisterPage"
             BackgroundColor="#6200EA"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center">
            
            <!-- Logo veya Başlık -->
            <Label Text="{Binding Source={x:Static services:LocalizationResourceManager.Instance}, Path=[Register]}" 
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"/>

            <!-- Kayıt Formu -->
            <Frame BackgroundColor="White" CornerRadius="20" Padding="20" HasShadow="True"
                   IsVisible="{Binding ShowVerificationSection, Converter={StaticResource InvertedBoolConverter}}">
                <VerticalStackLayout Spacing="15">
                    
                    <!-- İsim -->
                    <Entry Placeholder="{Binding Source={x:Static services:LocalizationResourceManager.Instance}, Path=[FirstName]}"
                           Text="{Binding FirstName}"
                           TextColor="#212121"
                           PlaceholderColor="#757575"/>

                    <!-- Soyisim -->
                    <Entry Placeholder="{Binding Source={x:Static services:LocalizationResourceManager.Instance}, Path=[LastName]}"
                           Text="{Binding LastName}"
                           TextColor="#212121"
                           PlaceholderColor="#757575"/>

                    <!-- Email -->
                    <Entry Placeholder="{Binding Source={x:Static services:LocalizationResourceManager.Instance}, Path=[Email]}"
                           Text="{Binding Email}"
                           Keyboard="Email"
                           TextColor="#212121"
                           PlaceholderColor="#757575"/>

                    <!-- Şifre -->
                    <Entry Placeholder="{Binding Source={x:Static services:LocalizationResourceManager.Instance}, Path=[Password]}"
                           Text="{Binding Password}"
                           IsPassword="True"
                           TextColor="#212121"
                           PlaceholderColor="#757575"/>

                    <!-- Şifre Tekrar -->
                    <Entry Placeholder="{Binding Source={x:Static services:LocalizationResourceManager.Instance}, Path=[ConfirmPassword]}"
                           Text="{Binding PasswordConfirm}"
                           IsPassword="True"
                           TextColor="#212121"
                           PlaceholderColor="#757575"/>

                    <!-- Hata Mesajı -->
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="Red"
                           FontSize="12"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}"/>

                    <!-- Kayıt Ol Butonu -->
                    <Button Text="{Binding Source={x:Static services:LocalizationResourceManager.Instance}, Path=[Register]}"
                            Command="{Binding RegisterCommand}"
                            BackgroundColor="#6200EA"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="50"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"/>

                    <!-- Giriş Yap Linki -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                        <Label Text="{Binding Source={x:Static services:LocalizationResourceManager.Instance}, Path=[AlreadyHaveAccount]}"
                               TextColor="#757575"
                               FontSize="14"/>
                        <Label Text="{Binding Source={x:Static services:LocalizationResourceManager.Instance}, Path=[Login]}"
                               TextColor="#6200EA"
                               FontSize="14"
                               FontAttributes="Bold">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToLoginCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Doğrulama Kodu Bölümü -->
            <Frame BackgroundColor="White" CornerRadius="20" Padding="20" HasShadow="True"
                   IsVisible="{Binding ShowVerificationSection}">
                <VerticalStackLayout Spacing="15">
                    
                    <!-- Bilgilendirme -->
                    <Label Text="{Binding Source={x:Static services:LocalizationResourceManager.Instance}, Path=[EnterVerificationCode]}"
                           FontSize="16"
                           TextColor="#212121"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"/>

                    <!-- Doğrulama Kodu Entry -->
                    <Entry Placeholder="{Binding Source={x:Static services:LocalizationResourceManager.Instance}, Path=[VerificationCode]}"
                           Text="{Binding VerificationCode}"
                           Keyboard="Numeric"
                           MaxLength="6"
                           TextColor="#212121"
                           PlaceholderColor="#757575"
                           HorizontalTextAlignment="Center"
                           FontSize="20"
                           FontAttributes="Bold"/>

                    <!-- Hata Mesajı -->
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="Red"
                           FontSize="12"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}"/>

                    <!-- Doğrula Butonu -->
                    <Button Text="{Binding Source={x:Static services:LocalizationResourceManager.Instance}, Path=[Verify]}"
                            Command="{Binding VerifyEmailCommand}"
                            BackgroundColor="#6200EA"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            HeightRequest="50"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"/>

                    <!-- Kodu Yeniden Gönder -->
                    <Button Text="{Binding Source={x:Static services:LocalizationResourceManager.Instance}, Path=[ResendCode]}"
                            Command="{Binding ResendVerificationCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#6200EA"
                            FontAttributes="Bold"
                            BorderColor="#6200EA"
                            BorderWidth="2"
                            CornerRadius="10"
                            HeightRequest="50"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}"/>

                    <!-- İptal -->
                    <Button Text="{Binding Source={x:Static services:LocalizationResourceManager.Instance}, Path=[Cancel]}"
                            Command="{Binding CancelVerificationCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#757575"
                            CornerRadius="10"
                            HeightRequest="40"/>

                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
