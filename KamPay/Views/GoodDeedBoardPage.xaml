<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KamPay.ViewModels"
             xmlns:models="clr-namespace:KamPay.Models"
             xmlns:converters="clr-namespace:KamPay.Converters"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
             xmlns:extensions="clr-namespace:KamPay.Extensions"
             x:Class="KamPay.Views.GoodDeedBoardPage"
             x:DataType="vm:GoodDeedBoardViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F5F9FC">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#1E88E5</Color>
            <Color x:Key="PrimaryDark">#1565C0</Color>
            <Color x:Key="Surface">#FFFFFF</Color>
            <Color x:Key="Background">#F5F9FC</Color>
            <Color x:Key="TextPrimary">#212121</Color>
            <Color x:Key="TextSecondary">#757575</Color>
            <Color x:Key="BorderColor">#E0E0E0</Color>
            <Color x:Key="LikeColor">#F44336</Color>

            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:IsNotNullOrEmptyConverter x:Key="IsNotNullConverter" />
            <converters:BoolToColorConverter x:Key="LikeColorConverter"
                                             TrueColor="#F44336"
                                             FalseColor="#757575"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ✨ HEADER WITH GRADIENT BACKGROUND -->
        <Grid Grid.Row="0" RowDefinitions="Auto">
            <!-- Gradient Background -->
            <BoxView>
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1E88E5" Offset="0.0" />
                        <GradientStop Color="#1565C0" Offset="1.0" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

            <!-- Animated Background Circle -->
            <Ellipse x:Name="Circle1" 
                     WidthRequest="200" 
                     HeightRequest="200"
                     Fill="White"
                     Opacity="0.05"
                     HorizontalOptions="End"
                     VerticalOptions="Start"
                     Margin="0,-80,-80,0"/>

            <!-- Title -->
            <Grid Padding="20,50,20,20">
                <VerticalStackLayout VerticalOptions="Center" x:Name="HeaderSection">
                    <Label Text="💚 İyilik Panosu" 
                           FontSize="28" 
                           FontAttributes="Bold" 
                           TextColor="White" />
                    <Label Text="Kampüste iyilik yap, fark yarat" 
                           FontSize="13" 
                           TextColor="White" 
                           Opacity="0.9"/>
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <!-- : SEARCH AND FILTER SECTION -->
        <Grid Grid.Row="1" Padding="15,15,15,10" RowDefinitions="Auto,Auto" RowSpacing="10">
            <!-- Search Bar -->
            <Border Grid.Row="0"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="15,0"
                    HeightRequest="50">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.08"/>
                </Border.Shadow>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Image Grid.Column="0" 
                           Source="search_icon.svg" 
                           HeightRequest="20" 
                           WidthRequest="20"
                           VerticalOptions="Center"
                           Margin="0,0,10,0">
                        <Image.Behaviors>
                            <toolkit:IconTintColorBehavior TintColor="{StaticResource TextSecondary}"/>
                        </Image.Behaviors>
                    </Image>
                    <Entry Grid.Column="1"
                           Placeholder="İyilik ara..."
                           Text="{Binding SearchText}"
                           FontSize="15"
                           VerticalOptions="Center"
                           BackgroundColor="Transparent"
                           TextColor="{StaticResource TextPrimary}"
                           PlaceholderColor="{StaticResource TextSecondary}"/>
                </Grid>
            </Border>

            <!-- Category Filter -->
            <Border Grid.Row="1"
                    StrokeShape="RoundRectangle 20"
                    BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="15,0"
                    HeightRequest="50">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.08"/>
                </Border.Shadow>
                <Grid ColumnDefinitions="*,Auto">
                    <Picker Grid.Column="0"
                            Title="Kategori Seçiniz"
                            ItemsSource="{Binding FilterPostTypes}"
                            SelectedItem="{Binding FilterPostType}"
                            FontSize="15"
                            TextColor="{StaticResource TextPrimary}">
                        <Picker.ItemDisplayBinding>
                            <Binding Converter="{StaticResource PostTypeToTextConverter}" />
                        </Picker.ItemDisplayBinding>
                    </Picker>
                    
                    <!-- Clear Filter Button -->
                    <Border Grid.Column="1"
                            IsVisible="{Binding FilterPostType, Converter={StaticResource IsNotNullConverter}}"
                            StrokeShape="RoundRectangle 15"
                            BackgroundColor="#FFE5E5"
                            WidthRequest="30"
                            HeightRequest="30"
                            StrokeThickness="0"
                            VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ClearCategoryFilterCommand}"/>
                        </Border.GestureRecognizers>
                        <Label Text="✕" 
                               TextColor="#F44336"
                               FontSize="14"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               FontAttributes="Bold"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ✨ MAIN CONTENT -->
        <RefreshView Grid.Row="2"
                     Command="{Binding RefreshPostsCommand}"
                     IsRefreshing="{Binding IsRefreshing}"
                     RefreshColor="{StaticResource Primary}">

            <CollectionView ItemsSource="{Binding FilteredPosts}" 
                            SelectionMode="None"
                            Margin="15,5,15,15">

                <CollectionView.EmptyView>
                    <Grid VerticalOptions="Center" 
                          HorizontalOptions="Center" 
                          Padding="20"
                          IsVisible="{Binding IsSkeletonVisible, Converter={StaticResource InvertedBoolConverter}}">
                        <Border BackgroundColor="White"
                                StrokeThickness="0"
                                Padding="30"
                                WidthRequest="280"
                                HeightRequest="240">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20"/>
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="Black" Opacity="0.08" Radius="15" Offset="0,4"/>
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="15" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Text="💬" FontSize="70" HorizontalTextAlignment="Center"/>
                                <Label Text="{extensions:Translate NoPostsYet}" 
                                       FontSize="16" 
                                       TextColor="{StaticResource TextSecondary}" 
                                       HorizontalTextAlignment="Center"
                                       FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:GoodDeedPost">
                        <Border StrokeShape="RoundRectangle 16"
                                StrokeThickness="0"
                                BackgroundColor="White"
                                Margin="0,0,0,12"
                                Padding="16">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="10" Opacity="0.1"/>
                            </Border.Shadow>

                            <VerticalStackLayout Spacing="12">
                                <!-- Header: Title & Type Badge -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <Label Grid.Column="0" 
                                           Text="{Binding Title}" 
                                           FontAttributes="Bold" 
                                           FontSize="17" 
                                           TextColor="{StaticResource TextPrimary}"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2"/>
                                    <Border Grid.Column="1" 
                                            BackgroundColor="#E3F2FD" 
                                            Padding="10,5" 
                                            StrokeThickness="0"
                                            VerticalOptions="Start">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10"/>
                                        </Border.StrokeShape>
                                        <Label Text="{Binding Type, Converter={StaticResource PostTypeToTextConverter}}" 
                                               FontSize="11" 
                                               TextColor="{StaticResource Primary}" 
                                               FontAttributes="Bold"/>
                                    </Border>
                                </Grid>

                                <!-- Description -->
                                <Label Text="{Binding Description}" 
                                       LineBreakMode="WordWrap" 
                                       TextColor="{StaticResource TextSecondary}"
                                       FontSize="14"/>

                                <!-- User Info -->
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <ffimageloading:CachedImage Grid.Column="0"
                                                                Source="{Binding UserProfileImageUrl}" 
                                                                Aspect="AspectFill" 
                                                                HeightRequest="40" 
                                                                WidthRequest="40" 
                                                                LoadingPlaceholder="person_icon.svg" 
                                                                ErrorPlaceholder="person_icon.svg"
                                                                VerticalOptions="Center">
                                        <ffimageloading:CachedImage.Clip>
                                            <EllipseGeometry Center="20,20" RadiusX="20" RadiusY="20" />
                                        </ffimageloading:CachedImage.Clip>
                                    </ffimageloading:CachedImage>

                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding UserName}" 
                                               FontSize="13" 
                                               FontAttributes="Bold" 
                                               TextColor="{StaticResource TextPrimary}"/>
                                        <Label Text="{Binding CreatedAt, Converter={StaticResource DateTimeToTimeAgoConverter}}" 
                                               FontSize="11" 
                                               TextColor="{StaticResource TextSecondary}"/>
                                    </VerticalStackLayout>

                                    <HorizontalStackLayout Grid.Column="2" Spacing="12" VerticalOptions="Center">
                                        <!-- Like Button -->
                                        <HorizontalStackLayout Spacing="4">
                                            <ImageButton Source="heart_icon.svg" 
                                                         Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GoodDeedBoardViewModel}}, Path=LikePostCommand}" 
                                                         CommandParameter="{Binding .}" 
                                                         HeightRequest="22" 
                                                         WidthRequest="22">
                                                <ImageButton.Behaviors>
                                                    <toolkit:IconTintColorBehavior TintColor="{Binding IsLiked, Converter={StaticResource LikeColorConverter}}"/>
                                                </ImageButton.Behaviors>
                                            </ImageButton>
                                            <Label Text="{Binding LikeCount}" 
                                                   FontSize="12" 
                                                   VerticalOptions="Center" 
                                                   TextColor="{StaticResource TextSecondary}"
                                                   FontAttributes="Bold"/>
                                        </HorizontalStackLayout>

                                        <!-- Comment Button -->
                                        <HorizontalStackLayout Spacing="4">
                                            <ImageButton Source="message_icon.svg" 
                                                         Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GoodDeedBoardViewModel}}, Path=ToggleCommentBoxCommand}" 
                                                         CommandParameter="{Binding .}" 
                                                         HeightRequest="20" 
                                                         WidthRequest="20">
                                                <ImageButton.Behaviors>
                                                    <toolkit:IconTintColorBehavior TintColor="{StaticResource TextSecondary}"/>
                                                </ImageButton.Behaviors>
                                            </ImageButton>
                                            <Label Text="{Binding CommentCount}" 
                                                   FontSize="12" 
                                                   VerticalOptions="Center" 
                                                   TextColor="{StaticResource TextSecondary}"
                                                   FontAttributes="Bold"/>
                                        </HorizontalStackLayout>

                                        <!-- Delete Button (Owner Only) -->
                                        <ImageButton Source="bin_icon.png" 
                                                     IsVisible="{Binding IsOwner}" 
                                                     Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GoodDeedBoardViewModel}}, Path=DeletePostCommand}" 
                                                     CommandParameter="{Binding .}" 
                                                     HeightRequest="18" 
                                                     WidthRequest="18" 
                                                     Aspect="AspectFit"/>
                                    </HorizontalStackLayout>
                                </Grid>

                                <BoxView HeightRequest="1" Color="{StaticResource BorderColor}"/>

                                <!-- Comments Section -->
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding VisibleComments}" Spacing="10">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:Comment">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                <ffimageloading:CachedImage Grid.Column="0"
                                                                            Source="{Binding UserProfileImageUrl}" 
                                                                            Aspect="AspectFill" 
                                                                            HeightRequest="32" 
                                                                            WidthRequest="32" 
                                                                            LoadingPlaceholder="person_icon.svg" 
                                                                            ErrorPlaceholder="person_icon.svg">
                                                    <ffimageloading:CachedImage.Clip>
                                                        <EllipseGeometry Center="16,16" RadiusX="16" RadiusY="16" />
                                                    </ffimageloading:CachedImage.Clip>
                                                </ffimageloading:CachedImage>

                                                <Border Grid.Column="1" 
                                                        StrokeShape="RoundRectangle 12" 
                                                        StrokeThickness="0" 
                                                        BackgroundColor="#F5F9FC" 
                                                        Padding="12">
                                                    <VerticalStackLayout Spacing="4">
                                                        <HorizontalStackLayout Spacing="6">
                                                            <Label Text="{Binding UserName}" 
                                                                   FontAttributes="Bold" 
                                                                   FontSize="12" 
                                                                   TextColor="{StaticResource TextPrimary}"/>
                                                            <Label Text="•" 
                                                                   TextColor="{StaticResource TextSecondary}" 
                                                                   FontSize="10"/>
                                                            <Label Text="{Binding CreatedAt, Converter={StaticResource DateTimeToTimeAgoConverter}}" 
                                                                   TextColor="{StaticResource TextSecondary}" 
                                                                   FontSize="10"/>
                                                        </HorizontalStackLayout>
                                                        <Label Text="{Binding Text}" 
                                                               FontSize="13" 
                                                               TextColor="{StaticResource TextPrimary}"/>
                                                    </VerticalStackLayout>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <!-- Show More/Less Button -->
                                <Button Text="{Binding ShowMoreButtonText}" 
                                        IsVisible="{Binding ShowExpandButton}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GoodDeedBoardViewModel}}, Path=ToggleCommentsCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="Transparent" 
                                        TextColor="{StaticResource Primary}" 
                                        FontSize="12" 
                                        HeightRequest="30" 
                                        Padding="0"/>

                                <!-- Comment Input Box -->
                                <Border IsVisible="{Binding IsCommentBoxVisible}" 
                                        StrokeShape="RoundRectangle 20" 
                                        Stroke="{StaticResource BorderColor}" 
                                        StrokeThickness="1"
                                        Padding="12,0" 
                                        HeightRequest="45"
                                        BackgroundColor="White">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Entry Grid.Column="0" 
                                               Placeholder="{extensions:Translate WriteComment}" 
                                               FontSize="13" 
                                               Text="{Binding DraftComment}" 
                                               ReturnCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:GoodDeedBoardViewModel}}, Path=AddCommentCommand}" 
                                               ReturnCommandParameter="{Binding .}" 
                                               BackgroundColor="Transparent"
                                               TextColor="{StaticResource TextPrimary}"
                                               PlaceholderColor="{StaticResource TextSecondary}"/>

                                        <Border Grid.Column="1"
                                                StrokeShape="RoundRectangle 18"
                                                BackgroundColor="{StaticResource Primary}"
                                                WidthRequest="36"
                                                HeightRequest="36"
                                                StrokeThickness="0">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:GoodDeedBoardViewModel}}, Path=AddCommentCommand}" CommandParameter="{Binding .}"/>
                                            </Border.GestureRecognizers>
                                            <Label Text="✈️" 
                                                   FontSize="16"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- ✨ ADD POST FORM OVERLAY -->
        <Grid Grid.RowSpan="3"
              IsVisible="{Binding IsPostFormVisible}" 
              BackgroundColor="#80000000" 
              ZIndex="999"
              InputTransparent="False">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ClosePostFormCommand}" />
            </Grid.GestureRecognizers>

            <Border BackgroundColor="White" 
                    VerticalOptions="End" 
                    StrokeShape="RoundRectangle 24,24,0,0" 
                    MaximumHeightRequest="550"
                    ZIndex="1000"
                    InputTransparent="False">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,-4" Radius="20" Opacity="0.2"/>
                </Border.Shadow>

                <ScrollView>
                    <VerticalStackLayout Spacing="20" Padding="24,30,24,20" x:Name="FormCard">
                        <!-- Header -->
                        <Grid>
                            <Label Text="{extensions:Translate ShareNewGoodDeed}" 
                                   FontSize="20" 
                                   FontAttributes="Bold" 
                                   HorizontalOptions="Center"
                                   TextColor="{StaticResource TextPrimary}"/>
                            <Border StrokeShape="RoundRectangle 20"
                                    BackgroundColor="#F5F9FC"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    HorizontalOptions="End"
                                    StrokeThickness="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ClosePostFormCommand}"/>
                                </Border.GestureRecognizers>
                                <Label Text="✕" 
                                       TextColor="{StaticResource TextSecondary}"
                                       FontSize="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource BorderColor}"/>

                        <!-- Title -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{extensions:Translate TopicTitle}" 
                                   FontSize="14" 
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"/>
                            <Border StrokeShape="RoundRectangle 12" 
                                    StrokeThickness="1" 
                                    Stroke="{StaticResource BorderColor}" 
                                    Padding="12,8">
                                <Entry Placeholder="{extensions:Translate TopicTitle}" 
                                       Text="{Binding Title}" 
                                       FontSize="15"
                                       TextColor="{StaticResource TextPrimary}"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Description -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{extensions:Translate ShareYourThoughts}" 
                                   FontSize="14" 
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"/>
                            <Border StrokeShape="RoundRectangle 12" 
                                    StrokeThickness="1" 
                                    Stroke="{StaticResource BorderColor}" 
                                    Padding="12">
                                <Editor Placeholder="{extensions:Translate ShareYourThoughts}" 
                                        Text="{Binding Description}" 
                                        HeightRequest="100" 
                                        AutoSize="TextChanges" 
                                        BackgroundColor="Transparent"
                                        FontSize="15"
                                        TextColor="{StaticResource TextPrimary}"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Post Type -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{extensions:Translate SelectCategoryPost}" 
                                   FontSize="14" 
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"/>
                            <Border StrokeShape="RoundRectangle 12" 
                                    StrokeThickness="1" 
                                    Stroke="{StaticResource BorderColor}" 
                                    Padding="12,0">
                                <Picker Title="{extensions:Translate PostType}" 
                                        ItemsSource="{Binding PostTypes}" 
                                        SelectedItem="{Binding SelectedType}" 
                                        VerticalOptions="Center"
                                        FontSize="15"
                                        TextColor="{StaticResource TextPrimary}">
                                    <Picker.ItemDisplayBinding>
                                        <Binding Converter="{StaticResource PostTypeToTextConverter}" />
                                    </Picker.ItemDisplayBinding>
                                </Picker>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Submit Button -->
                        <Button Text="{extensions:Translate SharePost}" 
                                Command="{Binding CreatePostCommand}" 
                                BackgroundColor="{StaticResource Primary}" 
                                TextColor="White" 
                                CornerRadius="12" 
                                HeightRequest="50" 
                                FontAttributes="Bold"
                                FontSize="16"
                                IsEnabled="{Binding IsPosting, Converter={StaticResource InvertedBoolConverter}}" 
                                Margin="0,10,0,10">
                            <Button.Shadow>
                                <Shadow Brush="{StaticResource Primary}" Offset="0,4" Radius="8" Opacity="0.3"/>
                            </Button.Shadow>
                        </Button>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

        <!-- Floating Action Button -->
        <Border Grid.Row="2"
                StrokeShape="RoundRectangle 32"
                BackgroundColor="{StaticResource Primary}"
                WidthRequest="64"
                HeightRequest="64"
                StrokeThickness="0"
                VerticalOptions="End"
                HorizontalOptions="End"
                Margin="20"
                IsVisible="{Binding IsPostFormVisible, Converter={StaticResource InvertedBoolConverter}}">
            <Border.Shadow>
                <Shadow Brush="{StaticResource Primary}" Offset="0,8" Opacity="0.4" Radius="15"/>
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenPostFormCommand}"/>
            </Border.GestureRecognizers>
            <Label Text="+" 
                   FontSize="36" 
                   TextColor="White" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   VerticalOptions="Center" 
                   Margin="0,0,0,2"/>
        </Border>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="3"
              IsVisible="{Binding IsSkeletonVisible}"
              BackgroundColor="#F5F9FC"
              ZIndex="1100"
              InputTransparent="False">
            <Border BackgroundColor="White"
                    WidthRequest="100"
                    HeightRequest="100"
                    StrokeThickness="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.15" Radius="15" Offset="0,8"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                    <ActivityIndicator IsRunning="True" 
                                       Color="{StaticResource Primary}" 
                                       WidthRequest="40" 
                                       HeightRequest="40"/>
                    <Label Text="Yükleniyor..." 
                           TextColor="{StaticResource Primary}" 
                           FontSize="13"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>