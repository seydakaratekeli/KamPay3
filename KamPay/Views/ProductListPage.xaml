<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KamPay.ViewModels"
             xmlns:models="clr-namespace:KamPay.Models"
             xmlns:converters="clr-namespace:KamPay.Converters"
             xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
             xmlns:extensions="clr-namespace:KamPay.Extensions"
             x:DataType="vm:ProductListViewModel"
             x:Class="KamPay.Views.ProductListPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F5F9FC">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#1E88E5</Color>
            <Color x:Key="PrimaryDark">#1565C0</Color>
            <Color x:Key="Surface">#FFFFFF</Color>
            <Color x:Key="Background">#F5F9FC</Color>
            <Color x:Key="TextPrimary">#212121</Color>
            <Color x:Key="TextSecondary">#757575</Color>
            <Color x:Key="BorderColor">#E0E0E0</Color>
            <Color x:Key="SurpriseBox">lightblue</Color>

            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:EqualityToBackgroundConverter x:Key="EqualityToBackgroundConverter" />
            <converters:EqualityToBorderColorConverter x:Key="EqualityToBorderColorConverter" />
            <converters:EqualityToTextColorConverter x:Key="EqualityToTextColorConverter" />
            <converters:IsNotNullOrEmptyConverter x:Key="IsNotNullOrEmptyConverter"/>
            <converters:ProductTypeToBadgeTextConverter x:Key="ProductTypeToBadgeTextConverter"/>
            <converters:ProductTypeToBadgeColorConverter x:Key="ProductTypeToBadgeColorConverter"/>
            <converters:ProductCategoryToTextConverter x:Key="ProductCategoryToTextConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *">

        <!-- ✨ HEADER WITH GRADIENT BACKGROUND -->
        <Grid Grid.Row="0" RowDefinitions="Auto, Auto">
            <!-- Gradient Background -->
            <BoxView Grid.RowSpan="2">
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1E88E5" Offset="0.0" />
                        <GradientStop Color="#1565C0" Offset="1.0" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

            <!-- Animated Background Circle -->
            <Ellipse x:Name="Circle1" 
                     Grid.RowSpan="2"
                     WidthRequest="200" 
                     HeightRequest="200"
                     Fill="White"
                     Opacity="0.05"
                     HorizontalOptions="End"
                     VerticalOptions="Start"
                     Margin="0,-80,-80,0"/>

            <!-- Title & Notification -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Padding="20,50,20,15">
                <VerticalStackLayout VerticalOptions="Center">
                    <Label Text="KamPay" 
                           FontSize="28" 
                           FontAttributes="Bold" 
                           TextColor="White" />
                    <Label Text="Kampüste Paylaşım Platformu" 
                           FontSize="13" 
                           TextColor="White" 
                           Opacity="0.9"/>
                </VerticalStackLayout>

                <Border Grid.Column="1" 
                        VerticalOptions="Center"
                        BackgroundColor="White"
                        StrokeThickness="0"
                        WidthRequest="44"
                        HeightRequest="44"
                        Opacity="0.95">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22"/>
                    </Border.StrokeShape>
                    <Grid>
                        <Button Text="🔔" 
                                FontSize="20" 
                                BackgroundColor="Transparent" 
                                BorderColor="Transparent" 
                                TextColor="{StaticResource Primary}" 
                                Command="{Binding GoToNotificationsCommand}"
                                Padding="0"/>

                        <Border StrokeThickness="0" 
                                BackgroundColor="#EF5350" 
                                HeightRequest="12" 
                                WidthRequest="12" 
                                HorizontalOptions="End" 
                                VerticalOptions="Start" 
                                Margin="0,4,4,0" 
                                IsVisible="{Binding HasUnreadNotifications}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="6" />
                            </Border.StrokeShape>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Search & Filter -->
            <Grid Grid.Row="1" ColumnDefinitions="*, Auto" ColumnSpacing="12" Padding="20,0,20,20">
                <Border Grid.Column="0"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        BackgroundColor="White"
                        HeightRequest="50"
                        Padding="15,0">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.1"/>
                    </Border.Shadow>

                    <Grid ColumnDefinitions="Auto,*">
                        <Label Text="🔍" VerticalOptions="Center" Opacity="0.6" FontSize="18"/>
                        <Entry Grid.Column="1"
                               Text="{Binding SearchText}"
                               Placeholder="{extensions:Translate SearchProduct}"
                               FontSize="15"
                               TextColor="{StaticResource TextPrimary}"
                               PlaceholderColor="{StaticResource TextSecondary}"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center"
                               Margin="10,0,0,0"/>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        BackgroundColor="White"
                        WidthRequest="50"
                        HeightRequest="50"
                        Padding="0">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.1"/>
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleFilterPanelCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="⚙️"
                           FontSize="22"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TextColor="{StaticResource Primary}"/>
                </Border>
            </Grid>
        </Grid>

        <!-- ✨ MAIN CONTENT -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            
            <!-- Category Chips -->
            <CollectionView Grid.Row="0"
                            ItemsSource="{Binding Categories}"
                            SelectionMode="None"
                            Margin="15,15,15,10"
                            HeightRequest="40">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/>
                </CollectionView.ItemsLayout>

                <!-- "Tümü" Button as Header -->
                <CollectionView.Header>
                    <Border StrokeShape="RoundRectangle 20"
                            StrokeThickness="2"
                            Padding="16,10"
                            Margin="0,0,8,0"
                            BackgroundColor="{Binding SelectedCategory, Converter={StaticResource EqualityToBackgroundConverter}, ConverterParameter={x:Null}}"
                            Stroke="{Binding SelectedCategory, Converter={StaticResource EqualityToBorderColorConverter}, ConverterParameter={x:Null}}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CategoryTappedCommand}" CommandParameter="{x:Null}"/>
                        </Border.GestureRecognizers>
                        <Label Text="{extensions:Translate All}" 
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{Binding SelectedCategory, Converter={StaticResource EqualityToTextColorConverter}, ConverterParameter={x:Null}}"/>
                    </Border>
                </CollectionView.Header>

                <!-- Category Items -->
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Category">
                        <Border StrokeShape="RoundRectangle 20"
                                StrokeThickness="2"
                                Padding="16,10"
                                BackgroundColor="{Binding Source={RelativeSource AncestorType={x:Type vm:ProductListViewModel}}, Path=SelectedCategory.CategoryId, Converter={StaticResource EqualityToBackgroundConverter}, ConverterParameter={Binding CategoryId}}"
                                Stroke="{Binding Source={RelativeSource AncestorType={x:Type vm:ProductListViewModel}}, Path=SelectedCategory.CategoryId, Converter={StaticResource EqualityToBorderColorConverter}, ConverterParameter={Binding CategoryId}}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProductListViewModel}}, Path=CategoryTappedCommand}" CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                            <Label Text="{Binding Name, Converter={StaticResource ProductCategoryToTextConverter}}" 
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   TextColor="{Binding Source={RelativeSource AncestorType={x:Type vm:ProductListViewModel}}, Path=SelectedCategory.CategoryId, Converter={StaticResource EqualityToTextColorConverter}, ConverterParameter={Binding CategoryId}}"/>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Products Grid -->
            <RefreshView Grid.Row="1"
                         Command="{Binding RefreshProductsCommand}"
                         IsRefreshing="{Binding IsRefreshing}"
                         RefreshColor="{StaticResource Primary}">

                <CollectionView ItemsSource="{Binding Products}"
                                SelectionMode="None"
                                RemainingItemsThreshold="5"
                                RemainingItemsThresholdReachedCommand="{Binding LoadMoreProductsCommand}"
                                Margin="15,0,15,15">

                    <CollectionView.EmptyView>
                        <Grid VerticalOptions="Center" 
                              HorizontalOptions="Center" 
                              Padding="20" 
                              IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
                            <Border BackgroundColor="White"
                                    StrokeThickness="0"
                                    Padding="30"
                                    WidthRequest="280"
                                    HeightRequest="240">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20"/>
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="Black" Opacity="0.08" Radius="15" Offset="0,4"/>
                                </Border.Shadow>
                                <VerticalStackLayout Spacing="15" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label Text="📦" FontSize="70" HorizontalTextAlignment="Center"/>
                                    <Label Text="{extensions:Translate NoDataYet}" 
                                           FontSize="16" 
                                           TextColor="{StaticResource TextSecondary}" 
                                           HorizontalTextAlignment="Center"
                                           FontAttributes="Bold"/>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" 
                                         Span="2" 
                                         HorizontalItemSpacing="12" 
                                         VerticalItemSpacing="12"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Product">
                            <Border StrokeShape="RoundRectangle 16"
                                    StrokeThickness="0"
                                    BackgroundColor="White"
                                    HeightRequest="270">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0,2" Radius="10" Opacity="0.1"/>
                                </Border.Shadow>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProductListViewModel}}, Path=ProductTappedCommand}" CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>

                                <Grid RowDefinitions="155,Auto,*,Auto">

                                    <!-- Product Image -->
                                    <Grid Grid.Row="0">
                                        <ffimageloading:CachedImage Source="{Binding ThumbnailUrl}"
                                                                    Aspect="AspectFill"
                                                                    LoadingPlaceholder="loading_image.png"
                                                                    ErrorPlaceholder="error_image.png"
                                                                    DownsampleToViewSize="True"
                                                                    FadeAnimationEnabled="True"/>

                                        <!-- Gradient Overlay -->
                                        <BoxView VerticalOptions="End" HeightRequest="50">
                                            <BoxView.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="Transparent" Offset="0.0" />
                                                    <GradientStop Color="#40000000" Offset="1.0" />
                                                </LinearGradientBrush>
                                            </BoxView.Background>
                                        </BoxView>

                                        <!-- Status Badge -->
                                        <Border IsVisible="{Binding StatusText, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                                                BackgroundColor="{Binding StatusColor}"
                                                StrokeThickness="0"
                                                HorizontalOptions="Start"
                                                VerticalOptions="Start"
                                                Margin="10"
                                                Padding="8,4"
                                                StrokeShape="RoundRectangle 8">
                                            <Label Text="{Binding StatusText}" 
                                                   TextColor="White" 
                                                   FontSize="10" 
                                                   FontAttributes="Bold"/>
                                        </Border>

                                        <!-- Type Badge -->
                                        <Border BackgroundColor="White"
                                                StrokeThickness="0"
                                                HorizontalOptions="End"
                                                VerticalOptions="Start"
                                                Margin="10"
                                                Padding="10,5"
                                                StrokeShape="RoundRectangle 10"
                                                Opacity="0.95">
                                            <Label Text="{Binding Type, Converter={StaticResource ProductTypeToBadgeTextConverter}}" 
                                                   TextColor="{Binding Type, Converter={StaticResource ProductTypeToBadgeColorConverter}}" 
                                                   FontSize="11" 
                                                   FontAttributes="Bold"/>
                                        </Border>
                                    </Grid>

                                    <!-- Product Info -->
                                    <VerticalStackLayout Grid.Row="1" Padding="12,12,12,6" Spacing="5">

                                        <Label Text="{Binding Title}" 
                                               FontSize="15" 
                                               TextColor="{StaticResource TextPrimary}" 
                                               MaxLines="2" 
                                               LineBreakMode="TailTruncation"
                                               FontAttributes="Bold"/>

                                        <!-- Price Display -->
                                        <Grid>
                                            <Label Text="{Binding Price, StringFormat='₺{0:N0}'}" 
                                                   FontSize="16" 
                                                   FontAttributes="Bold" 
                                                   TextColor="DodgerBlue">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="Bagis">
                                                        <Setter Property="IsVisible" Value="False" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="Takas">
                                                        <Setter Property="IsVisible" Value="False" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>

                                            <Label Text="{extensions:Translate Donation}" 
                                                   FontSize="12" 
                                                   FontAttributes="Bold" 
                                                   TextColor="DarkRed"
                                                   IsVisible="False">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="Bagis">
                                                        <Setter Property="IsVisible" Value="True" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>

                                            <Label Text="{extensions:Translate Exchange}" 
                                                   FontSize="12" 
                                                   FontAttributes="Bold" 
                                                   TextColor="DarkGreen"
                                                   IsVisible="False">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="Takas">
                                                        <Setter Property="IsVisible" Value="True" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Grid>
                                    </VerticalStackLayout>

                                    <BoxView Grid.Row="2" Color="Transparent" />

                                    <!-- User & Stats -->
                                    <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Padding="12,8,12,12" VerticalOptions="End">
                                        <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                            <ffimageloading:CachedImage Source="{Binding UserPhotoUrl}" 
                                                                        HeightRequest="24" WidthRequest="24" 
                                                                        Aspect="AspectFill"
                                                                        LoadingPlaceholder="person_icon.svg"
                                                                        ErrorPlaceholder="person_icon.svg">
                                                <ffimageloading:CachedImage.Clip>
                                                    <EllipseGeometry Center="12,12" RadiusX="12" RadiusY="12"/>
                                                </ffimageloading:CachedImage.Clip>
                                            </ffimageloading:CachedImage>
                                            <Label Text="{Binding UserName}" 
                                                   FontSize="11" 
                                                   TextColor="{StaticResource TextSecondary}" 
                                                   VerticalOptions="Center" 
                                                   LineBreakMode="TailTruncation" 
                                                   MaximumWidthRequest="60"/>
                                        </HorizontalStackLayout>

                                        <HorizontalStackLayout Grid.Column="2" Spacing="10" VerticalOptions="Center">
                                            <HorizontalStackLayout Spacing="3">
                                                <Label Text="❤️" FontSize="11" VerticalOptions="Center"/>
                                                <Label Text="{Binding FavoriteCount}" FontSize="11" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" FontAttributes="Bold"/>
                                            </HorizontalStackLayout>
                                            <HorizontalStackLayout Spacing="3">
                                                <Label Text="👁️" FontSize="11" VerticalOptions="Center"/>
                                                <Label Text="{Binding ViewCount}" FontSize="11" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" FontAttributes="Bold"/>
                                            </HorizontalStackLayout>
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <!-- Floating Action Buttons -->
            <VerticalStackLayout Grid.RowSpan="2" 
                                 VerticalOptions="End" 
                                 HorizontalOptions="End" 
                                 Spacing="16" 
                                 Margin="20,0,20,20">
                <!-- Surprise Box Button -->
                <Border StrokeShape="RoundRectangle 28"
                        BackgroundColor="{StaticResource SurpriseBox}"
                        WidthRequest="56"
                        HeightRequest="56"
                        StrokeThickness="0">
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource SurpriseBox}" Offset="0,6" Opacity="0.35" Radius="12"/>
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToSurpriseBoxCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="🎁"
                           FontSize="28"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>

                <!-- Add Product Button -->
                <Border StrokeShape="RoundRectangle 32"
                        BackgroundColor="{StaticResource Primary}"
                        WidthRequest="64"
                        HeightRequest="64"
                        StrokeThickness="0">
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource Primary}" Offset="0,8" Opacity="0.4" Radius="15"/>
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToAddProductCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="+"
                           FontSize="36"
                           TextColor="White"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Margin="0,0,0,2"/>
                </Border>
            </VerticalStackLayout>

            <!-- Loading -->
            <Grid Grid.RowSpan="2" 
                  IsVisible="{Binding IsSkeletonVisible}"
                  BackgroundColor="#F5F9FC"
                  InputTransparent="False">
                <Border BackgroundColor="White"
                        WidthRequest="100"
                        HeightRequest="100"
                        StrokeThickness="0"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.15" Radius="15" Offset="0,8"/>
                    </Border.Shadow>
                    <ActivityIndicator IsRunning="True" 
                                       Color="{StaticResource Primary}" 
                                       WidthRequest="40" 
                                       HeightRequest="40"/>
                </Border>
            </Grid>
        </Grid>

        <!-- ✨ FILTER PANEL -->
        <Grid Grid.RowSpan="2" 
              BackgroundColor="#80000000" 
              IsVisible="{Binding ShowFilterPanel}"
              ZIndex="99">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ToggleFilterPanelCommand}" />
            </Grid.GestureRecognizers>

            <Border BackgroundColor="White" 
                    VerticalOptions="End" 
                    StrokeShape="RoundRectangle 24,24,0,0"
                    Padding="24,30">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,-4" Radius="20" Opacity="0.2"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="20">
                    <!-- Header -->
                    <Grid>
                        <Label Text="{extensions:Translate FilterAndSort}" 
                               FontSize="20" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"
                               HorizontalOptions="Center"/>
                        <Border StrokeShape="RoundRectangle 20"
                                BackgroundColor="#F5F9FC"
                                WidthRequest="40"
                                HeightRequest="40"
                                HorizontalOptions="End"
                                StrokeThickness="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleFilterPanelCommand}"/>
                            </Border.GestureRecognizers>
                            <Label Text="✕" 
                                   TextColor="{StaticResource TextSecondary}"
                                   FontSize="20"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" />

                    <!-- Product Type -->
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{extensions:Translate ProductType}" 
                               FontAttributes="Bold" 
                               FontSize="15"
                               TextColor="{StaticResource TextPrimary}" />
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                            <Button Text="{extensions:Translate All}" 
                                    Grid.Column="0" 
                                    Command="{Binding SetProductTypeCommand}" 
                                    CommandParameter="" 
                                    HeightRequest="42" 
                                    Padding="0" 
                                    FontSize="12" 
                                    CornerRadius="10" 
                                    BorderWidth="2" 
                                    BorderColor="{StaticResource BorderColor}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding SelectedType}" Value="{x:Null}">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                        <Setter Property="TextColor" Value="White" />
                                        <Setter Property="BorderColor" Value="{StaticResource Primary}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Button" Binding="{Binding SelectedType}" Value="{x:Null}">
                                        <Setter Property="BackgroundColor" Value="White" />
                                        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <Button Text="{extensions:Translate ForSale}" 
                                    Grid.Column="1" 
                                    Command="{Binding SetProductTypeCommand}" 
                                    CommandParameter="Satis" 
                                    HeightRequest="42" 
                                    Padding="0" 
                                    FontSize="12" 
                                    CornerRadius="10" 
                                    BorderWidth="2" 
                                    BorderColor="{StaticResource BorderColor}" 
                                    BackgroundColor="White" 
                                    TextColor="{StaticResource TextPrimary}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding SelectedType}" Value="Satis">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                        <Setter Property="TextColor" Value="White" />
                                        <Setter Property="BorderColor" Value="{StaticResource Primary}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <Button Text="{extensions:Translate Donation}" 
                                    Grid.Column="2" 
                                    Command="{Binding SetProductTypeCommand}" 
                                    CommandParameter="Bagis" 
                                    HeightRequest="42" 
                                    Padding="0" 
                                    FontSize="12" 
                                    CornerRadius="10" 
                                    BorderWidth="2" 
                                    BorderColor="{StaticResource BorderColor}" 
                                    BackgroundColor="White" 
                                    TextColor="{StaticResource TextPrimary}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding SelectedType}" Value="Bagis">
                                        <Setter Property="BackgroundColor" Value="#66BB6A" />
                                        <Setter Property="TextColor" Value="White" />
                                        <Setter Property="BorderColor" Value="#66BB6A" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <Button Text="{extensions:Translate Exchange}" 
                                    Grid.Column="3" 
                                    Command="{Binding SetProductTypeCommand}" 
                                    CommandParameter="Takas" 
                                    HeightRequest="42" 
                                    Padding="0" 
                                    FontSize="12" 
                                    CornerRadius="10" 
                                    BorderWidth="2" 
                                    BorderColor="{StaticResource BorderColor}" 
                                    BackgroundColor="White" 
                                    TextColor="{StaticResource TextPrimary}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding SelectedType}" Value="Takas">
                                        <Setter Property="BackgroundColor" Value="{StaticResource SurpriseBox}" />
                                        <Setter Property="TextColor" Value="White" />
                                        <Setter Property="BorderColor" Value="{StaticResource SurpriseBox}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Sort Options -->
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{extensions:Translate Sorting}" 
                               FontAttributes="Bold" 
                               FontSize="15"
                               TextColor="{StaticResource TextPrimary}" />

                        <Border StrokeShape="RoundRectangle 12" 
                                StrokeThickness="2" 
                                Stroke="{StaticResource BorderColor}" 
                                Padding="10,0"
                                BackgroundColor="White">
                            <Picker Title="{extensions:Translate SelectSorting}" 
                                    ItemsSource="{Binding SortOptionStrings}"
                                    SelectedIndex="{Binding SelectedSortIndex}"
                                    TextColor="{StaticResource TextPrimary}"
                                    TitleColor="{StaticResource TextSecondary}"
                                    FontSize="14">
                            </Picker>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Action Buttons -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,10,0,0">
                        <Button Text="{extensions:Translate Clear}" 
                                Grid.Column="0"
                                BackgroundColor="White" 
                                TextColor="{StaticResource TextSecondary}" 
                                BorderColor="{StaticResource BorderColor}"
                                BorderWidth="2"
                                CornerRadius="12"
                                HeightRequest="52"
                                FontSize="14"
                                FontAttributes="Bold"
                                Command="{Binding ClearFiltersCommand}"/>

                        <Button Text="{extensions:Translate Apply}" 
                                Grid.Column="1"
                                BackgroundColor="{StaticResource Primary}" 
                                TextColor="White" 
                                CornerRadius="12"
                                HeightRequest="52"
                                FontSize="14"
                                FontAttributes="Bold"
                                Command="{Binding ApplyFiltersCommand}">
                            <Button.Shadow>
                                <Shadow Brush="{StaticResource Primary}" Offset="0,4" Radius="10" Opacity="0.3"/>
                            </Button.Shadow>
                        </Button>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
