<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KamPay.ViewModels"
             xmlns:models="clr-namespace:KamPay.Models"
             xmlns:converters="clr-namespace:KamPay.Converters"
             xmlns:extensions="clr-namespace:KamPay.Extensions"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="KamPay.Views.NotificationsPage"
             x:DataType="vm:NotificationsViewModel"
             Title=""
             Shell.NavBarIsVisible="False"
             BackgroundColor="Transparent">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:DateTimeToTimeAgoConverter x:Key="DateTimeToTimeAgoConverter" />
            <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <!-- Background Circle Animation -->
        <Ellipse x:Name="Circle1"
                 Fill="#1A2196F3"
                 WidthRequest="400"
                 HeightRequest="400"
                 HorizontalOptions="End"
                 VerticalOptions="Start"
                 TranslationX="150"
                 TranslationY="-150"
                 Opacity="0.6"/>

        <Grid RowDefinitions="Auto,*" Padding="0">
            <!-- Header Section -->
            <VerticalStackLayout x:Name="HeaderSection" 
                                 Grid.Row="0" 
                                 Spacing="10" 
                                 Padding="20,50,20,20"
                                 BackgroundColor="#2196F3">

                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                        <Label Text="🔔 Bildirimler"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="White"/>
                        <Label Text="Güncel bildirimleriniz"
                               FontSize="14"
                               TextColor="#E3F2FD"
                               Opacity="0.9"/>
                    </VerticalStackLayout>

                    <Border Grid.Column="1"
                            StrokeShape="RoundRectangle 20"
                            StrokeThickness="0"
                            BackgroundColor="#42A5F5"
                            Padding="10"
                            VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding MarkAllAsReadCommand}"/>
                        </Border.GestureRecognizers>
                        <Label Text="✓ Tümü"
                               TextColor="White"
                               FontSize="12"
                               FontAttributes="Bold"/>
                    </Border>
                </Grid>
            </VerticalStackLayout>

            <!-- Content Section -->
            <Grid x:Name="ContentSection" Grid.Row="1" BackgroundColor="#F5F5F5">
                <RefreshView Command="{Binding RefreshNotificationsCommand}"
                             IsRefreshing="{Binding IsRefreshing}"
                             RefreshColor="#2196F3">

                    <CollectionView ItemsSource="{Binding Notifications}"
                                    SelectionMode="None"
                                    Margin="10,10,10,0">

                        <CollectionView.EmptyView>
                            <VerticalStackLayout VerticalOptions="Center" 
                                                 HorizontalOptions="Center" 
                                                 Spacing="15"
                                                 Padding="30">
                                <Label Text="🔔"
                                       FontSize="60"
                                       HorizontalTextAlignment="Center"
                                       Opacity="0.3"/>

                                <Label Text="Bildirim Yok" 
                                       FontSize="18" 
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Gray600}"
                                       HorizontalTextAlignment="Center"/>

                                <Label Text="Yeni bildirimleriniz burada görünecek"
                                       FontSize="14"
                                       TextColor="{StaticResource Gray500}"
                                       HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Notification">
                                <SwipeView Margin="0,0,0,10">
                                    <SwipeView.RightItems>
                                        <SwipeItems>
                                            <SwipeItem Text="Sil"
                                                       BackgroundColor="{StaticResource Danger}"
                                                       Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotificationsViewModel}}, Path=DeleteNotificationCommand}"
                                                       CommandParameter="{Binding .}">
                                                <SwipeItem.IconImageSource>
                                                    <FontImageSource FontFamily="MaterialIcons" 
                                                                     Glyph="&#xe872;" 
                                                                     Color="White"/>
                                                </SwipeItem.IconImageSource>
                                            </SwipeItem>
                                        </SwipeItems>
                                    </SwipeView.RightItems>

                                    <Border StrokeShape="RoundRectangle 16"
                                            StrokeThickness="0"
                                            BackgroundColor="White"
                                            Padding="15">

                                        <Border.Shadow>
                                            <Shadow Brush="Black" Opacity="0.08" Radius="8" Offset="0,2"/>
                                        </Border.Shadow>

                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsRead}" Value="False">
                                                <Setter Property="BackgroundColor" Value="#E3F2FD"/>
                                            </DataTrigger>
                                        </Border.Triggers>

                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <!-- Icon -->
                                            <Border Grid.Column="0"
                                                    StrokeShape="RoundRectangle 20"
                                                    HeightRequest="40"
                                                    WidthRequest="40"
                                                    Padding="0"
                                                    StrokeThickness="0"
                                                    VerticalOptions="Start">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Type}" Value="NewMessage">
                                                        <Setter Property="BackgroundColor" Value="#E3F2FD"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Type}" Value="ProductSold">
                                                        <Setter Property="BackgroundColor" Value="#FFF3E0"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Type}" Value="BadgeEarned">
                                                        <Setter Property="BackgroundColor" Value="#F3E5F5"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Type}" Value="SystemNotice">
                                                        <Setter Property="BackgroundColor" Value="#E8F5E9"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Type}" Value="NewOffer">
                                                        <Setter Property="BackgroundColor" Value="#FFF9C4"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Type}" Value="OfferAccepted">
                                                        <Setter Property="BackgroundColor" Value="#C8E6C9"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Type}" Value="OfferRejected">
                                                        <Setter Property="BackgroundColor" Value="#FFCDD2"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Type}" Value="Quote">
                                                        <Setter Property="BackgroundColor" Value="#E1F5FE"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Type}" Value="ServiceCompleted">
                                                        <Setter Property="BackgroundColor" Value="#D1C4E9"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Type}" Value="SurpriseBoxWon">
                                                        <Setter Property="BackgroundColor" Value="#FFECB3"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Type}" Value="DonationClaimed">
                                                        <Setter Property="BackgroundColor" Value="#FFCCBC"/>
                                                    </DataTrigger>
                                                </Border.Triggers>

                                                <Label HorizontalOptions="Center" 
                                                       VerticalOptions="Center"
                                                       FontSize="20">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="NewMessage">
                                                            <Setter Property="Text" Value="💬"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="ProductSold">
                                                            <Setter Property="Text" Value="🎉"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="BadgeEarned">
                                                            <Setter Property="Text" Value="🏆"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="SystemNotice">
                                                            <Setter Property="Text" Value="📢"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="NewFavorite">
                                                            <Setter Property="Text" Value="❤️"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="DonationMade">
                                                            <Setter Property="Text" Value="🎁"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="PointsEarned">
                                                            <Setter Property="Text" Value="⭐"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="ProductViewed">
                                                            <Setter Property="Text" Value="👁️"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="NewOffer">
                                                            <Setter Property="Text" Value="💰"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="OfferAccepted">
                                                            <Setter Property="Text" Value="✅"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="OfferRejected">
                                                            <Setter Property="Text" Value="❌"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="Quote">
                                                            <Setter Property="Text" Value="💵"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="ServiceCompleted">
                                                            <Setter Property="Text" Value="✔️"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="SurpriseBoxWon">
                                                            <Setter Property="Text" Value="🎁"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="DonationClaimed">
                                                            <Setter Property="Text" Value="🤝"/>
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </Border>

                                            <!-- Content -->
                                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                                <Label Text="{Binding Title}" 
                                                       FontSize="15" 
                                                       FontAttributes="Bold" 
                                                       TextColor="{StaticResource TextPrimary}"
                                                       LineBreakMode="TailTruncation"/>

                                                <Label Text="{Binding Message}" 
                                                       FontSize="13" 
                                                       TextColor="#616161" 
                                                       LineBreakMode="WordWrap"
                                                       MaxLines="3"/>

                                                <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                                                    <Label Text="🕒"
                                                           FontSize="11"
                                                           VerticalOptions="Center"/>
                                                    <Label Text="{Binding CreatedAt, Converter={StaticResource DateTimeToTimeAgoConverter}}" 
                                                           FontSize="11" 
                                                           TextColor="{StaticResource TextHint}"
                                                           VerticalOptions="Center"/>

                                                    <Border StrokeShape="RoundRectangle 8" 
                                                            StrokeThickness="0" 
                                                            BackgroundColor="#F5F5F5" 
                                                            Padding="6,2"
                                                            VerticalOptions="Center">
                                                        <Label FontSize="10" 
                                                               TextColor="{StaticResource TextSecondary}"
                                                               FontAttributes="Bold">
                                                            <Label.Triggers>
                                                                <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="SystemNotice">
                                                                    <Setter Property="Text" Value="Sistem"/>
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="ProductSold">
                                                                    <Setter Property="Text" Value="Satış"/>
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="NewMessage">
                                                                    <Setter Property="Text" Value="Mesaj"/>
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="BadgeEarned">
                                                                    <Setter Property="Text" Value="Rozet"/>
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="NewOffer">
                                                                    <Setter Property="Text" Value="Teklif"/>
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="OfferAccepted">
                                                                    <Setter Property="Text" Value="Kabul"/>
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="OfferRejected">
                                                                    <Setter Property="Text" Value="Red"/>
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="Quote">
                                                                    <Setter Property="Text" Value="Fiyat"/>
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="ServiceCompleted">
                                                                    <Setter Property="Text" Value="Hizmet"/>
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="SurpriseBoxWon">
                                                                    <Setter Property="Text" Value="Kutu"/>
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Label" Binding="{Binding Type}" Value="DonationClaimed">
                                                                    <Setter Property="Text" Value="Bağış"/>
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                    </Border>
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>

                                            <!-- Unread Indicator -->
                                            <BoxView Grid.Column="2"
                                                     HeightRequest="10"
                                                     WidthRequest="10"
                                                     CornerRadius="5"
                                                     BackgroundColor="#2196F3"
                                                     VerticalOptions="Center"
                                                     IsVisible="{Binding IsRead, Converter={StaticResource InvertedBoolConverter}}"/>
                                        </Grid>

                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotificationsViewModel}}, Path=MarkAsReadCommand}"
                                                                  CommandParameter="{Binding .}"/>
                                        </Border.GestureRecognizers>
                                    </Border>
                                </SwipeView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </RefreshView>

                <!-- Loading Indicator -->
                <Grid IsVisible="{Binding IsLoading}" BackgroundColor="#80000000">
                    <VerticalStackLayout VerticalOptions="Center"
                                         HorizontalOptions="Center"
                                         Spacing="10">
                        <ActivityIndicator IsRunning="True" 
                                           Color="#2196F3" 
                                           WidthRequest="50"
                                           HeightRequest="50"/>
                        <Label Text="Yükleniyor..."
                               TextColor="White"
                               FontSize="14"/>
                    </VerticalStackLayout>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
