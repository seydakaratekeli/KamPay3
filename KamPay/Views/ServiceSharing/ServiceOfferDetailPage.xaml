<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KamPay.ViewModels"
             xmlns:models="clr-namespace:KamPay.Models"
             xmlns:converters="clr-namespace:KamPay.Converters"
             xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
             xmlns:extensions="clr-namespace:KamPay.Extensions"
             x:Class="KamPay.Views.ServiceOfferDetailPage"
             x:DataType="vm:ServiceOfferDetailViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:ServiceCategoryToTextConverter x:Key="ServiceCategoryToTextConverter" />
            <converters:DateTimeToTimeAgoConverter x:Key="DateTimeToTimeAgoConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- HEADER -->
        <Grid Grid.Row="0" HeightRequest="120">
            <BoxView>
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{StaticResource Primary}" Offset="0.0" />
                        <GradientStop Color="{StaticResource PrimaryDark}" Offset="1.0" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

            <Ellipse WidthRequest="200" 
                     HeightRequest="200"
                     Fill="White"
                     Opacity="0.05"
                     HorizontalOptions="End"
                     VerticalOptions="Start"
                     Margin="0,-80,-80,0"/>

            <Grid ColumnDefinitions="Auto,*,Auto" Padding="20,50,20,15">
                <Border Grid.Column="0" 
                        StrokeShape="RoundRectangle 20" 
                        BackgroundColor="#33FFFFFF" 
                        WidthRequest="40" 
                        HeightRequest="40" 
                        StrokeThickness="0"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="←" 
                           TextColor="White" 
                           FontSize="24" 
                           HorizontalOptions="Center" 
                           VerticalOptions="Center"/>
                </Border>

                <Label Grid.Column="1" 
                       Text="İlan Detayı" 
                       FontSize="20" 
                       FontAttributes="Bold" 
                       TextColor="White" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center"/>
            </Grid>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Padding="20,20,20,100">
                
                <!-- Kategori ve Başlık -->
                <VerticalStackLayout Spacing="10">
                    <Border BackgroundColor="#E3F2FD" 
                            Padding="10,5" 
                            StrokeThickness="0"
                            HorizontalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Label Text="{Binding Offer.Category, Converter={StaticResource ServiceCategoryToTextConverter}}" 
                               FontSize="12" 
                               TextColor="{StaticResource Primary}" 
                               FontAttributes="Bold" />
                    </Border>
                    
                    <Label Text="{Binding Offer.Title}" 
                           FontSize="24" 
                           FontAttributes="Bold" 
                           TextColor="{StaticResource TextPrimary}" />
                </VerticalStackLayout>

                <!-- Fiyat ve Süre -->
                <Border StrokeShape="RoundRectangle 16"
                        BackgroundColor="#FFF8E1"
                        StrokeThickness="0"
                        Padding="20">
                    <Grid ColumnDefinitions="*,*">
                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <Label Text="Fiyat" FontSize="13" TextColor="{StaticResource TextSecondary}"/>
                            <Label Text="{Binding Offer.Price, StringFormat='{0:N2} ₺'}" 
                                   FontSize="22" 
                                   FontAttributes="Bold" 
                                   TextColor="{StaticResource Primary}"/>
                        </VerticalStackLayout>
                        
                        <VerticalStackLayout Grid.Column="1" Spacing="5" HorizontalOptions="End" HorizontalTextAlignment="End">
                            <Label Text="Tahmini Süre" FontSize="13" TextColor="{StaticResource TextSecondary}"/>
                            <HorizontalStackLayout Spacing="5" HorizontalOptions="End">
                                <Label Text="⏱" FontSize="18" TextColor="{StaticResource Primary}" VerticalOptions="Center"/>
                                <Label Text="{Binding Offer.TimeCredits}" FontSize="22" TextColor="{StaticResource Primary}" FontAttributes="Bold"/>
                                <Label Text="Saat" FontSize="14" TextColor="{StaticResource Primary}" VerticalOptions="End" Margin="0,0,0,3"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Profil Kartı -->
                <Border StrokeShape="RoundRectangle 16"
                        BackgroundColor="White"
                        StrokeThickness="0"
                        Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="10" Opacity="0.05"/>
                    </Border.Shadow>
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" RowSpacing="15" ColumnSpacing="15">
                        <ffimageloading:CachedImage Grid.Row="0" Grid.Column="0"
                                                    Source="{Binding Offer.ProviderPhotoUrl}" 
                                                    Aspect="AspectFill" 
                                                    HeightRequest="60" 
                                                    WidthRequest="60" 
                                                    LoadingPlaceholder="person_icon.svg" 
                                                    ErrorPlaceholder="person_icon.svg" 
                                                    VerticalOptions="Center">
                            <ffimageloading:CachedImage.Clip>
                                <EllipseGeometry Center="30,30" RadiusX="30" RadiusY="30" />
                            </ffimageloading:CachedImage.Clip>
                        </ffimageloading:CachedImage>
                        
                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding Offer.ProviderName}" 
                                   FontAttributes="Bold" 
                                   FontSize="16" 
                                   TextColor="{StaticResource TextPrimary}" />
                            <Label Text="Profesyonel Hizmet Veren" 
                                   FontSize="12" 
                                   TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>

                        <!-- İstatistikler -->
                        <Grid Grid.Row="1" Grid.ColumnSpan="3" ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="0,10,0,0">
                            <VerticalStackLayout Grid.Column="0" Spacing="5" HorizontalOptions="Center">
                                <Label Text="{Binding ProviderAverageRating, StringFormat='★ {0:F1}'}" FontSize="16" FontAttributes="Bold" TextColor="#FFC107" HorizontalOptions="Center"/>
                                <Label Text="Puan" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                            
                            <BoxView Grid.Column="1" WidthRequest="1" Color="{StaticResource BorderColor}" HorizontalOptions="Start"/>
                            
                            <VerticalStackLayout Grid.Column="1" Spacing="5" HorizontalOptions="Center">
                                <Label Text="{Binding ProviderCompletedJobs}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center"/>
                                <Label Text="İş" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                            
                            <BoxView Grid.Column="2" WidthRequest="1" Color="{StaticResource BorderColor}" HorizontalOptions="Start"/>
                            
                            <VerticalStackLayout Grid.Column="2" Spacing="5" HorizontalOptions="Center">
                                <Label Text="{Binding Offer.CreatedAt, Converter={StaticResource DateTimeToTimeAgoConverter}}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center"/>
                                <Label Text="İlan Tarihi" FontSize="11" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Açıklama -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Hizmet Detayları" 
                           FontSize="16" 
                           FontAttributes="Bold" 
                           TextColor="{StaticResource TextPrimary}"/>
                    <Label Text="{Binding Offer.Description}" 
                           TextColor="{StaticResource TextSecondary}" 
                           FontSize="14" 
                           LineHeight="1.5" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
        
        <!-- SABİT ALT AKSİYON ÇUBUĞU (Başkası ise) -->
        <Border Grid.Row="1" 
                VerticalOptions="End" 
                BackgroundColor="White" 
                StrokeThickness="0" 
                Padding="20"
                IsVisible="{Binding IsNotCurrentUserOwner}">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,-4" Radius="15" Opacity="0.1"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">
                <Border Grid.Column="0" 
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="#FFF8E1"
                        WidthRequest="50"
                        HeightRequest="50"
                        StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding MessageProviderCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="💬" 
                           FontSize="24"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>
                
                <Button Grid.Column="1" 
                        Text="Hizmet Talep Et" 
                        Command="{Binding RequestServiceCommand}"
                        BackgroundColor="{StaticResource Primary}" 
                        TextColor="White" 
                        FontAttributes="Bold" 
                        FontSize="16" 
                        CornerRadius="12" 
                        HeightRequest="50">
                    <Button.Shadow>
                        <Shadow Brush="{StaticResource Primary}" Offset="0,4" Radius="8" Opacity="0.3"/>
                    </Button.Shadow>
                </Button>
            </Grid>
        </Border>

        <!-- SABİT ALT AKSİYON ÇUBUĞU (Sahibi ise) -->
        <Border Grid.Row="1" 
                VerticalOptions="End" 
                BackgroundColor="White" 
                StrokeThickness="0" 
                Padding="20"
                IsVisible="{Binding IsCurrentUserOwner}">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,-4" Radius="15" Opacity="0.1"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                <Button Grid.Column="0" 
                        Text="Sil" 
                        Command="{Binding DeleteOfferCommand}"
                        BackgroundColor="#FFEbee" 
                        TextColor="#D32F2F" 
                        FontAttributes="Bold" 
                        FontSize="16" 
                        CornerRadius="12" 
                        HeightRequest="50">
                </Button>
                
                <Button Grid.Column="1" 
                        Text="Düzenle" 
                        Command="{Binding EditOfferCommand}"
                        BackgroundColor="{StaticResource Primary}" 
                        TextColor="White" 
                        FontAttributes="Bold" 
                        FontSize="16" 
                        CornerRadius="12" 
                        HeightRequest="50">
                    <Button.Shadow>
                        <Shadow Brush="{StaticResource Primary}" Offset="0,4" Radius="8" Opacity="0.3"/>
                    </Button.Shadow>
                </Button>
            </Grid>
        </Border>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="2"
              IsVisible="{Binding IsLoading}"
              BackgroundColor="{StaticResource Background}"
              ZIndex="1100"
              InputTransparent="False">
            <Border BackgroundColor="White"
                    WidthRequest="100"
                    HeightRequest="100"
                    StrokeThickness="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.15" Radius="15" Offset="0,8"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                    <ActivityIndicator IsRunning="True" 
                                       Color="{StaticResource Primary}" 
                                       WidthRequest="40" 
                                       HeightRequest="40"/>
                    <Label Text="İşleniyor..." 
                           TextColor="{StaticResource Primary}" 
                           FontSize="13"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
