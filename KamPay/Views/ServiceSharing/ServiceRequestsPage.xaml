<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:extensions="clr-namespace:KamPay.Extensions"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KamPay.ViewModels"
             xmlns:models="clr-namespace:KamPay.Models"
             xmlns:converters="clr-namespace:KamPay.Converters"
             xmlns:res="clr-namespace:KamPay.Services"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             x:Class="KamPay.Views.ServiceRequestsPage"
             x:DataType="vm:ServiceRequestsViewModel"
             x:Name="ThisPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}">

    <ContentPage.Resources>
        <ResourceDictionary>

            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:IsPendingConverter x:Key="IsPendingConverter" />
            <converters:EnumToBoolConverter x:Key="EnumToBoolConverter" />
            <converters:IsNotNullOrEmptyConverter x:Key="IsNotNullOrEmptyConverter" />
            <converters:IsNotZeroConverter x:Key="IsNotZeroConverter" />
            <converters:IsNegotiatingConverter x:Key="IsNegotiatingConverter" />
            <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ✨ GRADIENT HEADER -->
        <Grid Grid.Row="0" x:Name="HeaderSection">
            <BoxView>
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{StaticResource Primary}" Offset="0.0" />
                        <GradientStop Color="{StaticResource PrimaryDark}" Offset="1.0" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

            <Ellipse x:Name="Circle1" 
                      WidthRequest="150" 
                      HeightRequest="150"
                      Fill="White"
                      Opacity="0.05"
                      HorizontalOptions="End"
                      VerticalOptions="Start"
                      Margin="0,-60,-60,0"/>

            <Label Text="{extensions:Translate ServiceRequestsTitle}"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="White"
                   Margin="20,50,20,20"
                   HorizontalTextAlignment="Center"/>
        </Grid>

        <!-- ✨ TAB BUTTONS -->
        <Grid Grid.Row="1" 
              ColumnDefinitions="*,*" 
              Padding="15,10" 
              ColumnSpacing="10" 
              BackgroundColor="White"
              x:Name="TabSection">

            <Border Grid.Column="0"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="0"
                    HeightRequest="45"
                    BackgroundColor="{Binding IsIncomingSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='{StaticResource Primary}|White'}">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource Primary}" Offset="0,2" Radius="6" Opacity="0.3"/>
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectIncomingCommand}"/>
                </Border.GestureRecognizers>
                <Label Text="{extensions:Translate IncomingRequests}"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{Binding IsIncomingSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='White|{StaticResource Primary}'}"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"/>
            </Border>

            <Border Grid.Column="1"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="0"
                    HeightRequest="45"
                    BackgroundColor="{Binding IsOutgoingSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='{StaticResource Primary}|White'}">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource Primary}" Offset="0,2" Radius="6" Opacity="0.3"/>
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectOutgoingCommand}"/>
                </Border.GestureRecognizers>
                <Label Text="{extensions:Translate OutgoingRequests}"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{Binding IsOutgoingSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='White|{StaticResource Primary}'}"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"/>
            </Border>
        </Grid>

        <!-- ✨ MAIN CONTENT -->
        <Grid Grid.Row="2">
            <RefreshView Command="{Binding RefreshRequestsCommand}"
                         IsRefreshing="{Binding IsRefreshing}"
                         RefreshColor="{StaticResource Primary}"
                         x:Name="ContentSection">

                <Grid>
                    <!-- GELEN TALEPLER - SfListView -->
                    <syncfusion:SfListView ItemsSource="{Binding IncomingRequests}"
                                           IsVisible="{Binding IsIncomingSelected}"
                                           Margin="15,10"
                                           SelectionMode="None"
                                           AutoFitMode="Height"
                                           ItemSpacing="0">

                        <syncfusion:SfListView.EmptyView>
                            <Grid VerticalOptions="Center" HorizontalOptions="Center" Padding="30">
                                <Border BackgroundColor="White"
                                        StrokeThickness="0"
                                        Padding="30"
                                        WidthRequest="280"
                                        HeightRequest="200">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20"/>
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Opacity="0.08" Radius="15" Offset="0,4"/>
                                    </Border.Shadow>
                                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label Text="📥" FontSize="60" HorizontalTextAlignment="Center"/>
                                        <Label Text="{extensions:Translate NoIncomingRequests}"
                                               FontSize="16"
                                               TextColor="{StaticResource TextSecondary}"
                                               HorizontalTextAlignment="Center"
                                               FontAttributes="Bold"/>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </syncfusion:SfListView.EmptyView>

                        <syncfusion:SfListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ServiceRequest">
                                <Border Margin="0,0,0,12"
                                        StrokeShape="RoundRectangle 16"
                                        StrokeThickness="0"
                                        BackgroundColor="White"
                                        Padding="15">
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Offset="0,2" Radius="10" Opacity="0.08"/>
                                    </Border.Shadow>

                                    <VerticalStackLayout Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0" 
                                                   Text="{Binding ServiceTitle}"
                                                   TextColor="{StaticResource TextPrimary}"
                                                   FontAttributes="Bold"
                                                   FontSize="16"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1"/>
                                            <Label Grid.Column="1"
                                                   Text="{Binding Status}"
                                                   FontSize="11"
                                                   TextColor="{StaticResource Primary}"
                                                   FontAttributes="Bold"/>
                                        </Grid>

                                        <Label Text="{Binding RequesterName, StringFormat='Talep Eden: {0}'}"
                                               FontSize="13"
                                               TextColor="{StaticResource TextSecondary}"/>

                                        <Label Text="{Binding Message}"
                                               FontSize="14"
                                               TextColor="{StaticResource TextPrimary}"
                                               MaxLines="2"
                                               LineBreakMode="TailTruncation"
                                               IsVisible="{Binding Message, Converter={StaticResource IsNotNullOrEmptyConverter}}"/>

                                        <!-- Pazarlık Alanı -->
                                        <Border IsVisible="{Binding IsNegotiating}"
                                                Padding="10"
                                                BackgroundColor="#FFF3E0"
                                                StrokeShape="RoundRectangle 12"
                                                StrokeThickness="0">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <VerticalStackLayout Grid.Column="0">
                                                    <Label Text="💰 Pazarlık Teklifi" FontSize="11" FontAttributes="Bold" TextColor="#E65100"/>
                                                    <Label Text="{Binding ProposedPriceByRequester, StringFormat='{0} ₺'}" 
                                                           FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                                                </VerticalStackLayout>
                                                <Button Grid.Column="1"
                                                        Text="Karşı Teklif"
                                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SendCounterOfferCommand}"
                                                        CommandParameter="{Binding .}"
                                                        FontSize="11"
                                                        HeightRequest="30"
                                                        Padding="10,0"
                                                        BackgroundColor="#FB8C00"/>
                                            </Grid>
                                        </Border>

                                        <!-- ✨ VISUAL TIMELINE -->
                                        <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto" Margin="0,5">
                                            <!-- Adım 1: Talep -->
                                            <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                                                <Ellipse WidthRequest="16" HeightRequest="16" Fill="{StaticResource Primary}"/>
                                                <Label Text="İletildi" FontSize="9" TextColor="{StaticResource Primary}" FontAttributes="Bold"/>
                                            </VerticalStackLayout>
                                            
                                            <BoxView Grid.Column="1" HeightRequest="2" VerticalOptions="Start" Margin="0,7,0,0">
                                                <BoxView.Triggers>
                                                    <DataTrigger TargetType="BoxView" Binding="{Binding Status}" Value="Pending">
                                                        <Setter Property="Color" Value="{StaticResource BorderColor}"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="BoxView" Binding="{Binding Status}" Value="Accepted">
                                                        <Setter Property="Color" Value="{StaticResource Primary}"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="BoxView" Binding="{Binding Status}" Value="AwaitingConfirmation">
                                                        <Setter Property="Color" Value="{StaticResource Primary}"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="BoxView" Binding="{Binding Status}" Value="Completed">
                                                        <Setter Property="Color" Value="{StaticResource Primary}"/>
                                                    </DataTrigger>
                                                </BoxView.Triggers>
                                            </BoxView>

                                            <!-- Adım 2: Onay -->
                                            <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                                                <Ellipse WidthRequest="16" HeightRequest="16">
                                                    <Ellipse.Triggers>
                                                        <DataTrigger TargetType="Ellipse" Binding="{Binding Status}" Value="Pending">
                                                            <Setter Property="Fill" Value="{StaticResource BorderColor}"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Ellipse" Binding="{Binding Status}" Value="Accepted">
                                                            <Setter Property="Fill" Value="{StaticResource Primary}"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Ellipse" Binding="{Binding Status}" Value="AwaitingConfirmation">
                                                            <Setter Property="Fill" Value="{StaticResource Primary}"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Ellipse" Binding="{Binding Status}" Value="Completed">
                                                            <Setter Property="Fill" Value="{StaticResource Primary}"/>
                                                        </DataTrigger>
                                                    </Ellipse.Triggers>
                                                </Ellipse>
                                                <Label Text="Onay" FontSize="9">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Pending">
                                                            <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
                                                            <Setter Property="FontAttributes" Value="None"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Accepted">
                                                            <Setter Property="TextColor" Value="{StaticResource Primary}"/>
                                                            <Setter Property="FontAttributes" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </VerticalStackLayout>

                                            <BoxView Grid.Column="3" HeightRequest="2" VerticalOptions="Start" Margin="0,7,0,0">
                                                <BoxView.Triggers>
                                                    <DataTrigger TargetType="BoxView" Binding="{Binding Status}" Value="Pending">
                                                        <Setter Property="Color" Value="{StaticResource BorderColor}"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="BoxView" Binding="{Binding Status}" Value="Accepted">
                                                        <Setter Property="Color" Value="{StaticResource BorderColor}"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="BoxView" Binding="{Binding Status}" Value="AwaitingConfirmation">
                                                        <Setter Property="Color" Value="{StaticResource Primary}"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="BoxView" Binding="{Binding Status}" Value="Completed">
                                                        <Setter Property="Color" Value="{StaticResource Primary}"/>
                                                    </DataTrigger>
                                                </BoxView.Triggers>
                                            </BoxView>

                                            <!-- Adım 3: İşlemde -->
                                            <VerticalStackLayout Grid.Column="4" Spacing="2" HorizontalOptions="Center">
                                                <Ellipse WidthRequest="16" HeightRequest="16">
                                                    <Ellipse.Triggers>
                                                        <DataTrigger TargetType="Ellipse" Binding="{Binding Status}" Value="Pending">
                                                            <Setter Property="Fill" Value="{StaticResource BorderColor}"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Ellipse" Binding="{Binding Status}" Value="Accepted">
                                                            <Setter Property="Fill" Value="{StaticResource BorderColor}"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Ellipse" Binding="{Binding Status}" Value="AwaitingConfirmation">
                                                            <Setter Property="Fill" Value="{StaticResource Primary}"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Ellipse" Binding="{Binding Status}" Value="Completed">
                                                            <Setter Property="Fill" Value="{StaticResource Primary}"/>
                                                        </DataTrigger>
                                                    </Ellipse.Triggers>
                                                </Ellipse>
                                                <Label Text="İşlemde" FontSize="9">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Pending">
                                                            <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
                                                            <Setter Property="FontAttributes" Value="None"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Accepted">
                                                            <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
                                                            <Setter Property="FontAttributes" Value="None"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="AwaitingConfirmation">
                                                            <Setter Property="TextColor" Value="{StaticResource Primary}"/>
                                                            <Setter Property="FontAttributes" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </VerticalStackLayout>
                                            
                                            <BoxView Grid.Column="5" HeightRequest="2" VerticalOptions="Start" Margin="0,7,0,0">
                                                <BoxView.Triggers>
                                                    <DataTrigger TargetType="BoxView" Binding="{Binding Status}" Value="Pending">
                                                        <Setter Property="Color" Value="{StaticResource BorderColor}"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="BoxView" Binding="{Binding Status}" Value="Accepted">
                                                        <Setter Property="Color" Value="{StaticResource BorderColor}"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="BoxView" Binding="{Binding Status}" Value="AwaitingConfirmation">
                                                        <Setter Property="Color" Value="{StaticResource BorderColor}"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="BoxView" Binding="{Binding Status}" Value="Completed">
                                                        <Setter Property="Color" Value="#4CAF50"/>
                                                    </DataTrigger>
                                                </BoxView.Triggers>
                                            </BoxView>

                                            <!-- Adım 4: Tamamlandı -->
                                            <VerticalStackLayout Grid.Column="6" Spacing="2" HorizontalOptions="Center">
                                                <Ellipse WidthRequest="16" HeightRequest="16">
                                                    <Ellipse.Triggers>
                                                        <DataTrigger TargetType="Ellipse" Binding="{Binding Status}" Value="Pending">
                                                            <Setter Property="Fill" Value="{StaticResource BorderColor}"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Ellipse" Binding="{Binding Status}" Value="Accepted">
                                                            <Setter Property="Fill" Value="{StaticResource BorderColor}"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Ellipse" Binding="{Binding Status}" Value="AwaitingConfirmation">
                                                            <Setter Property="Fill" Value="{StaticResource BorderColor}"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Ellipse" Binding="{Binding Status}" Value="Completed">
                                                            <Setter Property="Fill" Value="#4CAF50"/>
                                                        </DataTrigger>
                                                    </Ellipse.Triggers>
                                                </Ellipse>
                                                <Label Text="Bitti" FontSize="9">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Pending">
                                                            <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
                                                            <Setter Property="FontAttributes" Value="None"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Accepted">
                                                            <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
                                                            <Setter Property="FontAttributes" Value="None"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="AwaitingConfirmation">
                                                            <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
                                                            <Setter Property="FontAttributes" Value="None"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Completed">
                                                            <Setter Property="TextColor" Value="#4CAF50"/>
                                                            <Setter Property="FontAttributes" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </VerticalStackLayout>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0"
                                                   Text="{Binding Price, StringFormat='{0} ₺'}"
                                                   TextColor="{StaticResource Primary}"
                                                   FontAttributes="Bold"
                                                   FontSize="18"
                                                   VerticalOptions="Center"/>

                                            <HorizontalStackLayout Grid.Column="1" Spacing="8">
                                                <Button Text="💬"
                                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.StartConversationCommand}"
                                                        CommandParameter="{Binding .}"
                                                        BackgroundColor="#E3F2FD"
                                                        TextColor="{StaticResource Primary}"
                                                        WidthRequest="45"
                                                        HeightRequest="45"
                                                        CornerRadius="22"
                                                        FontSize="18"
                                                        Padding="0"/>

                                                <Button Text="✓"
                                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.AcceptRequestCommand}"
                                                        CommandParameter="{Binding .}"
                                                        BackgroundColor="#4CAF50"
                                                        TextColor="White"
                                                        WidthRequest="45"
                                                        HeightRequest="45"
                                                        CornerRadius="22"
                                                        FontSize="20"
                                                        Padding="0"
                                                        IsVisible="{Binding Status, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Pending}"/>

                                                <Button Text="✕"
                                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.DeclineRequestCommand}"
                                                        CommandParameter="{Binding .}"
                                                        BackgroundColor="{StaticResource Danger}"
                                                        TextColor="White"
                                                        WidthRequest="45"
                                                        HeightRequest="45"
                                                        CornerRadius="22"
                                                        FontSize="20"
                                                        Padding="0"
                                                        IsVisible="{Binding Status, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Pending}"/>
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </syncfusion:SfListView.ItemTemplate>
                    </syncfusion:SfListView>

                    <!-- GİDEN TALEPLER - SfListView -->
                    <syncfusion:SfListView ItemsSource="{Binding OutgoingRequests}"
                                           IsVisible="{Binding IsOutgoingSelected}"
                                           Margin="15,10"
                                           SelectionMode="None"
                                           AutoFitMode="Height"
                                           ItemSpacing="0">

                        <syncfusion:SfListView.EmptyView>
                            <Grid VerticalOptions="Center" HorizontalOptions="Center" Padding="30">
                                <Border BackgroundColor="White"
                                        StrokeThickness="0"
                                        Padding="30"
                                        WidthRequest="280"
                                        HeightRequest="200">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20"/>
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Opacity="0.08" Radius="15" Offset="0,4"/>
                                    </Border.Shadow>
                                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label Text="📤" FontSize="60" HorizontalTextAlignment="Center"/>
                                        <Label Text="{extensions:Translate NoOutgoingRequests}"
                                               FontSize="16"
                                               TextColor="{StaticResource TextSecondary}"
                                               HorizontalTextAlignment="Center"
                                               FontAttributes="Bold"/>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </syncfusion:SfListView.EmptyView>

                        <syncfusion:SfListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ServiceRequest">
                                <Border Margin="0,0,0,12"
                                        StrokeShape="RoundRectangle 16"
                                        StrokeThickness="0"
                                        BackgroundColor="White"
                                        Padding="15">
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Offset="0,2" Radius="10" Opacity="0.08"/>
                                    </Border.Shadow>

                                    <VerticalStackLayout Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0" 
                                                   Text="{Binding ServiceTitle}"
                                                   TextColor="{StaticResource TextPrimary}"
                                                   FontAttributes="Bold"
                                                   FontSize="16"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1"/>
                                            <Label Grid.Column="1"
                                                   Text="{Binding Status}"
                                                   FontSize="11"
                                                   TextColor="{StaticResource Primary}"
                                                   FontAttributes="Bold"/>
                                        </Grid>

                                        <Label Text="{Binding ProviderName, StringFormat='Sağlayıcı: {0}'}"
                                               FontSize="13"
                                               TextColor="{StaticResource TextSecondary}"/>

                                        <!-- ✨ VISUAL TIMELINE -->
                                        <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto" Margin="0,5">
                                            <!-- Adım 1: Talep -->
                                            <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                                                <Ellipse WidthRequest="16" HeightRequest="16" Fill="{StaticResource Primary}"/>
                                                <Label Text="İletildi" FontSize="9" TextColor="{StaticResource Primary}" FontAttributes="Bold"/>
                                            </VerticalStackLayout>
                                            
                                            <BoxView Grid.Column="1" HeightRequest="2" VerticalOptions="Start" Margin="0,7,0,0">
                                                <BoxView.Triggers>
                                                    <DataTrigger TargetType="BoxView" Binding="{Binding Status}" Value="Pending">
                                                        <Setter Property="Color" Value="{StaticResource BorderColor}"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="BoxView" Binding="{Binding Status}" Value="Accepted">
                                                        <Setter Property="Color" Value="{StaticResource Primary}"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="BoxView" Binding="{Binding Status}" Value="AwaitingConfirmation">
                                                        <Setter Property="Color" Value="{StaticResource Primary}"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="BoxView" Binding="{Binding Status}" Value="Completed">
                                                        <Setter Property="Color" Value="{StaticResource Primary}"/>
                                                    </DataTrigger>
                                                </BoxView.Triggers>
                                            </BoxView>

                                            <!-- Adım 2: Onay -->
                                            <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                                                <Ellipse WidthRequest="16" HeightRequest="16">
                                                    <Ellipse.Triggers>
                                                        <DataTrigger TargetType="Ellipse" Binding="{Binding Status}" Value="Pending">
                                                            <Setter Property="Fill" Value="{StaticResource BorderColor}"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Ellipse" Binding="{Binding Status}" Value="Accepted">
                                                            <Setter Property="Fill" Value="{StaticResource Primary}"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Ellipse" Binding="{Binding Status}" Value="AwaitingConfirmation">
                                                            <Setter Property="Fill" Value="{StaticResource Primary}"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Ellipse" Binding="{Binding Status}" Value="Completed">
                                                            <Setter Property="Fill" Value="{StaticResource Primary}"/>
                                                        </DataTrigger>
                                                    </Ellipse.Triggers>
                                                </Ellipse>
                                                <Label Text="Onay" FontSize="9">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Pending">
                                                            <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
                                                            <Setter Property="FontAttributes" Value="None"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Accepted">
                                                            <Setter Property="TextColor" Value="{StaticResource Primary}"/>
                                                            <Setter Property="FontAttributes" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </VerticalStackLayout>

                                            <BoxView Grid.Column="3" HeightRequest="2" VerticalOptions="Start" Margin="0,7,0,0">
                                                <BoxView.Triggers>
                                                    <DataTrigger TargetType="BoxView" Binding="{Binding Status}" Value="Pending">
                                                        <Setter Property="Color" Value="{StaticResource BorderColor}"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="BoxView" Binding="{Binding Status}" Value="Accepted">
                                                        <Setter Property="Color" Value="{StaticResource BorderColor}"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="BoxView" Binding="{Binding Status}" Value="AwaitingConfirmation">
                                                        <Setter Property="Color" Value="{StaticResource Primary}"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="BoxView" Binding="{Binding Status}" Value="Completed">
                                                        <Setter Property="Color" Value="{StaticResource Primary}"/>
                                                    </DataTrigger>
                                                </BoxView.Triggers>
                                            </BoxView>

                                            <!-- Adım 3: İşlemde -->
                                            <VerticalStackLayout Grid.Column="4" Spacing="2" HorizontalOptions="Center">
                                                <Ellipse WidthRequest="16" HeightRequest="16">
                                                    <Ellipse.Triggers>
                                                        <DataTrigger TargetType="Ellipse" Binding="{Binding Status}" Value="Pending">
                                                            <Setter Property="Fill" Value="{StaticResource BorderColor}"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Ellipse" Binding="{Binding Status}" Value="Accepted">
                                                            <Setter Property="Fill" Value="{StaticResource BorderColor}"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Ellipse" Binding="{Binding Status}" Value="AwaitingConfirmation">
                                                            <Setter Property="Fill" Value="{StaticResource Primary}"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Ellipse" Binding="{Binding Status}" Value="Completed">
                                                            <Setter Property="Fill" Value="{StaticResource Primary}"/>
                                                        </DataTrigger>
                                                    </Ellipse.Triggers>
                                                </Ellipse>
                                                <Label Text="İşlemde" FontSize="9">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Pending">
                                                            <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
                                                            <Setter Property="FontAttributes" Value="None"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Accepted">
                                                            <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
                                                            <Setter Property="FontAttributes" Value="None"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="AwaitingConfirmation">
                                                            <Setter Property="TextColor" Value="{StaticResource Primary}"/>
                                                            <Setter Property="FontAttributes" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </VerticalStackLayout>
                                            
                                            <BoxView Grid.Column="5" HeightRequest="2" VerticalOptions="Start" Margin="0,7,0,0">
                                                <BoxView.Triggers>
                                                    <DataTrigger TargetType="BoxView" Binding="{Binding Status}" Value="Pending">
                                                        <Setter Property="Color" Value="{StaticResource BorderColor}"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="BoxView" Binding="{Binding Status}" Value="Accepted">
                                                        <Setter Property="Color" Value="{StaticResource BorderColor}"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="BoxView" Binding="{Binding Status}" Value="AwaitingConfirmation">
                                                        <Setter Property="Color" Value="{StaticResource BorderColor}"/>
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="BoxView" Binding="{Binding Status}" Value="Completed">
                                                        <Setter Property="Color" Value="#4CAF50"/>
                                                    </DataTrigger>
                                                </BoxView.Triggers>
                                            </BoxView>

                                            <!-- Adım 4: Tamamlandı -->
                                            <VerticalStackLayout Grid.Column="6" Spacing="2" HorizontalOptions="Center">
                                                <Ellipse WidthRequest="16" HeightRequest="16">
                                                    <Ellipse.Triggers>
                                                        <DataTrigger TargetType="Ellipse" Binding="{Binding Status}" Value="Pending">
                                                            <Setter Property="Fill" Value="{StaticResource BorderColor}"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Ellipse" Binding="{Binding Status}" Value="Accepted">
                                                            <Setter Property="Fill" Value="{StaticResource BorderColor}"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Ellipse" Binding="{Binding Status}" Value="AwaitingConfirmation">
                                                            <Setter Property="Fill" Value="{StaticResource BorderColor}"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Ellipse" Binding="{Binding Status}" Value="Completed">
                                                            <Setter Property="Fill" Value="#4CAF50"/>
                                                        </DataTrigger>
                                                    </Ellipse.Triggers>
                                                </Ellipse>
                                                <Label Text="Bitti" FontSize="9">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Pending">
                                                            <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
                                                            <Setter Property="FontAttributes" Value="None"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Accepted">
                                                            <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
                                                            <Setter Property="FontAttributes" Value="None"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="AwaitingConfirmation">
                                                            <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
                                                            <Setter Property="FontAttributes" Value="None"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Completed">
                                                            <Setter Property="TextColor" Value="#4CAF50"/>
                                                            <Setter Property="FontAttributes" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </VerticalStackLayout>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0"
                                                   Text="{Binding Price, StringFormat='{0} ₺'}"
                                                   TextColor="{StaticResource Primary}"
                                                   FontAttributes="Bold"
                                                   FontSize="18"
                                                   VerticalOptions="Center"/>

                                            <HorizontalStackLayout Grid.Column="1" Spacing="8">
                                                <Button Text="💬"
                                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.StartConversationCommand}"
                                                        CommandParameter="{Binding .}"
                                                        BackgroundColor="#E3F2FD"
                                                        TextColor="{StaticResource Primary}"
                                                        WidthRequest="45"
                                                        HeightRequest="45"
                                                        CornerRadius="22"
                                                        FontSize="18"
                                                        Padding="0"/>

                                                <Button Text="💰"
                                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ProposePriceCommand}"
                                                        CommandParameter="{Binding .}"
                                                        BackgroundColor="#FFF3E0"
                                                        TextColor="#FB8C00"
                                                        WidthRequest="45"
                                                        HeightRequest="45"
                                                        CornerRadius="22"
                                                        FontSize="18"
                                                        Padding="0"
                                                        IsVisible="{Binding Status, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Pending}"/>

                                                <Button Text="💳"
                                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.CompleteRequestCommand}"
                                                        CommandParameter="{Binding .}"
                                                        BackgroundColor="#4CAF50"
                                                        TextColor="White"
                                                        WidthRequest="45"
                                                        HeightRequest="45"
                                                        CornerRadius="22"
                                                        FontSize="18"
                                                        Padding="0"
                                                        IsVisible="{Binding Status, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Accepted}"/>

                                                <Button Text="✅"
                                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.AcceptNegotiatedPriceCommand}"
                                                        CommandParameter="{Binding .}"
                                                        BackgroundColor="#4CAF50"
                                                        TextColor="White"
                                                        WidthRequest="45"
                                                        HeightRequest="45"
                                                        CornerRadius="22"
                                                        FontSize="18"
                                                        Padding="0"
                                                        IsVisible="{Binding IsNegotiating}"/>
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </syncfusion:SfListView.ItemTemplate>
                    </syncfusion:SfListView>
                </Grid>
            </RefreshView>

            <!-- Loading Overlay -->
            <Grid IsVisible="{Binding IsLoading}"
                  BackgroundColor="{StaticResource Background}"
                  ZIndex="1100"
                  InputTransparent="False">
                <Border BackgroundColor="White"
                        WidthRequest="100"
                        HeightRequest="100"
                        StrokeThickness="0"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.15" Radius="15" Offset="0,8"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                        <ActivityIndicator IsRunning="True"
                                           Color="{StaticResource Primary}"
                                           WidthRequest="40"
                                           HeightRequest="40" />
                        <Label Text="{extensions:Translate ServiceRequestsLoading}"
                               TextColor="{StaticResource Primary}"
                               FontSize="13" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>


