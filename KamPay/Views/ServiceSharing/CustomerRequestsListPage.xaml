<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KamPay.ViewModels"
             xmlns:models="clr-namespace:KamPay.Models"
             xmlns:converters="clr-namespace:KamPay.Converters"
             xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
             xmlns:extensions="clr-namespace:KamPay.Extensions"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             x:Class="KamPay.Views.CustomerRequestsListPage"
             x:DataType="vm:CustomerRequestsListViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:ServiceCategoryToTextConverter x:Key="ServiceCategoryToTextConverter" />
            <converters:ServiceCategoryToIconConverter x:Key="ServiceCategoryToIconConverter" />
            <converters:DateTimeToTimeAgoConverter x:Key="DateTimeToTimeAgoConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- ✨ HEADER WITH GRADIENT BACKGROUND -->
        <Grid Grid.Row="0" RowDefinitions="Auto,Auto">
            <BoxView Grid.RowSpan="2">
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF6F00" Offset="0.0" />
                        <GradientStop Color="#E65100" Offset="1.0" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

            <Ellipse WidthRequest="200" 
                     HeightRequest="200"
                     Fill="White"
                     Opacity="0.05"
                     HorizontalOptions="End"
                     VerticalOptions="Start"
                     Margin="0,-80,-80,0"
                     Grid.RowSpan="2"/>

            <Grid Grid.Row="0" Padding="20,50,20,15">
                <VerticalStackLayout VerticalOptions="Center">
                    <Label Text="🔍 Hizmet Talepleri" 
                           FontSize="28" 
                           FontAttributes="Bold" 
                           TextColor="White" />
                    <Label Text="Aradığın hizmeti bul, teklifleri değerlendir" 
                           FontSize="13" 
                           TextColor="White" 
                           Opacity="0.9"/>
                </VerticalStackLayout>
            </Grid>

            <!-- Search & Filters -->
            <Grid Grid.Row="1" Padding="20,0,20,20" RowDefinitions="Auto,Auto" RowSpacing="12">
                <!-- Search Bar -->
                <Border Grid.Row="0"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        BackgroundColor="White"
                        HeightRequest="50"
                        Padding="15,0">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.1"/>
                    </Border.Shadow>
                    <Grid ColumnDefinitions="Auto,*">
                        <Label Text="🔍" VerticalOptions="Center" Opacity="0.6" FontSize="18"/>
                        <Entry Grid.Column="1"
                               Text="{Binding SearchText}"
                               Placeholder="Talep ara..."
                               FontSize="15"
                               TextColor="{StaticResource TextPrimary}"
                               PlaceholderColor="{StaticResource TextSecondary}"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center"
                               Margin="10,0,0,0"/>
                    </Grid>
                </Border>

                <!-- Filter Button -->
                <Grid Grid.Row="1">
                    <Border StrokeShape="RoundRectangle 12"
                            StrokeThickness="0"
                            BackgroundColor="White"
                            Padding="12,0">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.1"/>
                        </Border.Shadow>
                        <Picker Title="Kategori Filtrele"
                                ItemsSource="{Binding Categories}"
                                SelectedItem="{Binding FilterCategory}"
                                FontSize="13"
                                TextColor="{StaticResource TextPrimary}">
                            <Picker.ItemDisplayBinding>
                                <Binding Converter="{StaticResource ServiceCategoryToTextConverter}" />
                            </Picker.ItemDisplayBinding>
                        </Picker>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ✨ MAIN CONTENT -->
        <RefreshView Grid.Row="1"
                     Command="{Binding RefreshRequestsCommand}"
                     IsRefreshing="{Binding IsRefreshing}"
                     RefreshColor="#FF6F00">

            <CollectionView ItemsSource="{Binding FilteredRequests}"
                            SelectionMode="None"
                            Margin="15,15,15,15"
                            RemainingItemsThreshold="5"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreRequestsCommand}">

                <CollectionView.EmptyView>
                    <Grid VerticalOptions="Center" HorizontalOptions="Center" Padding="20">
                        <Border BackgroundColor="White"
                                StrokeThickness="0"
                                Padding="30"
                                WidthRequest="280"
                                HeightRequest="240">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20"/>
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="Black" Opacity="0.08" Radius="15" Offset="0,4"/>
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="15" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Text="🔍" FontSize="60" HorizontalOptions="Center"/>
                                <Label Text="Talep Bulunamadı" 
                                       FontSize="18" 
                                       TextColor="{StaticResource TextPrimary}" 
                                       HorizontalTextAlignment="Center"
                                       FontAttributes="Bold"/>
                                <Label Text="Farklı bir kategori veya kelime ile aramayı deneyin." 
                                       FontSize="14" 
                                       TextColor="{StaticResource TextSecondary}" 
                                       HorizontalTextAlignment="Center"/>
                                <Button Text="Filtreleri Temizle"
                                        Command="{Binding ClearCategoryFilterCommand}"
                                        BackgroundColor="#FFF3E0"
                                        TextColor="#FF6F00"
                                        CornerRadius="10"
                                        Margin="0,10,0,0"
                                        Padding="15,0"
                                        HeightRequest="40"
                                        FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CustomerServiceRequest">
                        <Border StrokeShape="RoundRectangle 20"
                                Margin="0,0,0,16"
                                Padding="1">
                            <Border.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFB300" Offset="0.0"/>
                                    <GradientStop Color="#E0E0E0" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Stroke>
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,4" Radius="15" Opacity="0.08"/>
                            </Border.Shadow>
                            
                            <!-- Kart İçeriği -->
                            <Border StrokeShape="RoundRectangle 20"
                                    StrokeThickness="0"
                                    BackgroundColor="White"
                                    Padding="16">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomerRequestsListViewModel}}, Path=ViewRequestDetailsCommand}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid RowDefinitions="Auto,Auto,Auto,1,Auto" RowSpacing="12">
                                    <!-- Title & Category -->
                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <Label Grid.Column="0" 
                                               Text="{Binding Title}" 
                                               FontAttributes="Bold" 
                                               FontSize="18" 
                                               TextColor="{StaticResource TextPrimary}" 
                                               LineBreakMode="TailTruncation" 
                                               MaxLines="2" 
                                               VerticalOptions="Center" />
                                        
                                        <!-- Kategori Chip -->
                                        <Border Grid.Column="1" 
                                                BackgroundColor="#FFF8E1" 
                                                Padding="12,6" 
                                                StrokeThickness="0"
                                                VerticalOptions="Start">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12"/>
                                            </Border.StrokeShape>
                                            <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                                <Label Text="{Binding Category, Converter={StaticResource ServiceCategoryToIconConverter}}" FontSize="12" VerticalOptions="Center"/>
                                                <Label Text="{Binding Category, Converter={StaticResource ServiceCategoryToTextConverter}}" 
                                                       FontSize="11" 
                                                       TextColor="#FF6F00" 
                                                       FontAttributes="Bold"
                                                       VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                        </Border>
                                    </Grid>

                                    <!-- Description -->
                                    <Label Grid.Row="1" 
                                           Text="{Binding Description}" 
                                           TextColor="{StaticResource TextSecondary}" 
                                           LineBreakMode="WordWrap" 
                                           MaxLines="3" 
                                           FontSize="13" />

                                    <!-- Customer Info -->
                                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <ffimageloading:CachedImage Grid.Column="0" 
                                                                    Source="{Binding CustomerPhotoUrl}" 
                                                                    Aspect="AspectFill" 
                                                                    HeightRequest="36" 
                                                                    WidthRequest="36" 
                                                                    LoadingPlaceholder="person_icon.svg" 
                                                                    ErrorPlaceholder="person_icon.svg" 
                                                                    VerticalOptions="Center">
                                            <ffimageloading:CachedImage.Clip>
                                                <EllipseGeometry Center="18,18" RadiusX="18" RadiusY="18" />
                                            </ffimageloading:CachedImage.Clip>
                                        </ffimageloading:CachedImage>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                            <Label Text="{Binding CustomerName}" 
                                                   FontAttributes="Bold" 
                                                   FontSize="13" 
                                                   TextColor="{StaticResource TextPrimary}" 
                                                   LineBreakMode="TailTruncation" />
                                            <HorizontalStackLayout Spacing="5">
                                                <Label Text="📍" FontSize="11" VerticalOptions="Center"/>
                                                <Label Text="{Binding Location}" 
                                                       FontSize="11" 
                                                       TextColor="{StaticResource TextSecondary}" 
                                                       VerticalOptions="Center" />
                                                <Label Text="•" FontSize="11" TextColor="{StaticResource TextSecondary}"/>
                                                <Label Text="{Binding CreatedAt, Converter={StaticResource DateTimeToTimeAgoConverter}}" 
                                                       FontSize="11" 
                                                       TextColor="{StaticResource TextSecondary}" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <BoxView Grid.Row="3" HeightRequest="1" Color="{StaticResource BorderColor}" />

                                    <!-- Budget & Actions -->
                                    <Grid Grid.Row="4" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                                            <Label Text="{Binding BudgetText}" 
                                                   FontAttributes="Bold" 
                                                   FontSize="16" 
                                                   TextColor="#FF6F00" />
                                            <HorizontalStackLayout Spacing="3">
                                                <Label Text="📅" FontSize="11" TextColor="#FF6F00"/>
                                                <Label Text="{Binding PreferredDate, StringFormat='{0:dd MMM yyyy}'}" FontSize="11" TextColor="#FF6F00" FontAttributes="Bold"/>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                        <HorizontalStackLayout Grid.Column="1" 
                                                               Spacing="8" 
                                                               HorizontalOptions="End" 
                                                               VerticalOptions="Center">
                                            <Button Text="Teklif Ver" 
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomerRequestsListViewModel}}, Path=ViewRequestDetailsCommand}" 
                                                    CommandParameter="{Binding .}" 
                                                    BackgroundColor="#FF6F00" 
                                                    Padding="16,0" 
                                                    TextColor="White" 
                                                    CornerRadius="10" 
                                                    HeightRequest="38" 
                                                    FontSize="13" 
                                                    FontAttributes="Bold">
                                                <Button.Shadow>
                                                    <Shadow Brush="#FF6F00" Offset="0,2" Radius="6" Opacity="0.3"/>
                                                </Button.Shadow>
                                            </Button>
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- 🎯 CUSTOMER REQUEST FORM OVERLAY -->
        <Grid Grid.RowSpan="2"
              IsVisible="{Binding IsCustomerRequestFormVisible}"
              BackgroundColor="#80000000"
              ZIndex="999"
              InputTransparent="False">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseCustomerRequestFormCommand}" />
            </Grid.GestureRecognizers>

            <Border BackgroundColor="White" 
                    VerticalOptions="End"
                    StrokeShape="RoundRectangle 24,24,0,0" 
                    MaximumHeightRequest="700"
                    ZIndex="1000"
                    InputTransparent="False">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                </Border.GestureRecognizers>
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,-4" Radius="20" Opacity="0.2"/>
                </Border.Shadow>

                <ScrollView>
                    <VerticalStackLayout Spacing="20" Padding="24,30,24,20">
                        <!-- Header -->
                        <Grid>
                            <Label Text="🔍 Hizmet Talebi Oluştur" 
                                   FontSize="20" 
                                   FontAttributes="Bold" 
                                   HorizontalOptions="Center" 
                                   TextColor="{StaticResource TextPrimary}"/>
                            <Border StrokeShape="RoundRectangle 20"
                                    BackgroundColor="{StaticResource Background}"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    HorizontalOptions="End"
                                    StrokeThickness="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CloseCustomerRequestFormCommand}"/>
                                </Border.GestureRecognizers>
                                <Label Text="✕" 
                                       TextColor="{StaticResource TextSecondary}"
                                       FontSize="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" />

                        <!-- Request Title -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Talep Başlığı" 
                                   FontSize="14" 
                                   FontAttributes="Bold" 
                                   TextColor="{StaticResource TextPrimary}"/>
                            <Border StrokeShape="RoundRectangle 12" 
                                    StrokeThickness="1" 
                                    Stroke="{StaticResource BorderColor}" 
                                    Padding="12,8">
                                <Entry Placeholder="Örn: Evim için elektrik tamiri lazım" 
                                       Text="{Binding CustomerRequestTitle}" 
                                       FontSize="15" 
                                       TextColor="{StaticResource TextPrimary}"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Request Description -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Açıklama" 
                                   FontSize="14" 
                                   FontAttributes="Bold" 
                                   TextColor="{StaticResource TextPrimary}"/>
                            <Border StrokeShape="RoundRectangle 12" 
                                    StrokeThickness="1" 
                                    Stroke="{StaticResource BorderColor}" 
                                    Padding="12,8">
                                <Editor Placeholder="Hangi hizmeti arıyorsunuz? Detaylı açıklayın..." 
                                        Text="{Binding CustomerRequestDescription}" 
                                        FontSize="15" 
                                        TextColor="{StaticResource TextPrimary}" 
                                        AutoSize="TextChanges" 
                                        MinimumHeightRequest="100" 
                                        MaximumHeightRequest="150"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Category -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Kategori" 
                                   FontSize="14" 
                                   FontAttributes="Bold" 
                                   TextColor="{StaticResource TextPrimary}"/>
                            <Border StrokeShape="RoundRectangle 12" 
                                    StrokeThickness="1" 
                                    Stroke="{StaticResource BorderColor}" 
                                    Padding="12,0">
                                <Picker Title="Kategori Seçin" 
                                        ItemsSource="{Binding Categories}" 
                                        SelectedItem="{Binding CustomerRequestCategory}" 
                                        FontSize="15" 
                                        TextColor="{StaticResource TextPrimary}">
                                    <Picker.ItemDisplayBinding>
                                        <Binding Converter="{StaticResource ServiceCategoryToTextConverter}" />
                                    </Picker.ItemDisplayBinding>
                                </Picker>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Location -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Konum" 
                                   FontSize="14" 
                                   FontAttributes="Bold" 
                                   TextColor="{StaticResource TextPrimary}"/>
                            <Border StrokeShape="RoundRectangle 12" 
                                    StrokeThickness="1" 
                                    Stroke="{StaticResource BorderColor}" 
                                    Padding="12,8">
                                <Entry Placeholder="Örn: Bartın, Merkez" 
                                       Text="{Binding CustomerRequestLocation}" 
                                       FontSize="15" 
                                       TextColor="{StaticResource TextPrimary}"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Budget Range -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Bütçe Aralığı (₺)" 
                                   FontSize="14" 
                                   FontAttributes="Bold" 
                                   TextColor="{StaticResource TextPrimary}"/>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Border Grid.Column="0"
                                        StrokeShape="RoundRectangle 12" 
                                        StrokeThickness="1" 
                                        Stroke="{StaticResource BorderColor}" 
                                        Padding="12,8">
                                    <Entry Placeholder="Min" 
                                           Text="{Binding CustomerRequestBudgetMin}" 
                                           Keyboard="Numeric"
                                           FontSize="15" 
                                           TextColor="{StaticResource TextPrimary}"/>
                                </Border>
                                <Border Grid.Column="1"
                                        StrokeShape="RoundRectangle 12" 
                                        StrokeThickness="1" 
                                        Stroke="{StaticResource BorderColor}" 
                                        Padding="12,8">
                                    <Entry Placeholder="Max" 
                                           Text="{Binding CustomerRequestBudgetMax}" 
                                           Keyboard="Numeric"
                                           FontSize="15" 
                                           TextColor="{StaticResource TextPrimary}"/>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Preferred Date -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Tercih Edilen Tarih" 
                                   FontSize="14" 
                                   FontAttributes="Bold" 
                                   TextColor="{StaticResource TextPrimary}"/>
                            <Border StrokeShape="RoundRectangle 12" 
                                    StrokeThickness="1" 
                                    Stroke="{StaticResource BorderColor}" 
                                    Padding="12,8">
                                <DatePicker Date="{Binding CustomerRequestPreferredDate}"
                                            MinimumDate="{Binding Source={x:Static sys:DateTime.Now}}"
                                            FontSize="15" 
                                            TextColor="{StaticResource TextPrimary}"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Submit Button -->
                        <Button Text="Talep Oluştur" 
                                Command="{Binding CreateCustomerRequestCommand}" 
                                IsEnabled="{Binding IsPosting, Converter={StaticResource InvertedBoolConverter}}" 
                                BackgroundColor="#FF6F00" 
                                TextColor="White" 
                                FontAttributes="Bold" 
                                FontSize="16" 
                                CornerRadius="12" 
                                HeightRequest="50" 
                                Margin="0,10,0,10">
                            <Button.Shadow>
                                <Shadow Brush="#FF6F00" Offset="0,4" Radius="8" Opacity="0.3"/>
                            </Button.Shadow>
                        </Button>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

        <!-- FAB: Talep Oluştur -->
        <Border Grid.Row="1"
                StrokeShape="RoundRectangle 32"
                BackgroundColor="#FF6F00"
                WidthRequest="64"
                HeightRequest="64"
                StrokeThickness="0"
                VerticalOptions="End"
                HorizontalOptions="End"
                Margin="20"
                IsVisible="{Binding IsCustomerRequestFormVisible, Converter={StaticResource InvertedBoolConverter}}">
            <Border.Shadow>
                <Shadow Brush="#FF6F00" Offset="0,8" Opacity="0.4" Radius="15"/>
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenCustomerRequestFormCommand}"/>
            </Border.GestureRecognizers>
            <VerticalStackLayout Spacing="2" 
                                 HorizontalOptions="Center" 
                                 VerticalOptions="Center">
                <Label Text="➕" 
                       FontSize="24" 
                       TextColor="White" 
                       HorizontalOptions="Center"/>
                <Label Text="Talep" 
                       FontSize="9" 
                       TextColor="White" 
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Border>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="2"
              IsVisible="{Binding IsLoading}"
              BackgroundColor="{StaticResource Background}"
              ZIndex="1100"
              InputTransparent="False">
            <Border BackgroundColor="White"
                    WidthRequest="100"
                    HeightRequest="100"
                    StrokeThickness="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.15" Radius="15" Offset="0,8"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                    <ActivityIndicator IsRunning="True"
                                       Color="#FF6F00"
                                       WidthRequest="40"
                                       HeightRequest="40" />
                    <Label Text="Yükleniyor..."
                           TextColor="#FF6F00"
                           FontSize="13" />
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>

</ContentPage>
