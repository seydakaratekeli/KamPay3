<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:KamPay.Models"
             xmlns:res="clr-namespace:KamPay.Services"
             xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
             x:Class="KamPay.Views.ChatPage"
             Title="">
 
    <!-- gerçek zamanlı presence (WebSocket/RTDB presence) bunu bi araştır— şu anda basit LastLoginAt kontrollü bir tahmin kullanılıyor. -->

    <Grid RowDefinitions="Auto,*,Auto">
        
        <!-- 🔥 ÖZEL HEADER (Profil Fotoğrafı + İsim + Son Görülme) -->
        <Grid Grid.Row="0" 
              BackgroundColor="{StaticResource Primary}"
              Padding="15,10"
              ColumnDefinitions="Auto,Auto,*,Auto"
              ColumnSpacing="10">
            
            <!-- Geri Butonu -->
            <ImageButton Grid.Column="0"
                         Source="back_icon.svg"
                         Command="{Binding GoBackCommand}"
                         WidthRequest="30"
                         HeightRequest="30"
                         VerticalOptions="Center"
                         BackgroundColor="Transparent"
                         Aspect="AspectFit"/>
            
            <!-- Profil Fotoğrafı -->
            <Border Grid.Column="1" 
                    StrokeThickness="2"
                    Stroke="White"
                    WidthRequest="45"
                    HeightRequest="45"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22.5"/>
                </Border.StrokeShape>
                <ffimageloading:CachedImage 
                    Source="{Binding OtherUserPhoto}"
                    Aspect="AspectFill"
                    LoadingPlaceholder="default_avatar.png"
                    ErrorPlaceholder="default_avatar.png"
                    DownsampleToViewSize="True"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"/>
            </Border>
            
            <!-- İsim ve Son Görülme Durumu -->
            <VerticalStackLayout Grid.Column="2" 
                                 VerticalOptions="Center"
                                 Spacing="2">
                <Label Text="{Binding OtherUserName}"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="White"
                       LineBreakMode="TailTruncation"
                       MaxLines="1"/>

                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <!-- Online Dot -->
                    <Border WidthRequest="10" HeightRequest="10" BackgroundColor="#4CAF50" StrokeThickness="0" IsVisible="{Binding IsOtherUserOnline}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="5"/>
                        </Border.StrokeShape>
                    </Border>

                    <Label Text="{Binding OnlineStatusText}"
                           FontSize="12"
                           TextColor="#E8F5E9"
                           Opacity="0.95"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>
            
            <!-- Menü Butonu (Opsiyonel) -->
            <ImageButton Grid.Column="3"
                         Source="more_vert.svg"
                         WidthRequest="30"
                         HeightRequest="30"
                         VerticalOptions="Center"
                         BackgroundColor="Transparent"
                         Aspect="AspectFit"/>
        </Grid>

        <!-- 🔥 Mesaj Listesi (Pull-to-Refresh ile) -->
        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshMessagesCommand}"
                     IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">

            <CollectionView x:Name="MessagesCollectionView"
                            ItemsSource="{Binding Messages}"
                            ItemsLayout="VerticalList"
                            VerticalScrollBarVisibility="Never"
                            SelectionMode="None"
                            ItemsUpdatingScrollMode="KeepLastItemInView">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Message">
                        <Grid Padding="10,5">
                            
                            <!-- 🔥 System Mesajı Template -->
                            <Frame Padding="15,10"
                                   CornerRadius="10"
                                   BorderColor="Transparent"
                                   BackgroundColor="#FFF9C4"
                                   HasShadow="False"
                                   HorizontalOptions="Center"
                                   MaximumWidthRequest="320"
                                   IsVisible="{Binding Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=System}">
                                <Label Text="{Binding Content}"
                                       LineBreakMode="WordWrap"
                                       TextColor="#F57C00"
                                       FontSize="13"
                                       HorizontalTextAlignment="Center"
                                       FontAttributes="Bold"/>
                            </Frame>
                            
                            <!-- 🔥 Normal Mesajlar (Text ve Image) -->
                            <Frame Padding="12"
                                   CornerRadius="15"
                                   BorderColor="Transparent"
                                   HasShadow="False"
                                   MaximumWidthRequest="280"
                                   IsVisible="{Binding Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='System,Invert=True'}">
                                <Frame.Style>
                                    <Style TargetType="Frame">
                                        <Setter Property="HorizontalOptions" Value="Start" />
                                        <Setter Property="BackgroundColor" Value="#E0E0E0" />
                                        <Style.Triggers>
                                            <DataTrigger TargetType="Frame"
                                                         Binding="{Binding IsSentByMe}"
                                                         Value="True">
                                                <Setter Property="HorizontalOptions" Value="End" />
                                                <Setter Property="BackgroundColor"
                                                        Value="{StaticResource Primary}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Frame.Style>

                                <VerticalStackLayout Spacing="5">
                                    <!-- 📷 Fotoğraf Mesajı -->
                                    <Grid IsVisible="{Binding Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Image}">
                                        <Border StrokeThickness="0"
                                                StrokeShape="RoundRectangle 10"
                                                MaximumWidthRequest="250"
                                                MaximumHeightRequest="200">
                                            <Image Source="{Binding ImageUrl}"
                                                   Aspect="AspectFill"
                                                   WidthRequest="250"
                                                   HeightRequest="200">
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ViewImageCommand}"
                                                                          CommandParameter="{Binding ImageUrl}" />
                                                </Image.GestureRecognizers>
                                            </Image>
                                        </Border>
                                        <!-- Loading Indicator for Image -->
                                        <ActivityIndicator IsRunning="{Binding IsImageLoading}"
                                                           IsVisible="{Binding IsImageLoading}"
                                                           Color="White"
                                                           VerticalOptions="Center"
                                                           HorizontalOptions="Center" />
                                    </Grid>

                                    <!-- 💬 Text Mesajı -->
                                    <Label Text="{Binding Content}"
                                           LineBreakMode="WordWrap"
                                           IsVisible="{Binding Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Text}">
                                        <Label.Style>
                                            <Style TargetType="Label">
                                                <Setter Property="TextColor" Value="Black" />
                                                <Style.Triggers>
                                                    <DataTrigger TargetType="Label"
                                                                 Binding="{Binding IsSentByMe}"
                                                                 Value="True">
                                                        <Setter Property="TextColor" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Label.Style>
                                    </Label>

                                    <!-- Zaman ve Durum -->
                                    <HorizontalStackLayout Spacing="5" HorizontalOptions="End">
                                        <Label Text="{Binding TimeText}"
                                               FontSize="10">
                                            <Label.Style>
                                                <Style TargetType="Label">
                                                    <Setter Property="TextColor" Value="{StaticResource Gray}" />
                                                    <Style.Triggers>
                                                        <DataTrigger TargetType="Label"
                                                                     Binding="{Binding IsSentByMe}"
                                                                     Value="True">
                                                            <Setter Property="TextColor" Value="#B2DFDB" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Label.Style>
                                        </Label>

                                        <!-- Gönderim durumu (sadece kendi mesajlarında) -->
                                        <Label FontSize="12"
                                               IsVisible="{Binding IsSentByMe}"
                                               TextColor="#B2DFDB">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" 
                                                            Binding="{Binding IsDelivered}" 
                                                            Value="False">
                                                    <Setter Property="Text" Value="⏱" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" 
                                                            Binding="{Binding IsDelivered}" 
                                                            Value="True">
                                                    <Setter Property="Text" Value="✓✓" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Frame>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <!-- 🔥 Boş görünüm -->
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="40"
                                         VerticalOptions="Center"
                                         HorizontalOptions="Center">
                        <Label Text="💬"
                               FontSize="60"
                               HorizontalTextAlignment="Center"
                               Opacity="0.3" />
                        <Label Text="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[NoMessageYet]}"
                               FontSize="16"
                               TextColor="#757575"
                               HorizontalTextAlignment="Center"
                               Margin="0,10,0,0" />
                        <Label Text="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[SendFirstMessage]}"
                               FontSize="12"
                               TextColor="#BDBDBD"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>

        <!-- Mesaj Gönderme Alanı -->
        <Frame Grid.Row="2"
               Padding="10"
               CornerRadius="0"
               BorderColor="#E0E0E0"
               BackgroundColor="White"
               HasShadow="True">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="10"
                  RowDefinitions="Auto">
                
                <!-- 📷 Fotoğraf Butonu -->
                <Button Grid.Column="0"
                        Text="📷"
                        Command="{Binding PickImageCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Primary}"
                        BorderWidth="0"
                        WidthRequest="45"
                        HeightRequest="45"
                        FontSize="24"
                        Padding="0"
                        VerticalOptions="Center" />
                
                <!-- Mesaj Entry -->
                <Frame Grid.Column="1"
                       Padding="12,8"
                       CornerRadius="20"
                       BorderColor="#E0E0E0"
                       BackgroundColor="#F5F5F5"
                       HasShadow="False"
                       VerticalOptions="Center">
                    <Entry Placeholder="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[TypeMessage]}"
                           Text="{Binding MessageText}"
                           ReturnCommand="{Binding SendMessageCommand}"
                           MaxLength="1000"
                           VerticalOptions="Center"
                           BackgroundColor="Transparent" />
                </Frame>

                <!-- Gönder Butonu -->
                <Button Grid.Column="2"
                        Text="📤"
                        Command="{Binding SendMessageCommand}"
                        IsEnabled="{Binding IsSending, Converter={StaticResource InvertedBoolConverter}}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        CornerRadius="25"
                        WidthRequest="50"
                        HeightRequest="50"
                        Padding="0"
                        FontSize="20"
                        VerticalOptions="Center" />
            </Grid>
        </Frame>

        <!-- 🔥 Skeleton Loader (İlk Yükleme) -->
        <Grid Grid.RowSpan="3"
              IsVisible="{Binding IsLoading}"
              BackgroundColor="White"
              InputTransparent="False">

            <VerticalStackLayout Padding="15" Spacing="10" Margin="0,60,0,0">
                <!-- Skeleton Message 1 (Alıcı) -->
                <HorizontalStackLayout Spacing="10" HorizontalOptions="Start">
                    <Frame Padding="12" 
                           CornerRadius="15" 
                           BackgroundColor="#E0E0E0"
                           BorderColor="Transparent"
                           MaximumWidthRequest="250">
                        <VerticalStackLayout Spacing="5">
                            <BoxView HeightRequest="14" WidthRequest="180" BackgroundColor="#D0D0D0" CornerRadius="3"/>
                            <BoxView HeightRequest="14" WidthRequest="150" BackgroundColor="#D0D0D0" CornerRadius="3"/>
                            <BoxView HeightRequest="10" WidthRequest="50" BackgroundColor="#C0C0C0" CornerRadius="2" HorizontalOptions="End"/>
                        </VerticalStackLayout>
                    </Frame>
                </HorizontalStackLayout>

                <!-- Skeleton Message 2 (Gönderici) -->
                <HorizontalStackLayout Spacing="10" HorizontalOptions="End">
                    <Frame Padding="12" 
                           CornerRadius="15" 
                           BackgroundColor="#B2DFDB"
                           BorderColor="Transparent"
                           MaximumWidthRequest="250">
                        <VerticalStackLayout Spacing="5">
                            <BoxView HeightRequest="14" WidthRequest="200" BackgroundColor="#A0CFC9" CornerRadius="3"/>
                            <BoxView HeightRequest="10" WidthRequest="50" BackgroundColor="#90BFB9" CornerRadius="2" HorizontalOptions="End"/>
                        </VerticalStackLayout>
                    </Frame>
                </HorizontalStackLayout>

                <!-- Skeleton Message 3 (Alıcı) -->
                <HorizontalStackLayout Spacing="10" HorizontalOptions="Start">
                    <Frame Padding="12" 
                           CornerRadius="15" 
                           BackgroundColor="#E0E0E0"
                           BorderColor="Transparent"
                           MaximumWidthRequest="250">
                        <VerticalStackLayout Spacing="5">
                            <BoxView HeightRequest="14" WidthRequest="120" BackgroundColor="#D0D0D0" CornerRadius="3"/>
                            <BoxView HeightRequest="10" WidthRequest="50" BackgroundColor="#C0C0C0" CornerRadius="2" HorizontalOptions="End"/>
                        </VerticalStackLayout>
                    </Frame>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Loading Overlay -->
            <VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="10">
                <ActivityIndicator IsRunning="True"
                                   Color="{StaticResource Primary}"
                                   WidthRequest="40"
                                   HeightRequest="40" />
                <Label Text="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[MessagesLoading]}"
                       TextColor="{StaticResource Primary}"
                       FontSize="12"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>