<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KamPay.ViewModels"
             x:Class="KamPay.Views.PaymentPage"
             Title="{Binding Source={RelativeSource Self}, Path=BindingContext.PageTitle}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Frame BackgroundColor="{StaticResource Gray100}" BorderColor="Transparent" CornerRadius="10">
                <HorizontalStackLayout Spacing="15">
                    <Frame Padding="0" CornerRadius="5" IsClippedToBounds="True" HeightRequest="70" WidthRequest="70">
                        <Image Source="{Binding Transaction.ProductThumbnailUrl}" Aspect="AspectFill" />
                    </Frame>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="{Binding Transaction.ProductTitle}" FontAttributes="Bold" FontSize="18" />
                        <Label Text="{Binding Transaction.Price, StringFormat='{0:N2} ₺'}" TextColor="{StaticResource Primary}" FontSize="16" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Frame>

            <Label Text="Ödeme Yöntemi Seçin" FontAttributes="Bold" Margin="0,10,0,0"/>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0" Text="Kredi Kartı" 
                        Command="{Binding StartPaymentCommand}" CommandParameter="cardsim"
                        BackgroundColor="{StaticResource Primary}" CornerRadius="10"/>
                <Button Grid.Column="1" Text="EFT / Havale" 
                        Command="{Binding StartPaymentCommand}" CommandParameter="banktransfersim"
                        BackgroundColor="{StaticResource Secondary}" CornerRadius="10"/>
            </Grid>

            <VerticalStackLayout IsVisible="{Binding IsCardSelected}" Spacing="10" Margin="0,20,0,0">
                <Label Text="Doğrulama Kodunu Giriniz" HorizontalOptions="Center" FontAttributes="Italic"/>
                <Frame BorderColor="{StaticResource Primary}" Padding="5" CornerRadius="10">
                    <Entry Text="{Binding OtpCode}" Keyboard="Numeric" MaxLength="6" 
                           Placeholder="123456" HorizontalTextAlignment="Center" FontSize="28" 
                           TextColor="{StaticResource Primary}" BackgroundColor="Transparent"/>
                </Frame>
                <Button Text="Ödemeyi Onayla" Command="{Binding ConfirmCardPaymentCommand}" 
                        BackgroundColor="Green" CornerRadius="10" HeightRequest="50"/>
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding IsEftSelected}" Spacing="15" Margin="0,10,0,0">
                <Label Text="Ödeme Açıklamasına Yazılacak Kod:" HorizontalOptions="Center"/>
                <Frame BackgroundColor="{StaticResource Gray200}" BorderColor="Transparent">
                    <Label Text="{Binding PaymentDetails.BankReference}" FontAttributes="Bold" 
                           FontSize="22" HorizontalOptions="Center" TextColor="Black"/>
                </Frame>
                <Label Text="* Kod hatalı girilirse ödeme onaylanmayabilir." FontSize="12" TextColor="Red" HorizontalOptions="Center"/>
                <Button Text="Ödemeyi Tamamladım" Command="{Binding ConfirmCardPaymentCommand}" 
                        BackgroundColor="Green" CornerRadius="10" />
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsLoading}" HorizontalOptions="Center" Color="{StaticResource Primary}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>