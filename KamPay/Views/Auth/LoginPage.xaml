<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:extensions="clr-namespace:KamPay.Extensions"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KamPay.ViewModels"
             xmlns:services="clr-namespace:KamPay.Services"
             xmlns:helpers="clr-namespace:KamPay.Helpers"
             x:DataType="{x:Null}"
             x:Class="KamPay.Views.LoginPage"
             Shell.NavBarIsVisible="False">

    <Grid>
        <!-- Gradient Background -->
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource Primary}" Offset="0.0" />
                    <GradientStop Color="{StaticResource PrimaryDark}" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- Animated Background Circles -->
        <Grid Opacity="0.1">
            <Ellipse x:Name="Circle1" 
                     WidthRequest="300" 
                     HeightRequest="300"
                     Fill="White"
                     HorizontalOptions="Start"
                     VerticalOptions="Start"
                     Margin="-150,-150,0,0"/>
            
            <Ellipse x:Name="Circle2" 
                     WidthRequest="200" 
                     HeightRequest="200"
                     Fill="White"
                     HorizontalOptions="End"
                     VerticalOptions="End"
                     Margin="0,0,-100,-100"/>
        </Grid>

        <!-- Main Content -->
        <ScrollView>
            <VerticalStackLayout Spacing="0" Padding="30" VerticalOptions="Center">

                <!-- Logo & Title Section -->
                <VerticalStackLayout x:Name="LogoSection" Spacing="15" Margin="0,0,0,50">
                    <!-- Logo Icon with Shadow -->
                    <Border WidthRequest="140"
                            HeightRequest="140"
                            BackgroundColor="White"
                            HorizontalOptions="Center" >
                            
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="30"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" 
                                    Opacity="0.2" 
                                    Radius="15" 
                                    Offset="0,6"/>
                        </Border.Shadow>

                        <Image Source="kampay_logo_new.png"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>

                    <!-- App Title -->
                    <Label Text="KamPay" 
                           FontSize="36"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"
                           Margin="0,8,0,0"/>

                    <!-- Welcome Text -->
                    <Label Text="{extensions:Translate WelcomeBack}" 
                           FontSize="16"
                           TextColor="White"
                           Opacity="0.9"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Login Form Card -->
                <Border x:Name="LoginFormCard" 
                        BackgroundColor="White" 
                        StrokeThickness="0"
                        Padding="24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" 
                                Opacity="0.15" 
                                Radius="20" 
                                Offset="0,8"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">
                        
                        <!-- Email Input -->
                        <Border BackgroundColor="{StaticResource Background}" 
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Grid Padding="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <Label Text="{x:Static helpers:MaterialIconConstants.Email}" 
                                       FontFamily="MaterialIcons"
                                       FontSize="20" 
                                       VerticalOptions="Center"
                                       Margin="0,0,12,0"/>
                                
                                <Entry Grid.Column="1"
                                       Placeholder="{extensions:Translate Email}"
                                       Text="{Binding Email}"
                                       Keyboard="Email"
                                       TextColor="{StaticResource TextPrimary}"
                                       PlaceholderColor="{StaticResource TextHint}"
                                       BackgroundColor="Transparent"
                                       FontSize="16"
                                       HeightRequest="48"/>
                            </Grid>
                        </Border>

                        <!-- Password Input -->
                        <Border BackgroundColor="{StaticResource Background}" 
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Grid Padding="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <Label Text="{x:Static helpers:MaterialIconConstants.Lock}" 
                                       FontFamily="MaterialIcons"
                                       FontSize="20" 
                                       VerticalOptions="Center"
                                       Margin="0,0,12,0"/>
                                
                                <Entry Grid.Column="1"
                                       Placeholder="{extensions:Translate Password}"
                                       Text="{Binding Password}"
                                       IsPassword="True"
                                       TextColor="{StaticResource TextPrimary}"
                                       PlaceholderColor="{StaticResource TextHint}"
                                       BackgroundColor="Transparent"
                                       FontSize="16"
                                       HeightRequest="48"/>
                            </Grid>
                        </Border>

                        <!-- Remember Me -->
                        <HorizontalStackLayout Spacing="8" Margin="4,0">
                            <CheckBox IsChecked="{Binding RememberMe}" 
                                      Color="{StaticResource Primary}"/>
                            <Label Text="{extensions:Translate RememberMe}"
                                   TextColor="{StaticResource TextSecondary}"
                                   FontSize="14"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <!-- Şifremi Unuttum Link -->
                        <Label Text="Şifremi Unuttum"
                               TextColor="{StaticResource Primary}"
                               FontSize="13"
                               FontAttributes="Bold"
                               HorizontalOptions="End"
                               Margin="4,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ForgotPasswordCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>

                        <!-- Error Message -->
                        <Border IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                                BackgroundColor="#FFEBEE"
                                StrokeThickness="0"
                                Padding="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Label Text="{Binding ErrorMessage}"
                                   TextColor="#EF5350"
                                   FontSize="13"
                                   FontAttributes="Bold"/>
                        </Border>

                        <!-- Login Button -->
                        <Button Text="{extensions:Translate Login}"
                                Command="{Binding LoginCommand}"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="16"
                                CornerRadius="28"
                                HeightRequest="56"
                                Margin="0,8,0,0">
                            <Button.Shadow>
                                <Shadow Brush="{StaticResource Primary}" 
                                        Opacity="0.3" 
                                        Radius="10" 
                                        Offset="0,4"/>
                            </Button.Shadow>
                        </Button>

                        <!-- Divider -->
                        <BoxView HeightRequest="1" 
                                 Color="{StaticResource Divider}" 
                                 Margin="0,16"/>

                        <!-- Register Link -->
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label Text="{extensions:Translate DontHaveAccount}"
                                   TextColor="{StaticResource TextSecondary}"
                                   FontSize="14"/>
                            <Label Text="{extensions:Translate Register}"
                                   TextColor="{StaticResource Primary}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextDecorations="Underline">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoToRegisterCommand}"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- Footer -->
                <Label Text="KamPay © 2025" 
                       TextColor="White"
                       FontSize="12"
                       Opacity="0.7"
                       HorizontalOptions="Center"
                       Margin="0,30,0,0"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading Overlay -->
        <Grid IsVisible="{Binding IsLoading}" 
              BackgroundColor="#80000000"
              ZIndex="999">
            <Border BackgroundColor="White"
                    WidthRequest="120"
                    HeightRequest="120"
                    StrokeThickness="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" 
                            Opacity="0.2" 
                            Radius="20" 
                            Offset="0,10"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="12" 
                                     HorizontalOptions="Center" 
                                     VerticalOptions="Center">
                    <ActivityIndicator IsRunning="True" 
                                       Color="{StaticResource Primary}"
                                       WidthRequest="40"
                                       HeightRequest="40"/>
                    <Label Text="Yükleniyor..." 
                           TextColor="{StaticResource Primary}"
                           FontSize="12"
                           FontAttributes="Bold"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>

