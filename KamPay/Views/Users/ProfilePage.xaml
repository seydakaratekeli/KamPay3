<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KamPay.ViewModels"
             xmlns:models="clr-namespace:KamPay.Models"
             xmlns:converters="clr-namespace:KamPay.Converters"
             xmlns:res="clr-namespace:KamPay.Services"
             xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
             x:Class="KamPay.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F5F9FC">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#1E88E5</Color>
            <Color x:Key="PrimaryDark">#1565C0</Color>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
            <converters:FirstCharConverter x:Key="FirstCharConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <Grid Grid.Row="0" x:Name="HeaderSection">
            <BoxView HeightRequest="220">
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1E88E5" Offset="0.0" />
                        <GradientStop Color="#1565C0" Offset="1.0" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

            <Ellipse x:Name="Circle1" 
                     WidthRequest="200" HeightRequest="200"
                     Fill="White" Opacity="0.05"
                     HorizontalOptions="End" VerticalOptions="Start"
                     Margin="0,-80,-80,0"/>

            <Grid Padding="20,50,20,30" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                <Grid Grid.Row="0" HorizontalOptions="Center" x:Name="ProfileImageSection">
                    <Border StrokeThickness="4" Stroke="White" WidthRequest="120" HeightRequest="120">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="60"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.2"/>
                        </Border.Shadow>
                        <Grid>
                            <ffimageloading:CachedImage 
                                Source="{Binding CurrentUser.ProfileImageUrl}" 
                                Aspect="AspectFill"
                                IsVisible="{Binding HasProfileImage}">
                                <ffimageloading:CachedImage.Clip>
                                    <EllipseGeometry Center="60,60" RadiusX="60" RadiusY="60"/>
                                </ffimageloading:CachedImage.Clip>
                            </ffimageloading:CachedImage>
                            <Label Text="{Binding CurrentUser.FullName, Converter={StaticResource FirstCharConverter}}" 
                                   FontSize="45" FontAttributes="Bold" TextColor="{StaticResource Primary}" 
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                                   IsVisible="{Binding HasProfileImage, Converter={StaticResource InvertedBoolConverter}}" />
                        </Grid>
                    </Border>
                    <Border StrokeShape="RoundRectangle 20" BackgroundColor="White" WidthRequest="40" HeightRequest="40" HorizontalOptions="End" VerticalOptions="End">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToEditProfileCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="✏️" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <Label x:Name="NameLabel" Grid.Row="1" Text="{Binding CurrentUser.FullName}" 
                       FontSize="24" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center"/>
                <Label x:Name="EmailLabel" Grid.Row="2" Text="{Binding CurrentUser.Email}" 
                       FontSize="14" TextColor="White" Opacity="0.8" HorizontalTextAlignment="Center"/>
            </Grid>
        </Grid>

        <ScrollView Grid.Row="1" x:Name="ContentSection">
            <VerticalStackLayout Spacing="15" Padding="20">

                <Grid x:Name="StatsSection" ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Border Grid.Column="0" BackgroundColor="White" Padding="15" StrokeShape="RoundRectangle 12">
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.05" Radius="5" Offset="0,2"/>
                        </Border.Shadow>
                        <VerticalStackLayout HorizontalOptions="Center">
                            <Label Text="{Binding UserStats.TotalProducts}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Primary}" HorizontalTextAlignment="Center"/>
                            <Label Text="Ürün" FontSize="11" TextColor="Gray" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="White" Padding="15" StrokeShape="RoundRectangle 12">
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.05" Radius="5" Offset="0,2"/>
                        </Border.Shadow>
                        <VerticalStackLayout HorizontalOptions="Center">
                            <Label Text="{Binding UserStats.Points}" FontSize="20" FontAttributes="Bold" TextColor="Orange" HorizontalTextAlignment="Center"/>
                            <Label Text="Puan" FontSize="11" TextColor="Gray" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" BackgroundColor="White" Padding="15" StrokeShape="RoundRectangle 12">
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.05" Radius="5" Offset="0,2"/>
                        </Border.Shadow>
                        <VerticalStackLayout HorizontalOptions="Center">
                            <Label Text="{Binding MyBadges.Count}" FontSize="20" FontAttributes="Bold" TextColor="Purple" HorizontalTextAlignment="Center"/>
                            <Label Text="Rozet" FontSize="11" TextColor="Gray" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Label Text="Rozetlerim" FontAttributes="Bold" FontSize="16" Margin="5,0"/>
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <FlexLayout BindableLayout.ItemsSource="{Binding MyBadges}" Direction="Row" Padding="0,5">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:UserBadge">
                                <Border Margin="0,0,10,0" Padding="10" StrokeShape="RoundRectangle 10" BackgroundColor="White">
                                    <Label Text="🏅" FontSize="25"/>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </ScrollView>

                <VerticalStackLayout Spacing="10" Margin="0,5">
                    <Button Text="Profili Düzenle" Command="{Binding GoToEditProfileCommand}" 
                            BackgroundColor="#1E88E5" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="50">
                        <Button.Shadow>
                            <Shadow Brush="#1E88E5" Offset="0,4" Radius="8" Opacity="0.3"/>
                        </Button.Shadow>
                    </Button>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Grid.Column="0" Text="Favorilerim" Command="{Binding GoToFavoritesCommand}" 
                                BackgroundColor="White" BorderColor="{StaticResource Primary}" BorderWidth="1" TextColor="{StaticResource Primary}" CornerRadius="12" HeightRequest="45"/>
                        <Button Grid.Column="1" Text="Bildirimler" Command="{Binding GoToNotificationsCommand}" 
                                BackgroundColor="White" BorderColor="{StaticResource Primary}" BorderWidth="1" TextColor="{StaticResource Primary}" CornerRadius="12" HeightRequest="45"/>
                    </Grid>

                    <Button Text="Tekliflerim" Command="{Binding GoToOffersCommand}" 
                            BackgroundColor="White" BorderColor="{StaticResource Primary}" BorderWidth="1" TextColor="{StaticResource Primary}" CornerRadius="12" HeightRequest="45"/>

                    <Button Text="Hizmet Taleplerim" Command="{Binding GoToServiceRequestsCommand}" 
                            BackgroundColor="White" BorderColor="{StaticResource Primary}" BorderWidth="1" TextColor="{StaticResource Primary}" CornerRadius="12" HeightRequest="45"/>

                    <Button Text="Dil Değiştir" Command="{Binding ChangeLanguageCommand}" 
                            BackgroundColor="White" BorderColor="Purple" BorderWidth="1" TextColor="Purple" CornerRadius="12" HeightRequest="45"/>
                </VerticalStackLayout>

                <Button Text="Çıkış Yap" Command="{Binding LogoutCommand}" 
                        BackgroundColor="#F44336" TextColor="White" CornerRadius="12" HeightRequest="50" Margin="0,10,0,0">
                    <Button.Shadow>
                        <Shadow Brush="#F44336" Offset="0,4" Radius="8" Opacity="0.3"/>
                    </Button.Shadow>
                </Button>

            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.RowSpan="2" IsVisible="{Binding IsLoading}" BackgroundColor="#80000000" ZIndex="1000">
            <ActivityIndicator IsRunning="True" Color="White" HorizontalOptions="Center" VerticalOptions="Center" Scale="1.5"/>
        </Grid>
    </Grid>
</ContentPage>