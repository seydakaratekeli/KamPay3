<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KamPay.ViewModels"
             xmlns:res="clr-namespace:KamPay.Services"
             x:Class="KamPay.Views.MainPage"
             x:DataType="vm:MainViewModel"
             Shell.NavBarIsVisible="False">

    <Grid>
        <!-- Gradient Background -->
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1E88E5" Offset="0.0" />
                    <GradientStop Color="#1565C0" Offset="0.6" />
                    <GradientStop Color="#0D47A1" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- Animated Background Circles -->
        <Grid Opacity="0.05">
            <Ellipse x:Name="Circle1" 
                     WidthRequest="400" 
                     HeightRequest="400"
                     Fill="White"
                     HorizontalOptions="Start"
                     VerticalOptions="Start"
                     Margin="-200,-200,0,0"/>
            
            <Ellipse x:Name="Circle2" 
                     WidthRequest="300" 
                     HeightRequest="300"
                     Fill="White"
                     HorizontalOptions="End"
                     VerticalOptions="End"
                     Margin="0,0,-150,-150"/>
        </Grid>

        <ScrollView>
            <VerticalStackLayout x:Name="MainContent" Spacing="0" Padding="20">

                <!-- Welcome Header -->
                <VerticalStackLayout x:Name="HeaderSection" Spacing="8" Margin="0,40,0,30">
                    <Label Text="👋" FontSize="40" HorizontalOptions="Start"/>
                    <Label Text="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[WelcomeMessage]}"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Start"/>
                    <Label Text="Neler yapmak istersiniz?"
                           FontSize="15"
                           TextColor="White"
                           Opacity="0.9"
                           HorizontalOptions="Start"/>
                </VerticalStackLayout>

                <!-- Quick Actions Grid -->
                <Grid x:Name="QuickActionsGrid" 
                      ColumnDefinitions="*,*" 
                      RowDefinitions="Auto,Auto,Auto"
                      ColumnSpacing="15"
                      RowSpacing="15"
                      Margin="0,0,0,30">
                    
                    <!-- Product List Card -->
                    <Border Grid.Row="0" Grid.Column="0"
                            BackgroundColor="White"
                            StrokeThickness="0"
                            Padding="20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.2" Radius="15" Offset="0,5"/>
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateProductListCommand}"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                            <Label Text="📦" FontSize="48" HorizontalOptions="Center"/>
                            <Label Text="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[ProductList]}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#1E88E5"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Favorites Card -->
                    <Border Grid.Row="0" Grid.Column="1"
                            BackgroundColor="White"
                            StrokeThickness="0"
                            Padding="20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.2" Radius="15" Offset="0,5"/>
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateFavoritesCommand}"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                            <Label Text="❤️" FontSize="48" HorizontalOptions="Center"/>
                            <Label Text="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[Favorites]}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#E91E63"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Messages Card -->
                    <Border Grid.Row="1" Grid.Column="0"
                            BackgroundColor="White"
                            StrokeThickness="0"
                            Padding="20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.2" Radius="15" Offset="0,5"/>
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateMessagesCommand}"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                            <Label Text="💬" FontSize="48" HorizontalOptions="Center"/>
                            <Label Text="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[Messages]}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#00BCD4"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Profile Card -->
                    <Border Grid.Row="1" Grid.Column="1"
                            BackgroundColor="White"
                            StrokeThickness="0"
                            Padding="20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.2" Radius="15" Offset="0,5"/>
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding NavigateProfileCommand}"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                            <Label Text="👤" FontSize="48" HorizontalOptions="Center"/>
                            <Label Text="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[Profile]}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#9C27B0"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Logout Card -->
                    <Border Grid.Row="2" Grid.ColumnSpan="2"
                            BackgroundColor="White"
                            StrokeThickness="2"
                            Stroke="#EF5350"
                            Padding="16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding LogoutCommand}"/>
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                            <Label Text="🚪" FontSize="24" VerticalOptions="Center"/>
                            <Label Text="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[Logout]}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#EF5350"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <!-- Footer -->
                <Label Text="KamPay © 2025"
                       TextColor="White"
                       FontSize="12"
                       Opacity="0.6"
                       HorizontalOptions="Center"
                       Margin="0,20,0,40"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
