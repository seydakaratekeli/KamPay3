<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:extensions="clr-namespace:KamPay.Extensions"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KamPay.ViewModels"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             xmlns:res="clr-namespace:KamPay.Services"
             x:Class="KamPay.Views.QRCodeDisplayPage"
             x:DataType="vm:QRCodeViewModel"
             Title="{Binding PageTitle}"
             BackgroundColor="{StaticResource Background}"
             Shell.BackgroundColor="{StaticResource Primary}"
             Shell.ForegroundColor="White">
    
    <Grid RowDefinitions="Auto,*">
        <!-- Top Gradient Header -->
        <BoxView Grid.Row="0" HeightRequest="200">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{StaticResource Primary}" Offset="0.0" />
                    <GradientStop Color="{StaticResource PrimaryDark}" Offset="0.6" />
                    <GradientStop Color="#0D47A1" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- Animated Background Circles -->
        <Grid Grid.Row="0" Opacity="0.1">
            <Ellipse x:Name="Circle1" 
                     WidthRequest="300" 
                     HeightRequest="300"
                     Fill="White"
                     HorizontalOptions="Start"
                     VerticalOptions="Start"
                     Margin="-150,-150,0,0"/>
            
            <Ellipse x:Name="Circle2" 
                     WidthRequest="200" 
                     HeightRequest="200"
                     Fill="White"
                     HorizontalOptions="End"
                     VerticalOptions="End"
                     Margin="0,0,-100,-100"/>
        </Grid>

        <!-- Main Content -->
        <ScrollView Grid.Row="0" Grid.RowSpan="2" Margin="0,60,0,0">
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- Page Title with Icon -->
                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        Padding="20"
                        StrokeShape="RoundRectangle 20"
                        HorizontalOptions="Center">
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.1" Radius="15" Offset="0,5"/>
                    </Border.Shadow>
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="📱" FontSize="32" VerticalOptions="Center"/>
                        <Label Text="{Binding PageTitle}" 
                               FontSize="22" 
                               FontAttributes="Bold" 
                               TextColor="{StaticResource TextPrimary}"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Instruction Text -->
                <Label Text="{Binding InstructionText}" 
                       HorizontalOptions="Center" 
                       HorizontalTextAlignment="Center" 
                       TextColor="White"
                       FontSize="15"
                       LineHeight="1.4"
                       Margin="0,-10,0,0"/>

                <!-- Timer Display -->
                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        Padding="16"
                        StrokeShape="RoundRectangle 16"
                        IsVisible="{Binding MyDelivery.QRCodeData, Converter={StaticResource IsNotNullOrEmptyConverter}}" 
                        HorizontalOptions="Center">
                    <Border.Shadow>
                        <Shadow Brush="#FF9800" Opacity="0.3" Radius="12" Offset="0,4"/>
                    </Border.Shadow>
                    <HorizontalStackLayout Spacing="12">
                        <Border BackgroundColor="#FFF3E0"
                                WidthRequest="40"
                                HeightRequest="40"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 20">
                            <Label Text="⏱️" FontSize="20" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center"/>
                        </Border>
                        <Label Text="{Binding TimeRemaining}" 
                               FontSize="20" 
                               FontAttributes="Bold"
                               TextColor="#FF6F00"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- PIN Display Card -->
                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        Padding="10"
                        StrokeShape="RoundRectangle 20"
                        IsVisible="{Binding MyDelivery.VerificationPin, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                    <Border.Shadow>
                        <Shadow Brush="#2196F3" Opacity="0.25" Radius="20" Offset="0,8"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Border BackgroundColor="#E3F2FD"
                                StrokeThickness="0"
                                Padding="12,8"
                                StrokeShape="RoundRectangle 12"
                                HorizontalOptions="Center">
                            <Label Text="🔐 PIN KODUNUZ" 
                                   FontSize="14" 
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource PrimaryDark}"/>
                        </Border>
                        
                        <Label Text="{Binding MyDelivery.VerificationPin}" 
                               FontSize="25" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               HorizontalOptions="Center"
                               CharacterSpacing="8"/>
                        
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource Divider}" Margin="20,8"/>
                        
                        <Label Text="Bu kodu karşı tarafa gösterin" 
                               FontSize="13" 
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- QR Codes Display Card -->
                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        Padding="20"
                        StrokeShape="RoundRectangle 20">
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.1" Radius="15" Offset="0,5"/>
                    </Border.Shadow>
                    
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="15" RowSpacing="15">
                        <!-- My Product Section -->
                        <Border Grid.Row="0" Grid.Column="0"
                                BackgroundColor="#E3F2FD"
                                StrokeThickness="0"
                                Padding="8,6"
                                StrokeShape="RoundRectangle 10">
                            <Label Text="{extensions:Translate MyProduct}" 
                                   HorizontalOptions="Center" 
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource PrimaryDark}"
                                   FontSize="13"/>
                        </Border>
                        
                        <Border Grid.Row="1" Grid.Column="0" 
                                StrokeShape="RoundRectangle 16" 
                                Padding="12" 
                                Stroke="{StaticResource Divider}"
                                StrokeThickness="2"
                                BackgroundColor="White">
                            <Border.Shadow>
                                <Shadow Brush="Black" Opacity="0.05" Radius="8" Offset="0,2"/>
                            </Border.Shadow>
                            <Grid>
                                <zxing:BarcodeGeneratorView 
                                    x:Name="barcodeGenerator"
                                    Format="QrCode"  
                                    Value="{Binding MyDelivery.QRCodeData}"
                                    IsVisible="{Binding MyDelivery.IsUsed, Converter={StaticResource InvertedBoolConverter}}"
                                    ForegroundColor="{StaticResource TextPrimary}"
                                    BackgroundColor="White"/>

                                <Border IsVisible="{Binding MyDelivery.IsUsed}"
                                        BackgroundColor="#E8F5E9"
                                        StrokeThickness="0"
                                        Padding="12"
                                        StrokeShape="RoundRectangle 12">
                                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label Text="✅" FontSize="32" HorizontalOptions="Center"/>
                                        <Label Text="{extensions:Translate Delivered}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="#2E7D32"
                                               HorizontalOptions="Center"/>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </Border>

                        <Label Grid.Row="2" Grid.Column="0" 
                               Text="{Binding MyDelivery.ProductTitle}" 
                               HorizontalOptions="Center" 
                               FontSize="12"
                               TextColor="{StaticResource TextSecondary}"
                               LineBreakMode="TailTruncation"
                               MaxLines="2"
                               HorizontalTextAlignment="Center"/>

                        <!-- Other Product Section -->
                        <Border Grid.Row="0" Grid.Column="1"
                                BackgroundColor="#FFF3E0"
                                StrokeThickness="0"
                                Padding="8,6"
                                StrokeShape="RoundRectangle 10">
                            <Label Text="{extensions:Translate OtherProduct}" 
                                   HorizontalOptions="Center" 
                                   FontAttributes="Bold"
                                   TextColor="#F57C00"
                                   FontSize="13"/>
                        </Border>
                        
                        <Border Grid.Row="1" Grid.Column="1" 
                                StrokeShape="RoundRectangle 16"
                                Padding="12"
                                Stroke="{StaticResource Divider}"
                                StrokeThickness="2"
                                BackgroundColor="White">
                            <Border.Shadow>
                                <Shadow Brush="Black" Opacity="0.05" Radius="8" Offset="0,2"/>
                            </Border.Shadow>
                            <Grid>
                                <Border IsVisible="{Binding OtherUserDelivery.IsUsed, Converter={StaticResource InvertedBoolConverter}}"
                                        BackgroundColor="#FFF8E1"
                                        StrokeThickness="0"
                                        Padding="12"
                                        StrokeShape="RoundRectangle 12">
                                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label Text="⏳" FontSize="28" HorizontalOptions="Center"/>
                                        <Label Text="{extensions:Translate WaitingConfirmation}"
                                               FontSize="12"
                                               TextColor="#F57C00"
                                               HorizontalOptions="Center"
                                               HorizontalTextAlignment="Center"/>
                                    </VerticalStackLayout>
                                </Border>

                                <Border IsVisible="{Binding OtherUserDelivery.IsUsed}"
                                        BackgroundColor="#E8F5E9"
                                        StrokeThickness="0"
                                        Padding="12"
                                        StrokeShape="RoundRectangle 12">
                                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label Text="✅" FontSize="32" HorizontalOptions="Center"/>
                                        <Label Text="{extensions:Translate Received}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="#2E7D32"
                                               HorizontalOptions="Center"/>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </Border>
                        
                        <Label Grid.Row="2" Grid.Column="1" 
                               Text="{Binding OtherUserDelivery.ProductTitle}" 
                               HorizontalOptions="Center" 
                               FontSize="12"
                               TextColor="{StaticResource TextSecondary}"
                               LineBreakMode="TailTruncation"
                               MaxLines="2"
                               HorizontalTextAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Delivery Photo Section -->
                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        Padding="20"
                        StrokeShape="RoundRectangle 20"
                        IsVisible="{Binding PhotoRequired}">
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.1" Radius="15" Offset="0,5"/>
                    </Border.Shadow>
                    
                    <VerticalStackLayout Spacing="16">
                        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                            <Label Text="📸" FontSize="24" VerticalOptions="Center"/>
                            <Label Text="Teslimat Fotoğrafı" 
                                   FontSize="18" 
                                   FontAttributes="Bold" 
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        
                        <!-- Photo Display -->
                        <Border IsVisible="{Binding IsPhotoUploaded}" 
                                StrokeShape="RoundRectangle 16" 
                                Padding="0" 
                                Stroke="#2196F3"
                                StrokeThickness="3"
                                HeightRequest="220">
                            <Border.Shadow>
                                <Shadow Brush="#2196F3" Opacity="0.3" Radius="15" Offset="0,6"/>
                            </Border.Shadow>
                            <Image Source="{Binding DeliveryPhotoSource}"
                                   Aspect="AspectFill">
                                <Image.Clip>
                                    <RoundRectangleGeometry CornerRadius="16" Rect="0,0,1000,220"/>
                                </Image.Clip>
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ViewFullPhotoCommand}"/>
                                </Image.GestureRecognizers>
                            </Image>
                        </Border>
                        
                        <!-- Photo Upload Buttons -->
                        <Grid ColumnDefinitions="*,*" 
                              ColumnSpacing="12"
                              IsVisible="{Binding IsPhotoUploaded, Converter={StaticResource InvertedBoolConverter}}">
                            <Button Grid.Column="0"
                                    Text="📷 Çek" 
                                    Command="{Binding TakeDeliveryPhotoCommand}"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="White"
                                    CornerRadius="12"
                                    HeightRequest="50"
                                    FontAttributes="Bold">
                                <Button.Shadow>
                                    <Shadow Brush="{StaticResource Primary}" Opacity="0.3" Radius="8" Offset="0,4"/>
                                </Button.Shadow>
                            </Button>
                            
                            <Button Grid.Column="1"
                                    Text="🖼️ Seç" 
                                    Command="{Binding PickPhotoFromGalleryCommand}"
                                    BackgroundColor="#00ACC1"
                                    TextColor="White"
                                    CornerRadius="12"
                                    HeightRequest="50"
                                    FontAttributes="Bold">
                                <Button.Shadow>
                                    <Shadow Brush="#00ACC1" Opacity="0.3" Radius="8" Offset="0,4"/>
                                </Button.Shadow>
                            </Button>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Action Buttons -->
                <VerticalStackLayout Spacing="12">
                    <!-- Scan QR Button -->
                    <Button Text="{Binding ScanButtonText}" 
                            Command="{Binding ScanQRCodeCommand}" 
                            BackgroundColor="{Binding CanScanOtherQR, Converter={StaticResource BoolToColorConverter}, ConverterParameter='{StaticResource Primary}|{StaticResource TextHint}'}"
                            TextColor="White"
                            CornerRadius="16"
                            HeightRequest="56"
                            FontSize="16"
                            FontAttributes="Bold"
                            IsEnabled="{Binding CanScanOtherQR}"
                            IsVisible="{Binding CanReceive}">
                        <Button.Shadow>
                            <Shadow Brush="{StaticResource Primary}" Opacity="0.4" Radius="12" Offset="0,6"/>
                        </Button.Shadow>
                    </Button>

                    <!-- Extend Time Button -->
                    <Button Text="⏱️ Süreyi Uzat" 
                            Command="{Binding ExtendTimeCommand}"
                            IsVisible="{Binding CanExtendTime}"
                            BackgroundColor="#FF9800"
                            TextColor="White"
                            CornerRadius="16"
                            HeightRequest="50"
                            FontAttributes="Bold">
                        <Button.Shadow>
                            <Shadow Brush="#FF9800" Opacity="0.3" Radius="10" Offset="0,4"/>
                        </Button.Shadow>
                    </Button>

                    <!-- Cancel Delivery Button -->
                    <Border BackgroundColor="White"
                            Stroke="#EF5350"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 16"
                            Padding="0">
                        <Button Text="❌ Teslimatı İptal Et" 
                                Command="{Binding CancelDeliveryCommand}"
                                BackgroundColor="Transparent"
                                TextColor="#EF5350"
                                CornerRadius="16"
                                HeightRequest="50"
                                FontAttributes="Bold"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Loading Indicator -->
                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        Padding="20"
                        StrokeShape="RoundRectangle 20"
                        IsVisible="{Binding IsLoading}"
                        HorizontalOptions="Center">
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.15" Radius="15" Offset="0,5"/>
                    </Border.Shadow>
                    <HorizontalStackLayout Spacing="12">
                        <ActivityIndicator IsRunning="True" 
                                           Color="{StaticResource Primary}" 
                                           VerticalOptions="Center"/>
                        <Label Text="Yükleniyor..." 
                               TextColor="{StaticResource TextSecondary}" 
                               FontSize="14"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

