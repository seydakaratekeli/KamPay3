<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:extensions="clr-namespace:KamPay.Extensions"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KamPay.ViewModels"
             xmlns:res="clr-namespace:KamPay.Services"
             x:DataType="vm:SurpriseBoxViewModel"
             x:Class="KamPay.Views.SurpriseBoxPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F5F9FC">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#1E88E5</Color>
            <Color x:Key="PrimaryDark">#1565C0</Color>
            <Color x:Key="Surface">#FFFFFF</Color>
            <Color x:Key="Background">#F5F9FC</Color>
            <Color x:Key="TextPrimary">#212121</Color>
            <Color x:Key="TextSecondary">#757575</Color>
            <Color x:Key="AccentGreen">#4CAF50</Color>
            <Color x:Key="AccentOrange">#FF9800</Color>
            <Color x:Key="AccentRed">#F44336</Color>
            <Color x:Key="AccentCyan">#00BCD4</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- ✨ GRADIENT HEADER (Blue Theme) -->
        <Grid Grid.Row="0" x:Name="HeaderSection">
            <BoxView>
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1E88E5" Offset="0.0" />
                        <GradientStop Color="#1565C0" Offset="1.0" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

            <Ellipse x:Name="Circle1" 
                     WidthRequest="150" 
                     HeightRequest="150"
                     Fill="White"
                     Opacity="0.05"
                     HorizontalOptions="End"
                     VerticalOptions="Start"
                     Margin="0,-60,-60,0"/>

            <Ellipse x:Name="Circle2" 
                     WidthRequest="100" 
                     HeightRequest="100"
                     Fill="White"
                     Opacity="0.08"
                     HorizontalOptions="Start"
                     VerticalOptions="Start"
                     Margin="-30,20,0,0"/>

            <VerticalStackLayout Margin="20,50,20,20" Spacing="10">
                <Label Text="🎁 Sürpriz Kutu"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalTextAlignment="Center"/>
                
                <!-- Points Badge -->
                <Border StrokeShape="RoundRectangle 25"
                        StrokeThickness="0"
                        BackgroundColor="#FFF3E0"
                        Padding="20,10"
                        HorizontalOptions="Center">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="💰"
                               FontSize="24"
                               VerticalOptions="Center"/>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{extensions:Translate CurrentPoints}"
                                   FontSize="11"
                                   TextColor="Black"
                                   Opacity="0.8"/>
                            <Label Text="{Binding UserPoints}"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="Black"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>
            </VerticalStackLayout>
        </Grid>

        <!-- ✨ MAIN CONTENT -->
        <ScrollView Grid.Row="1" x:Name="ContentSection">
            <VerticalStackLayout Spacing="20" Padding="20">

                <!-- 🎁 Mystery Box Card -->
                <Border StrokeShape="RoundRectangle 20"
                        StrokeThickness="0"
                        BackgroundColor="White"
                        Padding="30">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,4" Radius="15" Opacity="0.1"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="20" HorizontalOptions="Center">
                        
                        <!-- Gift Box Image with Blue Background -->
                        <Border StrokeShape="RoundRectangle 100"
                                StrokeThickness="0"
                                BackgroundColor="#E3F2FD"
                                WidthRequest="180"
                                HeightRequest="180"
                                HorizontalOptions="Center">
                            <Image x:Name="BoxImage"
                                   Source="gift_box.png"
                                   WidthRequest="120"
                                   HeightRequest="120"
                                   Aspect="AspectFit">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding RedeemBoxCommand}" />
                                </Image.GestureRecognizers>
                            </Image>
                        </Border>

                        <!-- Description Card -->
                        <Border StrokeShape="RoundRectangle 15"
                                StrokeThickness="0"
                                BackgroundColor="#E1F5FE"
                                Padding="20">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="✨ Nasıl Çalışır?"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"
                                       HorizontalTextAlignment="Center"/>
                                <Label Text="{extensions:Translate SurpriseBoxDescription}"
                                       FontSize="14"
                                       TextColor="#0277BD"
                                       HorizontalTextAlignment="Center"
                                       LineBreakMode="WordWrap"
                                       LineHeight="1.4"/>
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </Border>

                <!-- 🎉 Result Card (Hidden by default) -->
                <Border x:Name="ResultFrame"
                        IsVisible="False"
                        Opacity="0"
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="0"
                        BackgroundColor="White"
                        Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource AccentGreen}" Offset="0,4" Radius="15" Opacity="0.2"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="15">
                        
                        <!-- Success Header -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="🎉"
                                   FontSize="50"
                                   HorizontalTextAlignment="Center"/>
                            <Label Text="{extensions:Translate Congratulations}"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource AccentGreen}"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>

                        <!-- Product Image -->
                        <Border StrokeShape="RoundRectangle 15"
                                StrokeThickness="0"
                                HeightRequest="200">
                            <Image Source="{Binding RedemptionResult.ThumbnailUrl}"
                                   Aspect="AspectFill"/>
                        </Border>

                        <!-- Product Title -->
                        <Label Text="{Binding RedemptionResult.Title}"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"
                               MaxLines="2"/>

                        <!-- Success Message -->
                        <Label Text="{Binding SuccessMessage}"
                               FontSize="14"
                               TextColor="{StaticResource TextSecondary}"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap"
                               LineHeight="1.4"/>

                        <!-- View Button -->
                        <Button Text="{extensions:Translate ViewMyProduct}"
                                Clicked="CloseResult_Clicked"
                                BackgroundColor="{StaticResource AccentGreen}"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="16"
                                CornerRadius="25"
                                HeightRequest="50"
                                Margin="0,10,0,0"/>
                    </VerticalStackLayout>
                </Border>

                <!-- ⚠️ Insufficient Points Warning -->
                <Border IsVisible="{Binding UserPoints, Converter={StaticResource LessThan100Converter}}"
                        StrokeShape="RoundRectangle 15"
                        StrokeThickness="0"
                        BackgroundColor="#FFF3E0"
                        Padding="15">
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="💡"
                               FontSize="24"
                               VerticalOptions="Center"/>
                        <Label Text="{extensions:Translate InsufficientPoints}"
                               FontSize="13"
                               TextColor="#E65100"
                               VerticalOptions="Center"
                               HorizontalOptions="FillAndExpand"
                               LineBreakMode="WordWrap"
                               LineHeight="1.3"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- ❌ Error Message -->
                <Border IsVisible="{Binding HasError}"
                        StrokeShape="RoundRectangle 15"
                        StrokeThickness="0"
                        BackgroundColor="#FFEBEE"
                        Padding="15">
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="⚠️"
                               FontSize="24"
                               VerticalOptions="Center"/>
                        <Label Text="{Binding ErrorMessage}"
                               FontSize="13"
                               TextColor="{StaticResource AccentRed}"
                               VerticalOptions="Center"
                               HorizontalOptions="FillAndExpand"
                               LineBreakMode="WordWrap"
                               LineHeight="1.3"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- 🎁 Open Box Button (Blue Theme) -->
                <Border StrokeShape="RoundRectangle 30"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource Primary}"
                        HeightRequest="60">
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource Primary}" Offset="0,4" Radius="10" Opacity="0.3"/>
                    </Border.Shadow>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border"
                                     Binding="{Binding CanRedeem}"
                                     Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding RedeemBoxCommand}"/>
                    </Border.GestureRecognizers>
                    
                    <Label Text="{extensions:Translate OpenBoxFor100Points}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           IsEnabled="{Binding CanRedeem}"/>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ⏳ Loading Overlay (Blue Theme) -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              IsVisible="{Binding IsLoading}"
              BackgroundColor="#F5F9FC"
              ZIndex="1100"
              InputTransparent="False">
            <Border BackgroundColor="White"
                    WidthRequest="140"
                    HeightRequest="140"
                    StrokeThickness="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.15" Radius="20" Offset="0,8"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="15" 
                                     HorizontalOptions="Center" 
                                     VerticalOptions="Center">
                    <Label Text="🎁"
                           FontSize="50"
                           HorizontalTextAlignment="Center"/>
                    <ActivityIndicator IsRunning="True"
                                       Color="{StaticResource Primary}"
                                       WidthRequest="40"
                                       HeightRequest="40" />
                    <Label Text="{extensions:Translate OpeningBox}"
                           TextColor="{StaticResource Primary}"
                           FontSize="14"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>
</ContentPage>

