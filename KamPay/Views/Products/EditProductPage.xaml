<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:extensions="clr-namespace:KamPay.Extensions"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KamPay.ViewModels"
             xmlns:models="clr-namespace:KamPay.Models"
             xmlns:conv="clr-namespace:KamPay.Converters"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
             xmlns:res="clr-namespace:KamPay.Services"
             x:Class="KamPay.Views.EditProductPage"
             Shell.NavBarIsVisible="False">

    <Grid>
        <!-- Gradient Background Header -->
        <BoxView VerticalOptions="Start" HeightRequest="180">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{StaticResource Primary}" Offset="0.0" />
                    <GradientStop Color="{StaticResource PrimaryDark}" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- Animated Background Circle -->
        <Ellipse x:Name="Circle1" 
                 WidthRequest="220" 
                 HeightRequest="220"
                 Fill="White"
                 Opacity="0.05"
                 HorizontalOptions="End"
                 VerticalOptions="Start"
                 Margin="0,-80,-80,0"/>

        <ScrollView>
            <VerticalStackLayout x:Name="MainContent" Spacing="0">

                <!-- Header Section -->
                <VerticalStackLayout x:Name="HeaderSection" Spacing="10" Padding="20,40,20,25">
                    <Label Text="✏️" FontSize="42" HorizontalOptions="Center"/>
                    <Label Text="{extensions:Translate EditProduct}"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"/>
                    <Label Text="Ürününüzü güncelleyin"
                           FontSize="13"
                           TextColor="White"
                           Opacity="0.9"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Main Form Card -->
                <Border x:Name="FormCard"
                        BackgroundColor="White"
                        StrokeThickness="0"
                        Padding="20"
                        Margin="15,-15,15,20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.15" Radius="20" Offset="0,8"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">

                        <!-- Error Message -->
                        <Border IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                                BackgroundColor="#FFEBEE"
                                StrokeThickness="0"
                                Padding="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Label Text="{Binding ErrorMessage}"
                                   TextColor="#EF5350"
                                   FontSize="13"
                                   FontAttributes="Bold"/>
                        </Border>

                        <!-- Product Info Section -->
                        <Label Text="{extensions:Translate ProductInfo}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"/>

                        <!-- Title Input -->
                        <Border BackgroundColor="{StaticResource Background}" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Entry Placeholder="{extensions:Translate ProductTitle}"
                                   Text="{Binding Title}"
                                   MaxLength="100"
                                   FontSize="15"
                                   TextColor="{StaticResource TextPrimary}"
                                   PlaceholderColor="{StaticResource TextHint}"
                                   BackgroundColor="Transparent"
                                   HeightRequest="48"
                                   Margin="16,0"/>
                        </Border>

                        <!-- Description Input -->
                        <Border BackgroundColor="{StaticResource Background}" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Editor Placeholder="{extensions:Translate ProductDescription}"
                                    Text="{Binding Description}"
                                    MinimumHeightRequest="100"
                                    MaxLength="1000"
                                    FontSize="15"
                                    TextColor="{StaticResource TextPrimary}"
                                    PlaceholderColor="{StaticResource TextHint}"
                                    BackgroundColor="Transparent"
                                    AutoSize="TextChanges"
                                    Margin="16,8"/>
                        </Border>

                        <!-- Category Picker -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{extensions:Translate Category}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}"/>
                            <Border BackgroundColor="{StaticResource Background}" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Picker ItemsSource="{Binding Categories}"
                                        SelectedItem="{Binding SelectedCategory}"
                                        ItemDisplayBinding="{Binding Name}"
                                        FontSize="15"
                                        TextColor="{StaticResource TextPrimary}"
                                        Title="{extensions:Translate SelectCategory}"
                                        BackgroundColor="Transparent"
                                        Margin="16,0"
                                        HeightRequest="48"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Product Type Picker -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{extensions:Translate ProductType}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}"/>
                            <Border BackgroundColor="{StaticResource Background}" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Picker ItemsSource="{Binding ProductTypes}"
                                        SelectedItem="{Binding SelectedType}"
                                        FontSize="15"
                                        TextColor="{StaticResource TextPrimary}"
                                        Title="{extensions:Translate SelectType}"
                                        BackgroundColor="Transparent"
                                        Margin="16,0"
                                        HeightRequest="48">
                                    <Picker.ItemDisplayBinding>
                                        <Binding>
                                            <Binding.Converter>
                                                <conv:ProductTypeConverter/>
                                            </Binding.Converter>
                                        </Binding>
                                    </Picker.ItemDisplayBinding>
                                </Picker>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Price Input -->
                        <Border IsVisible="{Binding ShowPriceField}"
                                BackgroundColor="{StaticResource Background}"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Grid Padding="16,0" ColumnDefinitions="*,Auto">
                                <Entry Grid.Column="0"
                                       Placeholder="{extensions:Translate Price}"
                                       Text="{Binding Price}"
                                       Keyboard="Numeric"
                                       FontSize="15"
                                       TextColor="{StaticResource TextPrimary}"
                                       PlaceholderColor="{StaticResource TextHint}"
                                       BackgroundColor="Transparent"
                                       HeightRequest="48"/>
                                <Label Grid.Column="1"
                                       Text="₺"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"
                                       VerticalOptions="Center"
                                       Margin="0,0,8,0"/>
                            </Grid>
                        </Border>

                        <!-- Exchange Preference -->
                        <Border IsVisible="{Binding ShowExchangeField}"
                                BackgroundColor="{StaticResource Background}"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Entry Placeholder="{extensions:Translate WhatToExchange}"
                                   Text="{Binding ExchangePreference}"
                                   FontSize="15"
                                   TextColor="{StaticResource TextPrimary}"
                                   PlaceholderColor="{StaticResource TextHint}"
                                   BackgroundColor="Transparent"
                                   HeightRequest="48"
                                   Margin="16,0"/>
                        </Border>

                        <!-- Condition Picker -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{extensions:Translate ProductCondition}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}"/>
                            <Border BackgroundColor="{StaticResource Background}" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Picker ItemsSource="{Binding Conditions}"
                                        SelectedItem="{Binding SelectedCondition}"
                                        FontSize="15"
                                        TextColor="{StaticResource TextPrimary}"
                                        Title="{extensions:Translate SelectCondition}"
                                        BackgroundColor="Transparent"
                                        Margin="16,0"
                                        HeightRequest="48">
                                    <Picker.ItemDisplayBinding>
                                        <Binding>
                                            <Binding.Converter>
                                                <conv:ProductConditionConverter/>
                                            </Binding.Converter>
                                        </Binding>
                                    </Picker.ItemDisplayBinding>
                                </Picker>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Location Section -->
                        <VerticalStackLayout Spacing="12">
                            <Label Text="{extensions:Translate Location}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextSecondary}"/>

                            <Border StrokeShape="RoundRectangle 16"
                                    StrokeThickness="0"
                                    HeightRequest="220">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Opacity="0.08" Radius="8" Offset="0,2"/>
                                </Border.Shadow>
                                <Grid>
                                    <mapsui:MapControl x:Name="ProductMap"
                                                       VerticalOptions="FillAndExpand"
                                                       HorizontalOptions="FillAndExpand"/>

                                    <!-- Zoom Controls -->
                                    <VerticalStackLayout HorizontalOptions="End"
                                                        VerticalOptions="Start"
                                                        Margin="12"
                                                        Spacing="8">

                                        <Border StrokeShape="RoundRectangle 20"
                                                BackgroundColor="White"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                Padding="0">
                                            <Border.Shadow>
                                                <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.2"/>
                                            </Border.Shadow>
                                            <Button Text="+"
                                                    Clicked="OnZoomInClicked"
                                                    FontSize="22"
                                                    FontAttributes="Bold"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{StaticResource TextPrimary}"
                                                    WidthRequest="40"
                                                    HeightRequest="40"
                                                    Padding="0"/>
                                        </Border>

                                        <Border StrokeShape="RoundRectangle 20"
                                                BackgroundColor="White"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                Padding="0">
                                            <Border.Shadow>
                                                <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.2"/>
                                            </Border.Shadow>
                                            <Button Text="−"
                                                    Clicked="OnZoomOutClicked"
                                                    FontSize="22"
                                                    FontAttributes="Bold"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{StaticResource TextPrimary}"
                                                    WidthRequest="40"
                                                    HeightRequest="40"
                                                    Padding="0"/>
                                        </Border>

                                        <BoxView HeightRequest="1"
                                                 WidthRequest="30"
                                                 BackgroundColor="{StaticResource Divider}"
                                                 HorizontalOptions="Center"
                                                 Margin="0,4"/>

                                        <Border StrokeShape="RoundRectangle 20"
                                                BackgroundColor="White"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                Padding="0">
                                            <Border.Shadow>
                                                <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.2"/>
                                            </Border.Shadow>
                                            <Button Text="📍"
                                                    Command="{Binding UseCurrentLocationCommand}"
                                                    FontSize="18"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{StaticResource Primary}"
                                                    WidthRequest="40"
                                                    HeightRequest="40"
                                                    Padding="0"/>
                                        </Border>

                                        <Border StrokeShape="RoundRectangle 20"
                                                BackgroundColor="White"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                Padding="0">
                                            <Border.Shadow>
                                                <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.2"/>
                                            </Border.Shadow>
                                            <Button Text="🎯"
                                                    Clicked="OnResetLocationClicked"
                                                    FontSize="18"
                                                    BackgroundColor="Transparent"
                                                    TextColor="#2196F3"
                                                    WidthRequest="40"
                                                    HeightRequest="40"
                                                    Padding="0"/>
                                        </Border>
                                    </VerticalStackLayout>

                                    <!-- Location Display -->
                                    <Border StrokeShape="RoundRectangle 12"
                                            BackgroundColor="White"
                                            Padding="12"
                                            Margin="12"
                                            VerticalOptions="End"
                                            HorizontalOptions="FillAndExpand"
                                            IsVisible="{Binding HasLocation}">
                                        <Border.Shadow>
                                            <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.2"/>
                                        </Border.Shadow>
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="📌" FontSize="16" VerticalOptions="Center"/>
                                            <Label Text="{Binding Location}"
                                                   FontSize="12"
                                                   TextColor="{StaticResource TextPrimary}"
                                                   VerticalOptions="Center"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="2"
                                                   HorizontalOptions="FillAndExpand"/>
                                        </HorizontalStackLayout>
                                    </Border>
                                </Grid>
                            </Border>
                            <Label Text="{extensions:Translate MapLocationInfo}"
                                   FontSize="12"
                                   TextColor="{StaticResource TextHint}"/>
                        </VerticalStackLayout>

                        <!-- Images Section -->
                        <VerticalStackLayout Spacing="12">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{extensions:Translate ProductImages}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextSecondary}"
                                       VerticalOptions="Center"/>
                                <Label Text="(Tıklayarak önizleyebilirsiniz)"
                                       FontSize="11"
                                       TextColor="{StaticResource TextHint}"
                                       VerticalOptions="Center"
                                       Opacity="0.8"/>
                            </HorizontalStackLayout>

                            <Button Text="📷 Resim Ekle"
                                    Command="{Binding PickImagesCommand}"
                                    BackgroundColor="#E3F2FD"
                                    TextColor="{StaticResource Primary}"
                                    FontAttributes="Bold"
                                    CornerRadius="12"
                                    HeightRequest="50"
                                    BorderColor="{StaticResource Primary}"
                                    BorderWidth="2"/>

                            <FlexLayout BindableLayout.ItemsSource="{Binding ImagePaths}"
                                        Wrap="Wrap"
                                        JustifyContent="Start">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border StrokeShape="RoundRectangle 12"
                                                StrokeThickness="2"
                                                Stroke="#2196F3"
                                                WidthRequest="100"
                                                HeightRequest="100"
                                                Margin="4">
                                            <Border.Shadow>
                                                <Shadow Brush="#2196F3" Opacity="0.2" Radius="8" Offset="0,4"/>
                                            </Border.Shadow>
                                            <Grid>
                                                <!-- ✅ Görsel Önizleme için TapGestureRecognizer -->
                                                <Image Source="{Binding .}" 
                                                       Aspect="AspectFill">
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer 
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EditProductViewModel}}, Path=PreviewImageCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    </Image.GestureRecognizers>
                                                </Image>
                                                
                                                <!-- Silme Butonu -->
                                                <Button Text="✕"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EditProductViewModel}}, Path=RemoveImageCommand}"
                                                        CommandParameter="{Binding .}"
                                                        BackgroundColor="#EF5350"
                                                        TextColor="White"
                                                        FontSize="16"
                                                        FontAttributes="Bold"
                                                        WidthRequest="32"
                                                        HeightRequest="32"
                                                        CornerRadius="16"
                                                        Padding="0"
                                                        HorizontalOptions="End"
                                                        VerticalOptions="Start"
                                                        Margin="4">
                                                    <Button.Shadow>
                                                        <Shadow Brush="Black" Opacity="0.3" Radius="4" Offset="0,2"/>
                                                    </Button.Shadow>
                                                </Button>
                                                
                                                <!-- Önizleme İkonu -->
                                                <Border BackgroundColor="#CC2196F3"
                                                        WidthRequest="28"
                                                        HeightRequest="28"
                                                        StrokeThickness="0"
                                                        HorizontalOptions="Start"
                                                        VerticalOptions="Start"
                                                        Margin="4">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="14"/>
                                                    </Border.StrokeShape>
                                                    <Label Text="🔍"
                                                           FontSize="14"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>

                        <!-- Action Buttons -->
                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="12"
                              Margin="0,20,0,0">
                            <Button Grid.Column="0"
                                    Text="{extensions:Translate Cancel}"
                                    Command="{Binding CancelCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource TextSecondary}"
                                    BorderColor="{StaticResource Divider}"
                                    BorderWidth="2"
                                    CornerRadius="12"
                                    FontAttributes="Bold"
                                    HeightRequest="54"/>

                            <Button Grid.Column="1"
                                    Text="{extensions:Translate Update}"
                                    Command="{Binding SaveProductCommand}"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="White"
                                    CornerRadius="12"
                                    FontAttributes="Bold"
                                    HeightRequest="54">
                                <Button.Shadow>
                                    <Shadow Brush="{StaticResource Primary}" Opacity="0.3" Radius="10" Offset="0,4"/>
                                </Button.Shadow>
                            </Button>
                        </Grid>

                        <!-- Loading Indicator -->
                        <ActivityIndicator IsRunning="{Binding IsLoading}"
                                           IsVisible="{Binding IsLoading}"
                                           Color="{StaticResource Primary}"
                                           HeightRequest="40"
                                           Margin="0,10"/>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

