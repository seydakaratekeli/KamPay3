<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns:extensions="clr-namespace:KamPay.Extensions"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KamPay.ViewModels"
             xmlns:models="clr-namespace:KamPay.Models"
             xmlns:converters="clr-namespace:KamPay.Converters"
             xmlns:res="clr-namespace:KamPay.Services"
             x:Class="KamPay.Views.FavoritesPage"
             x:DataType="vm:FavoritesViewModel"
             Title=""
             Shell.NavBarIsVisible="False"
             BackgroundColor="Transparent">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <!-- Background Circle Animation -->
        <Ellipse x:Name="Circle1"
                 Fill="#1A2196F3"
                 WidthRequest="400"
                 HeightRequest="400"
                 HorizontalOptions="End"
                 VerticalOptions="Start"
                 TranslationX="150"
                 TranslationY="-150"
                 Opacity="0.6"/>

        <Grid RowDefinitions="Auto,*" Padding="0">
            <!-- Header Section -->
            <VerticalStackLayout x:Name="HeaderSection" 
                                 Grid.Row="0" 
                                 Spacing="10" 
                                 Padding="20,50,20,20"
                                 BackgroundColor="#2196F3">

                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                        <Label Text="❤️ Favorilerim"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="White"/>
                        <Label Text="Beğendiğin ürünler burada"
                               FontSize="14"
                               TextColor="#E3F2FD"
                               Opacity="0.9"/>
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>

            <!-- Content Section -->
            <Grid x:Name="ContentSection" Grid.Row="1" BackgroundColor="#FAFAFA">
                <RefreshView Command="{Binding RefreshFavoritesCommand}"
                             IsRefreshing="{Binding IsRefreshing}"
                             RefreshColor="{StaticResource Primary}">

                    <CollectionView ItemsSource="{Binding FavoriteItems}"
                                    SelectionMode="None"
                                    Margin="10,10,10,0">

                        <CollectionView.EmptyView>
                            <VerticalStackLayout Padding="40"
                                                 VerticalOptions="Center"
                                                 HorizontalOptions="Center"
                                                 Spacing="15">
                                <Label Text="❤️"
                                       FontSize="60"
                                       HorizontalTextAlignment="Center"
                                       Opacity="0.3"/>
                                <Label Text="{extensions:Translate NoFavoritesYet}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Gray600}"
                                       HorizontalTextAlignment="Center"/>
                                <Label Text="{extensions:Translate AddFavoritesHint}"
                                       FontSize="13"
                                       TextColor="{StaticResource Gray400}"
                                       HorizontalTextAlignment="Center"
                                       Margin="20,5,20,0"/>
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Favorite">
                                <SwipeView Margin="0,0,0,10">
                                    <SwipeView.RightItems>
                                        <SwipeItems>
                                            <SwipeItem Text="Kaldır"
                                                       BackgroundColor="{StaticResource Danger}"
                                                       Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FavoritesViewModel}}, Path=RemoveFavoriteCommand}"
                                                       CommandParameter="{Binding .}">
                                                <SwipeItem.IconImageSource>
                                                    <FontImageSource FontFamily="MaterialIcons" 
                                                                     Glyph="&#xe872;" 
                                                                     Color="White"/>
                                                </SwipeItem.IconImageSource>
                                            </SwipeItem>
                                        </SwipeItems>
                                    </SwipeView.RightItems>

                                    <Border StrokeShape="RoundRectangle 20"
                                            StrokeThickness="0"
                                            BackgroundColor="White"
                                            Padding="0">

                                        <Border.Shadow>
                                            <Shadow Brush="Black" Opacity="0.1" Radius="10" Offset="0,2"/>
                                        </Border.Shadow>

                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FavoritesViewModel}}, Path=GoToProductDetailCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>

                                        <Grid ColumnDefinitions="120,*" ColumnSpacing="0">
                                            <!-- Product Image -->
                                            <Border Grid.Column="0" 
                                                    StrokeShape="RoundRectangle 20,0,0,20"
                                                    StrokeThickness="0"
                                                    HeightRequest="120"
                                                    WidthRequest="120">
                                                <Image Source="{Binding ProductThumbnail}"
                                                       Aspect="AspectFill"/>
                                            </Border>

                                            <!-- Product Info -->
                                            <VerticalStackLayout Grid.Column="1"
                                                                 Padding="15,12"
                                                                 Spacing="8"
                                                                 VerticalOptions="Center">

                                                <Label Text="{Binding ProductTitle}"
                                                       FontAttributes="Bold"
                                                       FontSize="16"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="2"
                                                       TextColor="{StaticResource TextPrimary}" />

                                                <!-- Price Badge -->
                                                <Border StrokeShape="RoundRectangle 10"
                                                        StrokeThickness="0"
                                                        BackgroundColor="#E3F2FD"
                                                        Padding="12,6"
                                                        HorizontalOptions="Start">
                                                    <Label Text="{Binding ., Converter={StaticResource ProductToPriceTextConverter}}"
                                                             FontAttributes="Bold"
                                                             FontSize="16"
                                                             TextColor="#2196F3" />
                                                </Border>

                                                <HorizontalStackLayout Spacing="5">
                                                    <Label Text="🕒"
                                                           FontSize="12"
                                                           VerticalOptions="Center"/>
                                                    <Label Text="{Binding CreatedAt, Converter={StaticResource DateTimeToTimeAgoConverter}}"
                                                             FontSize="12"
                                                             TextColor="{StaticResource TextHint}"
                                                             VerticalOptions="Center"/>
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>

                                            <!-- Favorite Indicator -->
                                            <BoxView Grid.Column="1"
                                                     HorizontalOptions="End"
                                                     VerticalOptions="Start"
                                                     Margin="0,10,10,0"
                                                     WidthRequest="30"
                                                     HeightRequest="30"
                                                     CornerRadius="15"
                                                     Color="#FF4081"
                                                     Opacity="0.9"/>
                                            <Label Grid.Column="1"
                                                   Text="❤️"
                                                   FontSize="16"
                                                   HorizontalOptions="End"
                                                   VerticalOptions="Start"
                                                   Margin="0,10,10,0"
                                                   WidthRequest="30"
                                                   HeightRequest="30"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </SwipeView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </RefreshView>

                <!-- Loading Indicator -->
                <Grid IsVisible="{Binding IsLoading}"
                      BackgroundColor="#FAFAFA">
                    <VerticalStackLayout VerticalOptions="Center"
                                         HorizontalOptions="Center"
                                         Spacing="15">
                        <ActivityIndicator IsRunning="True"
                                           Color="{StaticResource Primary}"
                                           WidthRequest="50"
                                           HeightRequest="50"/>
                        <Label Text="Favoriler yükleniyor..."
                               TextColor="{StaticResource Gray600}"
                               FontSize="14"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>

