<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:KamPay.ViewModels"
    xmlns:models="clr-namespace:KamPay.Models"
    xmlns:converters="clr-namespace:KamPay.Converters"
    xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
    xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
    xmlns:extensions="clr-namespace:KamPay.Extensions"
    x:Class="KamPay.Views.ProductDetailPage"
    x:Name="ProductDetailPageRoot"
    Title="{extensions:Translate ProductDetailTitle}"
    BackgroundColor="#F5F9FC"
    Shell.BackgroundColor="#1E88E5"
    Shell.ForegroundColor="White">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#1E88E5</Color>
            <Color x:Key="PrimaryDark">#1565C0</Color>
            <Color x:Key="TextPrimary">#212121</Color>
            <Color x:Key="TextSecondary">#757575</Color>
            <Color x:Key="Surface">#FFFFFF</Color>
            <Color x:Key="BorderColor">#E0E0E0</Color>
            <Color x:Key="Danger">#EF5350</Color>

            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:IsNotNullOrEmptyConverter x:Key="IsNotNullOrEmptyConverter" />
            <converters:ProductTypeToBadgeColorConverter x:Key="ProductTypeToBadgeColorConverter" />
            <converters:ProductTypeToBadgeTextConverter x:Key="ProductTypeToBadgeTextConverter" />
            <converters:ProductCategoryToTextConverter x:Key="ProductCategoryToTextConverter" />
            <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
            <converters:IsPendingConverter x:Key="IsPendingConverter" />
            <converters:CanNegotiateConverter x:Key="CanNegotiateConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="0">

                <!-- Image Carousel -->
                <Grid HeightRequest="350">
                    <CarouselView ItemsSource="{Binding ProductImages}"
                                  Position="{Binding CurrentImageIndex}"
                                  IndicatorView="indicatorView"
                                  Loop="False">
                        <CarouselView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer 
                                            Command="{Binding BindingContext.ViewProductImageCommand, Source={x:Reference ProductDetailPageRoot}}"
                                            CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <!-- ✅ Tam ekran görüntüleme için TapGestureRecognizer -->
                                    <Image Source="{Binding .}" Aspect="AspectFill" InputTransparent="True" />
                                </Grid>
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>

                    <Grid VerticalOptions="End" HeightRequest="80">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="Transparent" Offset="0.0" />
                                <GradientStop Color="#99000000" Offset="1.0" />
                            </LinearGradientBrush>
                        </Grid.Background>
                    </Grid>

                    <IndicatorView x:Name="indicatorView"
                                   IndicatorColor="#E0E0E0"
                                   SelectedIndicatorColor="{StaticResource Primary}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="End"
                                   Margin="0,0,0,15" />
                </Grid>

                <!-- Main Content Card -->
                <Border StrokeThickness="0"
                        BackgroundColor="{StaticResource Surface}"
                        StrokeShape="RoundRectangle 24,24,0,0"
                        Margin="0,-30,0,0"
                        Padding="24,30,24,40">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,-4" Radius="15" Opacity="0.12" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="20">

                        <!-- Title & Price Section -->
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding Product.CreatedAt, StringFormat='{0:d MMMM yyyy}'}"
                                       TextColor="{StaticResource TextSecondary}"
                                       FontSize="12"
                                       VerticalOptions="Center"/>

                                <Border BackgroundColor="{Binding Product.Type, Converter={StaticResource ProductTypeToBadgeColorConverter}}"
                                        StrokeShape="RoundRectangle 10"
                                        StrokeThickness="0"
                                        Padding="12,6"
                                        HorizontalOptions="End">
                                    <Label Text="{Binding Product.Type, Converter={StaticResource ProductTypeToBadgeTextConverter}}"
                                           TextColor="White"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextTransform="Uppercase"/>
                                </Border>
                            </Grid>

                            <Label Text="{Binding Product.Title}"
                                   TextColor="{StaticResource TextPrimary}"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   LineBreakMode="WordWrap" />

                            <Label Text="{Binding Product, Converter={StaticResource ProductToPriceTextConverter}}"
                                   TextColor="{StaticResource Primary}"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   Margin="0,-4,0,0"/>
                        </VerticalStackLayout>


                        <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" />

                        <!-- Product Details Grid -->
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="15" ColumnSpacing="15">
                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                                <Label Text="{extensions:Translate ConditionLabel}" TextColor="{StaticResource TextSecondary}" FontSize="12" />
                                <Label Text="{Binding Product.Condition, Converter={StaticResource ProductConditionConverter}}" TextColor="{StaticResource TextPrimary}" FontSize="15" FontAttributes="Bold" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                                <Label Text="{extensions:Translate CategoryLabel}" TextColor="{StaticResource TextSecondary}" FontSize="12" />
                                <Label Text="{Binding Product.CategoryName, Converter={StaticResource ProductCategoryToTextConverter}}" TextColor="{StaticResource TextPrimary}" FontSize="15" FontAttributes="Bold" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="4"
                                                 IsVisible="{Binding Product.ExchangePreference, Converter={StaticResource IsNotNullOrEmptyConverter}}">
                                <Label Text="{extensions:Translate ExchangePreferenceLabel}" TextColor="{StaticResource TextSecondary}" FontSize="12" />
                                <Border BackgroundColor="#E3F2FD" 
                                        StrokeThickness="0" 
                                        Padding="12" 
                                        StrokeShape="RoundRectangle 10">
                                    <Label Text="{Binding Product.ExchangePreference}" TextColor="#1565C0" FontSize="14" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Description -->
                        <VerticalStackLayout Spacing="8" Margin="0,10,0,0">
                            <Label Text="{extensions:Translate DescriptionLabel}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                            <Label Text="{Binding Product.Description}" 
                                   FontSize="15" 
                                   TextColor="#424242" 
                                   LineHeight="1.4" />
                        </VerticalStackLayout>

                        <!-- ✨ IMPROVED MAP SECTION -->
                        <VerticalStackLayout Spacing="12" IsVisible="{Binding HasLocation}" Margin="0,10,0,0">
                            <Label Text="{extensions:Translate LocationLabel}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                            <Border StrokeShape="RoundRectangle 16"
                                    HeightRequest="250"
                                    StrokeThickness="0"
                                    BackgroundColor="#F0F0F0">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Opacity="0.1" Radius="8" Offset="0,2"/>
                                </Border.Shadow>
                                <Grid>
                                    <mapsui:MapControl x:Name="ProductMap" VerticalOptions="Fill" HorizontalOptions="Fill" />

                                    <!-- Map Controls (Top Right) -->
                                    <VerticalStackLayout Spacing="8" 
                                                         HorizontalOptions="End" 
                                                         VerticalOptions="Start" 
                                                         Margin="12">
                                        <!-- Zoom In -->
                                        <Border StrokeShape="RoundRectangle 10"
                                                BackgroundColor="White"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                StrokeThickness="0"
                                                Padding="0">
                                            <Border.Shadow>
                                                <Shadow Brush="Black" Opacity="0.15" Radius="4" Offset="0,2"/>
                                            </Border.Shadow>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnZoomInClicked"/>
                                            </Border.GestureRecognizers>
                                            <Label Text="+"
                                                   FontSize="24"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Primary}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"/>
                                        </Border>

                                        <!-- Zoom Out -->
                                        <Border StrokeShape="RoundRectangle 10"
                                                BackgroundColor="White"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                StrokeThickness="0"
                                                Padding="0">
                                            <Border.Shadow>
                                                <Shadow Brush="Black" Opacity="0.15" Radius="4" Offset="0,2"/>
                                            </Border.Shadow>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnZoomOutClicked"/>
                                            </Border.GestureRecognizers>
                                            <Label Text="-"
                                                   FontSize="24"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Primary}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   Margin="0,-4,0,0"/>
                                        </Border>

                                        <!-- Reset to Product Location -->
                                        <Border StrokeShape="RoundRectangle 10"
                                                BackgroundColor="White"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                StrokeThickness="0"
                                                Padding="0">
                                            <Border.Shadow>
                                                <Shadow Brush="Black" Opacity="0.15" Radius="4" Offset="0,2"/>
                                            </Border.Shadow>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnResetLocationClicked"/>
                                            </Border.GestureRecognizers>
                                            <Label Text="📍"
                                                   FontSize="18"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"/>
                                        </Border>
                                    </VerticalStackLayout>

                                    <!-- Location Info (Bottom) -->
                                    <Border VerticalOptions="End" 
                                            Margin="12" 
                                            BackgroundColor="White" 
                                            StrokeShape="RoundRectangle 12" 
                                            Padding="12"
                                            StrokeThickness="0">
                                        <Border.Shadow>
                                            <Shadow Brush="Black" Opacity="0.15" Radius="6" Offset="0,2"/>
                                        </Border.Shadow>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Label Text="📍" VerticalOptions="Center" FontSize="16"/>
                                            <Label Grid.Column="1" 
                                                   Text="{Binding Product.Location}" 
                                                   FontSize="13" 
                                                   TextColor="{StaticResource TextPrimary}" 
                                                   LineBreakMode="TailTruncation" 
                                                   MaxLines="2" 
                                                   VerticalOptions="Center"/>
                                            <Button Grid.Column="2" 
                                                    Text="{extensions:Translate Go}" 
                                                    Command="{Binding OpenLocationCommand}" 
                                                    HeightRequest="32" 
                                                    CornerRadius="16" 
                                                    Padding="15,0" 
                                                    BackgroundColor="{StaticResource Primary}" 
                                                    TextColor="White" 
                                                    FontSize="12" 
                                                    FontAttributes="Bold"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Seller Info -->
                        <Border StrokeShape="RoundRectangle 16"
                                StrokeThickness="0"
                                BackgroundColor="#F5F9FC"
                                Padding="12"
                                Margin="0,10,0,0">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <ffimageloading:CachedImage Grid.Column="0"
                                                            Source="{Binding Product.UserPhotoUrl}"
                                                            WidthRequest="50" HeightRequest="50"
                                                            Aspect="AspectFill"
                                                            LoadingPlaceholder="person_icon.svg"
                                                            ErrorPlaceholder="person_icon.svg">
                                    <ffimageloading:CachedImage.Clip>
                                        <EllipseGeometry Center="25,25" RadiusX="25" RadiusY="25" />
                                    </ffimageloading:CachedImage.Clip>
                                </ffimageloading:CachedImage>

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Product.UserName}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                                    <Label Text="{Binding Product.CreatedAt, Converter={StaticResource DateTimeToTimeAgoConverter}}" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                                </VerticalStackLayout>

                                <Button Grid.Column="2" 
                                        Text="{extensions:Translate SellerProfile}" 
                                        TextColor="{StaticResource Primary}" 
                                        BackgroundColor="Transparent" 
                                        FontSize="13" 
                                        FontAttributes="Bold"
                                        Padding="0"
                                        HeightRequest="40"/>
                            </Grid>
                        </Border>

                        <!-- View Count -->
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Opacity="0.6" Margin="0,10,0,20">
                            <Label Text="👁" FontSize="14" VerticalOptions="Center"/>
                            <Label Text="{Binding Product.ViewCount}" FontSize="12" FontAttributes="Bold" VerticalOptions="Center"/>
                            <Label Text="{extensions:Translate ViewsLabel}" FontSize="12" VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ✨ BOTTOM ACTION BAR -->
        <Border Grid.Row="1" 
                VerticalOptions="End" 
                BackgroundColor="{StaticResource Surface}" 
                StrokeThickness="0" 
                Padding="16,16,16,24">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.15" Radius="12" Offset="0,-4"/>
            </Border.Shadow>
            <Grid>
                <!-- Owner Buttons -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" IsVisible="{Binding IsOwner}">
                    <Button Grid.Column="0" 
                            Text="{extensions:Translate Edit}" 
                            Command="{Binding EditProductCommand}" 
                            BackgroundColor="#F5F9FC" 
                            TextColor="{StaticResource TextPrimary}" 
                            CornerRadius="12" 
                            FontAttributes="Bold" 
                            HeightRequest="50"/>
                    <Button Grid.Column="1" 
                            Text="{extensions:Translate MarkAsSold}" 
                            Command="{Binding MarkAsSoldCommand}" 
                            IsVisible="{Binding Product.IsSold, Converter={StaticResource InvertedBoolConverter}}" 
                            BackgroundColor="{StaticResource Primary}" 
                            TextColor="White" 
                            CornerRadius="12" 
                            FontAttributes="Bold" 
                            HeightRequest="50">
                        <Button.Shadow>
                            <Shadow Brush="{StaticResource Primary}" Opacity="0.3" Radius="8" Offset="0,4"/>
                        </Button.Shadow>
                    </Button>
                    <Button Grid.Column="2" 
                            Text="{extensions:Translate Delete}" 
                            Command="{Binding DeleteProductCommand}" 
                            BackgroundColor="#FFEBEE" 
                            TextColor="{StaticResource Danger}" 
                            CornerRadius="12" 
                            FontAttributes="Bold" 
                            HeightRequest="50"/>
                </Grid>

                <!-- Buyer Buttons -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" 
                      IsVisible="{Binding CanContact}">
                    <Button Grid.Column="0" 
                            Command="{Binding ToggleFavoriteCommand}" 
                            WidthRequest="50" 
                            HeightRequest="50" 
                            CornerRadius="14" 
                            BackgroundColor="#FFF8E1" 
                            BorderColor="Transparent">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsFavorite}" Value="True">
                                <Setter Property="Text" Value="❤️"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding IsFavorite}" Value="False">
                                <Setter Property="Text" Value="🤍"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <Button Grid.Column="1" 
                            Command="{Binding SendRequestCommand}" 
                            HeightRequest="50" 
                            CornerRadius="14" 
                            BackgroundColor="{StaticResource Primary}" 
                            TextColor="White" 
                            FontAttributes="Bold" 
                            FontSize="15" 
                            IsVisible="{Binding HasActiveTransaction, Converter={StaticResource InvertedBoolConverter}}">
                        <Button.Shadow>
                            <Shadow Brush="{StaticResource Primary}" Opacity="0.4" Radius="10" Offset="0,4"/>
                        </Button.Shadow>
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding Product.Type}" Value="{x:Static models:ProductType.Satis}">
                                <Setter Property="Text" Value="{extensions:Translate RequestToBuy}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding Product.Type}" Value="{x:Static models:ProductType.Bagis}">
                                <Setter Property="Text" Value="{extensions:Translate IWantToTake}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding Product.Type}" Value="{x:Static models:ProductType.Takas}">
                                <Setter Property="Text" Value="{extensions:Translate OfferTrade}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <Button Grid.Column="1" 
                            Text="💰 Pazarlık Yap" 
                            Command="{Binding MessageSellerCommand}" 
                            HeightRequest="50" 
                            CornerRadius="14" 
                            BackgroundColor="#FF9800" 
                            TextColor="White" 
                            FontAttributes="Bold" 
                            FontSize="15" 
                            IsVisible="{Binding HasActiveTransaction}">
                        <Button.Shadow>
                            <Shadow Brush="#FF9800" Opacity="0.4" Radius="10" Offset="0,4"/>
                        </Button.Shadow>
                    </Button>

                    <Button Grid.Column="2" 
                            Text="💬" 
                            Command="{Binding ContactSellerCommand}" 
                            WidthRequest="50" 
                            HeightRequest="50" 
                            CornerRadius="14" 
                            BackgroundColor="#E3F2FD" 
                            TextColor="#1976D2" 
                            FontSize="20"/>
                </Grid>

                <!-- Report Button -->
                <Button Text="{extensions:Translate Report}" 
                        Command="{Binding ReportProductCommand}" 
                        IsVisible="{Binding IsOwner, Converter={StaticResource InvertedBoolConverter}}"
                        HorizontalOptions="End" 
                        VerticalOptions="Start" 
                        BackgroundColor="Transparent" 
                        TextColor="{StaticResource Danger}" 
                        FontSize="13" 
                        WidthRequest="100" 
                        HeightRequest="40" 
                        Margin="0,-330,20,0" 
                        InputTransparent="False" 
                        ZIndex="10"/>
            </Grid>
        </Border>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="2" IsVisible="{Binding IsLoading}" BackgroundColor="#80000000" InputTransparent="False">
            <Border BackgroundColor="White"
                    WidthRequest="100"
                    HeightRequest="100"
                    StrokeThickness="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.15" Radius="15" Offset="0,8"/>
                </Border.Shadow>
                <ActivityIndicator IsRunning="True" 
                                   Color="{StaticResource Primary}" 
                                   WidthRequest="40" 
                                   HeightRequest="40"/>
            </Border>
        </Grid>
    </Grid>
</ContentPage>