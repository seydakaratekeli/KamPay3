<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KamPay.ViewModels"
             xmlns:models="clr-namespace:KamPay.Models"
             xmlns:conv="clr-namespace:KamPay.Converters"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
             xmlns:extensions="clr-namespace:KamPay.Extensions"
             x:Class="KamPay.Views.AddProductPage"
             x:DataType="vm:AddProductViewModel"
             Title="{extensions:Translate AddProduct}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:IsNotNullOrEmptyConverter x:Key="IsNotNullOrEmptyConverter" />
            <conv:ProductCategoryToTextConverter x:Key="ProductCategoryToTextConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <!-- Gradient Background Header -->
        <BoxView VerticalOptions="Start" HeightRequest="200">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1E88E5" Offset="0.0" />
                    <GradientStop Color="#1565C0" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- Animated Background Circle -->
        <Ellipse x:Name="Circle1" 
                 WidthRequest="250" 
                 HeightRequest="250"
                 Fill="White"
                 Opacity="0.05"
                 HorizontalOptions="End"
                 VerticalOptions="Start"
                 Margin="0,-100,-100,0"/>

        <ScrollView>
            <VerticalStackLayout x:Name="MainContent" Spacing="0">

                <!-- Header Section -->
                <VerticalStackLayout x:Name="HeaderSection" Spacing="12" Padding="20,50,20,30">
                    <Label Text="📦" FontSize="48" HorizontalOptions="Center"/>
                    <Label Text="{extensions:Translate AddProduct}"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"/>
                    <Label Text="Ürününüzü ekleyin ve paylaşın"
                           FontSize="14"
                           TextColor="White"
                           Opacity="0.9"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Main Form Card -->
                <Border x:Name="FormCard"
                        BackgroundColor="White"
                        StrokeThickness="0"
                        Padding="20"
                        Margin="15,-20,15,20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.15" Radius="20" Offset="0,8"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="18">

                        <!-- Error Message -->
                        <Border IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                                BackgroundColor="#FFEBEE"
                                StrokeThickness="0"
                                Padding="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Label Text="{Binding ErrorMessage}"
                                   TextColor="#EF5350"
                                   FontSize="13"
                                   FontAttributes="Bold"/>
                        </Border>

                        <!-- Upload Progress -->
                        <Border IsVisible="{Binding IsLoading}"
                                BackgroundColor="#E3F2FD"
                                StrokeThickness="0"
                                Padding="16">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <Label Text="{Binding UploadProgress}"
                                       TextColor="#1976D2"
                                       FontSize="14"
                                       FontAttributes="Bold"/>
                                <ProgressBar Progress="{Binding UploadPercentage}"
                                             ProgressColor="#2196F3"
                                             HeightRequest="8"/>
                                <Label Text="{Binding UploadPercentage, StringFormat='{0:P0}'}"
                                       TextColor="#1976D2"
                                       FontSize="12"
                                       HorizontalTextAlignment="End"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Product Info Section -->
                        <Label Text="{extensions:Translate ProductInfoTitle}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#212121"/>

                        <!-- Title Input -->
                        <Border BackgroundColor="#F5F9FC" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Entry Placeholder="{extensions:Translate ProductTitlePlaceholder}"
                                   Text="{Binding Title}"
                                   MaxLength="100"
                                   FontSize="15"
                                   TextColor="#212121"
                                   PlaceholderColor="#9E9E9E"
                                   BackgroundColor="Transparent"
                                   HeightRequest="48"
                                   Margin="16,0"/>
                        </Border>

                        <!-- Description Input -->
                        <Border BackgroundColor="#F5F9FC" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Editor Placeholder="{extensions:Translate ProductDescriptionPlaceholder}"
                                    Text="{Binding Description}"
                                    MinimumHeightRequest="100"
                                    MaxLength="1000"
                                    FontSize="15"
                                    TextColor="#212121"
                                    PlaceholderColor="#9E9E9E"
                                    BackgroundColor="Transparent"
                                    AutoSize="TextChanges"
                                    Margin="16,8"/>
                        </Border>

                        <!-- Category Picker -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{extensions:Translate CategoryLabel}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#757575"/>
                            <Border BackgroundColor="#F5F9FC" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Picker ItemsSource="{Binding Categories}"
                                        SelectedItem="{Binding SelectedCategory}"
                                        FontSize="15"
                                        TextColor="#212121"
                                        Title="{extensions:Translate SelectCategoryTitle}"
                                        BackgroundColor="Transparent"
                                        Margin="16,0"
                                        HeightRequest="48">
                                    <Picker.ItemDisplayBinding>
                                        <Binding Path="Name" Converter="{StaticResource ProductCategoryToTextConverter}"/>
                                    </Picker.ItemDisplayBinding>
                                </Picker>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Product Type Picker -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{extensions:Translate ProductType}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#757575"/>
                            <Border BackgroundColor="#F5F9FC" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Picker ItemsSource="{Binding TypeStrings}"
                                        SelectedIndex="{Binding SelectedTypeIndex}"
                                        FontSize="15"
                                        TextColor="#212121"
                                        Title="{extensions:Translate SelectTypeTitle}"
                                        BackgroundColor="Transparent"
                                        Margin="16,0"
                                        HeightRequest="48"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Surprise Box Toggle -->
                        <Border IsVisible="{Binding IsDonationTypeSelected}"
                                BackgroundColor="#FFF3E0"
                                StrokeThickness="0"
                                Padding="16">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <HorizontalStackLayout Spacing="12">
                                <Label Text="🎁" FontSize="24" VerticalOptions="Center"/>
                                <Label Text="{extensions:Translate DonateToSurpriseBox}"
                                       VerticalOptions="Center"
                                       TextColor="#E65100"
                                       FontSize="14"
                                       HorizontalOptions="StartAndExpand"/>
                                <Switch IsToggled="{Binding IsForSurpriseBox}"
                                        OnColor="#FF9800"
                                        VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Price Input -->
                        <Border IsVisible="{Binding ShowPriceField}"
                                BackgroundColor="#F5F9FC"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Grid Padding="16,0" ColumnDefinitions="*,Auto">
                                <Entry Grid.Column="0"
                                       Placeholder="{extensions:Translate PricePlaceholder}"
                                       Text="{Binding Price}"
                                       Keyboard="Numeric"
                                       FontSize="15"
                                       TextColor="#212121"
                                       PlaceholderColor="#9E9E9E"
                                       BackgroundColor="Transparent"
                                       HeightRequest="48"/>
                                <Label Grid.Column="1"
                                       Text="₺"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="#1E88E5"
                                       VerticalOptions="Center"
                                       Margin="0,0,8,0"/>
                            </Grid>
                        </Border>

                        <!-- Exchange Preference -->
                        <Border IsVisible="{Binding ShowExchangeField}"
                                BackgroundColor="#F5F9FC"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Entry Placeholder="{extensions:Translate ExchangePreferencePlaceholder}"
                                   Text="{Binding ExchangePreference}"
                                   FontSize="15"
                                   TextColor="#212121"
                                   PlaceholderColor="#9E9E9E"
                                   BackgroundColor="Transparent"
                                   HeightRequest="48"
                                   Margin="16,0"/>
                        </Border>

                        <!-- Condition Picker -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{extensions:Translate ConditionTitle}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#757575"/>
                            <Border BackgroundColor="#F5F9FC" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Picker ItemsSource="{Binding ConditionStrings}"
                                        SelectedIndex="{Binding SelectedConditionIndex}"
                                        FontSize="15"
                                        TextColor="#212121"
                                        Title="{extensions:Translate SelectConditionTitle}"
                                        BackgroundColor="Transparent"
                                        Margin="16,0"
                                        HeightRequest="48"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Location Section -->
                        <VerticalStackLayout Spacing="12">
                            <Label Text="{extensions:Translate LocationTitle}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#757575"/>
                            
                            <Border StrokeShape="RoundRectangle 16"
                                    StrokeThickness="0"
                                    HeightRequest="220">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Opacity="0.08" Radius="8" Offset="0,2"/>
                                </Border.Shadow>
                                <Grid>
                                    <mapsui:MapControl x:Name="ProductMap"
                                                       VerticalOptions="FillAndExpand"
                                                       HorizontalOptions="FillAndExpand"/>

                                    <!-- Location Button -->
                                    <Border StrokeShape="RoundRectangle 28"
                                            BackgroundColor="White"
                                            WidthRequest="56"
                                            HeightRequest="56"
                                            HorizontalOptions="End"
                                            VerticalOptions="Start"
                                            Margin="12"
                                            Padding="0">
                                        <Border.Shadow>
                                            <Shadow Brush="Black" Offset="0,4" Radius="8" Opacity="0.2"/>
                                        </Border.Shadow>
                                        <Button Text="📍"
                                                Command="{Binding UseCurrentLocationCommand}"
                                                FontSize="24"
                                                BackgroundColor="Transparent"
                                                TextColor="#1E88E5"
                                                WidthRequest="56"
                                                HeightRequest="56"
                                                Padding="0"/>
                                    </Border>

                                    <!-- Location Display -->
                                    <Border StrokeShape="RoundRectangle 12"
                                            BackgroundColor="White"
                                            Padding="12"
                                            Margin="12"
                                            VerticalOptions="End"
                                            HorizontalOptions="FillAndExpand"
                                            IsVisible="{Binding HasLocation}">
                                        <Border.Shadow>
                                            <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.2"/>
                                        </Border.Shadow>
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="📌" FontSize="16" VerticalOptions="Center"/>
                                            <Label Text="{Binding Location}"
                                                   FontSize="12"
                                                   TextColor="#212121"
                                                   VerticalOptions="Center"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="2"
                                                   HorizontalOptions="FillAndExpand"/>
                                        </HorizontalStackLayout>
                                    </Border>
                                </Grid>
                            </Border>
                            <Label Text="{extensions:Translate MapInstruction}"
                                   FontSize="12"
                                   TextColor="#9E9E9E"/>
                        </VerticalStackLayout>

                        <!-- Images Section -->
                        <VerticalStackLayout Spacing="12">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{extensions:Translate ImagesTitle}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#757575"
                                       VerticalOptions="Center"/>
                                <Label Text="(Tıklayarak önizleyebilirsiniz)"
                                       FontSize="11"
                                       TextColor="#9E9E9E"
                                       VerticalOptions="Center"
                                       Opacity="0.8"/>
                            </HorizontalStackLayout>

                            <Button Text="📷 Resim Ekle"
                                    Command="{Binding PickImagesCommand}"
                                    BackgroundColor="#E3F2FD"
                                    TextColor="#1E88E5"
                                    FontAttributes="Bold"
                                    CornerRadius="12"
                                    HeightRequest="50"
                                    BorderColor="#1E88E5"
                                    BorderWidth="2"/>

                            <FlexLayout BindableLayout.ItemsSource="{Binding ImagePaths}"
                                        Wrap="Wrap"
                                        JustifyContent="Start">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border StrokeShape="RoundRectangle 12"
                                                StrokeThickness="2"
                                                Stroke="#2196F3"
                                                WidthRequest="100"
                                                HeightRequest="100"
                                                Margin="4">
                                            <Border.Shadow>
                                                <Shadow Brush="#2196F3" Opacity="0.2" Radius="8" Offset="0,4"/>
                                            </Border.Shadow>
                                            <Grid>
                                                <!-- ✅ Görsel Önizleme için TapGestureRecognizer -->
                                                <Image Source="{Binding .}" 
                                                       Aspect="AspectFill">
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer 
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AddProductViewModel}}, Path=PreviewImageCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    </Image.GestureRecognizers>
                                                </Image>
                                                
                                                <!-- Silme Butonu -->
                                                <Button Text="✕"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AddProductViewModel}}, Path=RemoveImageCommand}"
                                                        CommandParameter="{Binding .}"
                                                        BackgroundColor="#EF5350"
                                                        TextColor="White"
                                                        FontSize="16"
                                                        FontAttributes="Bold"
                                                        WidthRequest="32"
                                                        HeightRequest="32"
                                                        CornerRadius="16"
                                                        Padding="0"
                                                        HorizontalOptions="End"
                                                        VerticalOptions="Start"
                                                        Margin="4">
                                                    <Button.Shadow>
                                                        <Shadow Brush="Black" Opacity="0.3" Radius="4" Offset="0,2"/>
                                                    </Button.Shadow>
                                                </Button>
                                                
                                                <!-- Önizleme İkonu -->
                                                <Border BackgroundColor="#CC2196F3"
                                                        WidthRequest="28"
                                                        HeightRequest="28"
                                                        StrokeThickness="0"
                                                        HorizontalOptions="Start"
                                                        VerticalOptions="Start"
                                                        Margin="4">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="14"/>
                                                    </Border.StrokeShape>
                                                    <Label Text="🔍"
                                                           FontSize="14"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>

                        <!-- Action Buttons -->
                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="12"
                              Margin="0,20,0,0">
                            <Button Grid.Column="0"
                                    Text="{extensions:Translate CancelButton}"
                                    Command="{Binding CancelCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="#757575"
                                    BorderColor="#E0E0E0"
                                    BorderWidth="2"
                                    CornerRadius="12"
                                    FontAttributes="Bold"
                                    HeightRequest="54"/>

                            <Button Grid.Column="1"
                                    Text="{extensions:Translate SaveButton}"
                                    Command="{Binding SaveProductCommand}"
                                    BackgroundColor="#1E88E5"
                                    TextColor="White"
                                    CornerRadius="12"
                                    FontAttributes="Bold"
                                    HeightRequest="54">
                                <Button.Shadow>
                                    <Shadow Brush="#1E88E5" Opacity="0.3" Radius="10" Offset="0,4"/>
                                </Button.Shadow>
                            </Button>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading Overlay -->
        <Grid IsVisible="{Binding IsLoading}"
              BackgroundColor="#80000000"
              ZIndex="999"
              InputTransparent="False">
            <Border BackgroundColor="White"
                    WidthRequest="140"
                    HeightRequest="140"
                    StrokeThickness="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.2" Radius="20" Offset="0,10"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="12"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <ActivityIndicator IsRunning="True"
                                       Color="#1E88E5"
                                       WidthRequest="40"
                                       HeightRequest="40"/>
                    <Label Text="{Binding UploadProgress}"
                           TextColor="#1E88E5"
                           FontSize="12"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           IsVisible="{Binding UploadProgress, Converter={StaticResource IsNotNullOrEmptyConverter}}"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>