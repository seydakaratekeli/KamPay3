<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KamPay.ViewModels"
             xmlns:models="clr-namespace:KamPay.Models"
             xmlns:conv="clr-namespace:KamPay.Converters"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
             xmlns:extensions="clr-namespace:KamPay.Extensions"
             x:Class="KamPay.Views.AddProductPage"
             x:DataType="vm:AddProductViewModel"
             Title="{extensions:Translate AddProduct}"
             Shell.BackgroundColor="#4CAF50">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:IsNotNullOrEmptyConverter x:Key="IsNotNullOrEmptyConverter" />
            <conv:ProductCategoryToTextConverter x:Key="ProductCategoryToTextConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="15">

                <Frame IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                       BackgroundColor="#FFEBEE"
                       BorderColor="#F44336"
                       Padding="10"
                       CornerRadius="8">
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="#C62828"
                           FontSize="14" />
                </Frame>

                <Frame IsVisible="{Binding IsLoading}"
                       BackgroundColor="#E3F2FD"
                       BorderColor="#2196F3"
                       Padding="15"
                       CornerRadius="8">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding UploadProgress}"
                               TextColor="#1976D2"
                               FontSize="14"
                               FontAttributes="Bold" />
                        <ProgressBar Progress="{Binding UploadPercentage}"
                                     ProgressColor="#2196F3"
                                     HeightRequest="8" />
                        <Label Text="{Binding UploadPercentage, StringFormat='{0:P0}'}"
                               TextColor="#1976D2"
                               FontSize="12"
                               HorizontalTextAlignment="End" />
                    </VerticalStackLayout>
                </Frame>

                <Label Text="{extensions:Translate ProductInfoTitle}" 
                       FontSize="20" 
                       FontAttributes="Bold"
                       TextColor="#333" />

                <Frame Padding="0" 
                       BorderColor="#E0E0E0"
                       CornerRadius="8">
                    <Entry Placeholder="{extensions:Translate ProductTitlePlaceholder}"
                           Text="{Binding Title}"
                           MaxLength="100"
                           FontSize="16" />
                </Frame>

                <Frame Padding="0" 
                       BorderColor="#E0E0E0"
                       CornerRadius="8">
                    <Editor Placeholder="{extensions:Translate ProductDescriptionPlaceholder}"
                            Text="{Binding Description}"
                            HeightRequest="120"
                            MaxLength="1000"
                            FontSize="16"
                            AutoSize="TextChanges" />
                </Frame>

                <Label Text="{extensions:Translate CategoryLabel}" 
                       FontSize="16" 
                       FontAttributes="Bold"
                       TextColor="#666" />

                <Frame Padding="0" 
                       BorderColor="#E0E0E0"
                       CornerRadius="8">
                    <Picker ItemsSource="{Binding Categories}"
                            SelectedItem="{Binding SelectedCategory}"
                            FontSize="16"
                            Title="{extensions:Translate SelectCategoryTitle}">
                        <Picker.ItemDisplayBinding>
                            <Binding Path="Name" Converter="{StaticResource ProductCategoryToTextConverter}" />
                        </Picker.ItemDisplayBinding>
                    </Picker>
                </Frame>

                <Label Text="{extensions:Translate ProductType}" 
                       FontSize="16" 
                       FontAttributes="Bold"
                       TextColor="#666" />

                <Frame Padding="0" 
                       BorderColor="#E0E0E0"
                       CornerRadius="8">
                    <Picker ItemsSource="{Binding TypeStrings}"
                            SelectedIndex="{Binding SelectedTypeIndex}"
                            FontSize="16"
                            Title="{extensions:Translate SelectTypeTitle}">
                    </Picker>
                </Frame>

                <StackLayout Orientation="Horizontal" 
                             Padding="5,10" 
                             IsVisible="{Binding IsDonationTypeSelected}">
                    <Label Text="{extensions:Translate DonateToSurpriseBox}" 
                           VerticalOptions="Center"
                           TextColor="#333"/>
                    <Switch IsToggled="{Binding IsForSurpriseBox}" 
                            HorizontalOptions="EndAndExpand"
                            OnColor="#4CAF50"/>
                </StackLayout>

                <Frame IsVisible="{Binding ShowPriceField}"
                       Padding="0" 
                       BorderColor="#E0E0E0"
                       CornerRadius="8">
                    <HorizontalStackLayout Padding="10">
                        <Entry Placeholder="{extensions:Translate PricePlaceholder}"
                               Text="{Binding Price}"
                               Keyboard="Numeric"
                               FontSize="16"
                               HorizontalOptions="FillAndExpand" />
                        <Label Text="₺" 
                               VerticalOptions="Center"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#4CAF50" />
                    </HorizontalStackLayout>
                </Frame>

                <Frame IsVisible="{Binding ShowExchangeField}"
                       Padding="0" 
                       BorderColor="#E0E0E0"
                       CornerRadius="8">
                    <Entry Placeholder="{extensions:Translate ExchangePreferencePlaceholder}"
                           Text="{Binding ExchangePreference}"
                           FontSize="16" />
                </Frame>

                <Label Text="{extensions:Translate ConditionTitle}" 
                       FontSize="16" 
                       FontAttributes="Bold"
                       TextColor="#666" />

                <Frame Padding="0" 
                       BorderColor="#E0E0E0"
                       CornerRadius="8">
                    <Picker ItemsSource="{Binding ConditionStrings}"
                            SelectedIndex="{Binding SelectedConditionIndex}"
                            FontSize="16"
                            Title="{extensions:Translate SelectConditionTitle}">
                    </Picker>
                </Frame>

                <Label Text="{extensions:Translate LocationTitle}"
                       FontSize="16" 
                       FontAttributes="Bold"
                       TextColor="#666" />

                <Border StrokeShape="RoundRectangle 12" 
                        StrokeThickness="0"
                        HeightRequest="250"
                        Margin="0,8,0,0">
                    <Grid>
                        <mapsui:MapControl x:Name="ProductMap"
                                           VerticalOptions="FillAndExpand"
                                           HorizontalOptions="FillAndExpand" />

                        <VerticalStackLayout HorizontalOptions="End" 
                                            VerticalOptions="Start"
                                            Margin="12"
                                            Spacing="8">
                            <Border StrokeShape="RoundRectangle 20"
                                    BackgroundColor="White"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    Padding="0">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.2"/>
                                </Border.Shadow>
                                <Button Text="📍"
                                        Command="{Binding UseCurrentLocationCommand}"
                                        FontSize="18"
                                        BackgroundColor="Transparent"
                                        TextColor="#4CAF50"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        Padding="0"/>
                            </Border>
                        </VerticalStackLayout>

                        <Border StrokeShape="RoundRectangle 12"
                                BackgroundColor="#F5F5F5"
                                Padding="12,8"
                                Margin="12"
                                VerticalOptions="End"
                                HorizontalOptions="FillAndExpand"
                                IsVisible="{Binding HasLocation}">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.2"/>
                            </Border.Shadow>
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="📌" 
                                       FontSize="16"
                                       VerticalOptions="Center"/>
                                <Label Text="{Binding Location}"
                                       FontSize="12"
                                       TextColor="#333"
                                       VerticalOptions="Center"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2"
                                       HorizontalOptions="FillAndExpand"/>
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </Border>

                <Label Text="{extensions:Translate MapInstruction}"
                       FontSize="12"
                       TextColor="{StaticResource Gray600}"
                       Margin="0,4,0,0"/>

                <Label Text="{extensions:Translate ImagesTitle}" 
                       FontSize="16" 
                       FontAttributes="Bold"
                       TextColor="#666" />

                <Button Text="{extensions:Translate AddImageButton}"
                        Command="{Binding PickImagesCommand}"
                        BackgroundColor="#2196F3"
                        TextColor="White"
                        CornerRadius="8"
                        HeightRequest="50" />

                <FlexLayout BindableLayout.ItemsSource="{Binding ImagePaths}"
                            Wrap="Wrap"
                            JustifyContent="Start"
                            AlignItems="Start">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="5"
                                   Margin="5"
                                   CornerRadius="8"
                                   WidthRequest="100"
                                   HeightRequest="100">
                                <Grid>
                                    <Image Source="{Binding .}"
                                           Aspect="AspectFill" />
                                    <Button Text="✕"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AddProductViewModel}}, Path=RemoveImageCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#F44336"
                                            TextColor="White"
                                            WidthRequest="30"
                                            HeightRequest="30"
                                            CornerRadius="15"
                                            HorizontalOptions="End"
                                            VerticalOptions="Start"
                                            Margin="5" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <Grid ColumnDefinitions="*,*" 
                      ColumnSpacing="10"
                      Margin="0,20,0,0">
                    <Button Grid.Column="0"
                            Text="{extensions:Translate CancelButton}"
                            Command="{Binding CancelCommand}"
                            BackgroundColor="#757575"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="50" />

                    <Button Grid.Column="1"
                            Text="{extensions:Translate SaveButton}"
                            Command="{Binding SaveProductCommand}"
                            BackgroundColor="#4CAF50"
                            TextColor="White"
                            CornerRadius="8"
                            HeightRequest="50" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <Grid IsVisible="{Binding IsLoading}"
              BackgroundColor="#80000000"
              InputTransparent="False">
            <VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="15">
                <ActivityIndicator IsRunning="True"
                                   Color="White"
                                   WidthRequest="50"
                                   HeightRequest="50" />
                <Label Text="{Binding UploadProgress}"
                       TextColor="White"
                       FontSize="16"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       IsVisible="{Binding UploadProgress, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
            </VerticalStackLayout>
        </Grid>
    </Grid>

</ContentPage>