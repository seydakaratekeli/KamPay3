<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KamPay.ViewModels"
             xmlns:models="clr-namespace:KamPay.Models"
             xmlns:converters="clr-namespace:KamPay.Converters"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
             x:Class="KamPay.Views.GoodDeedPostDetailPage"
             x:DataType="vm:GoodDeedPostDetailViewModel"
             Title="İlan Detayı"
             BackgroundColor="{StaticResource Background}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:BoolToColorConverter x:Key="LikeColorConverter"
                                             TrueColor="{StaticResource Danger}"
                                             FalseColor="{StaticResource TextSecondary}"/>
            <toolkit:IsStringNotNullOrEmptyConverter x:Key="IsStringNotNullOrEmptyConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="15" Padding="15">
                
                <Border StrokeShape="RoundRectangle 16"
                        StrokeThickness="0"
                        BackgroundColor="White"
                        Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="10" Opacity="0.1"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="15">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Grid.Column="0" 
                                   Text="{Binding Post.Title}" 
                                   FontAttributes="Bold" 
                                   FontSize="20" 
                                   TextColor="{StaticResource TextPrimary}"/>
                            <Border Grid.Column="1" 
                                    BackgroundColor="#E3F2FD" 
                                    Padding="10,5" 
                                    StrokeThickness="0"
                                    VerticalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Label Text="{Binding Post.Type, Converter={StaticResource PostTypeToTextConverter}}" 
                                       FontSize="12" 
                                       TextColor="{StaticResource Primary}" 
                                       FontAttributes="Bold"/>
                            </Border>
                        </Grid>

                        <Label Text="{Binding Post.Description}" 
                               TextColor="{StaticResource TextSecondary}"
                               FontSize="16"/>

                        <!-- Post Image -->
                        <Border IsVisible="{Binding Post.ImageUrl, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                Margin="0,10,0,0">
                            <ffimageloading:CachedImage Source="{Binding Post.ImageUrl}" 
                                                        Aspect="AspectFill" 
                                                        HeightRequest="250"
                                                        LoadingPlaceholder="image_placeholder.png"
                                                        ErrorPlaceholder="image_placeholder.png"/>
                        </Border>

                        <!-- User Info -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,10,0,0">
                            <ffimageloading:CachedImage Grid.Column="0"
                                                        Source="{Binding Post.UserProfileImageUrl}" 
                                                        Aspect="AspectFill" 
                                                        HeightRequest="50" 
                                                        WidthRequest="50" 
                                                        LoadingPlaceholder="person_icon.svg" 
                                                        ErrorPlaceholder="person_icon.svg"
                                                        VerticalOptions="Center">
                                <ffimageloading:CachedImage.Clip>
                                    <EllipseGeometry Center="25,25" RadiusX="25" RadiusY="25" />
                                </ffimageloading:CachedImage.Clip>
                            </ffimageloading:CachedImage>

                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Post.UserName}" 
                                       FontSize="15" 
                                       FontAttributes="Bold" 
                                       TextColor="{StaticResource TextPrimary}"/>
                                <Label Text="{Binding Post.CreatedAt, Converter={StaticResource DateTimeToTimeAgoConverter}}" 
                                       FontSize="12" 
                                       TextColor="{StaticResource TextSecondary}"/>
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" Margin="0,10"/>

                        <!-- Action Buttons -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0"
                                    Text="{Binding Post.LikeCount, StringFormat='Beğen ({0})'}"
                                    Command="{Binding LikePostCommand}"
                                    BackgroundColor="{StaticResource Background}"
                                    TextColor="{StaticResource TextPrimary}"/>
                            
                            <Button Grid.Column="1"
                                    Text="Mesaj Gönder"
                                    IsVisible="{Binding IsOwner, Converter={StaticResource InvertedBoolConverter}}"
                                    Command="{Binding SendMessageCommand}"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="White"/>
                        </Grid>

                        <!-- Owner Buttons -->
                        <VerticalStackLayout Spacing="10" IsVisible="{Binding IsOwner}" Margin="0,10,0,0">
                            <Button Text="✏️ Düzenle"
                                    Command="{Binding EditPostCommand}"
                                    BackgroundColor="{StaticResource Warning}"
                                    TextColor="White"/>
                            <Button Text="✅ İyilik Yapıldı / Tamamlandı"
                                    Command="{Binding MarkAsCompletedCommand}"
                                    BackgroundColor="{StaticResource Success}"
                                    TextColor="White"/>
                            <Button Text="🚫 İlanı Kapat"
                                    Command="{Binding ClosePostCommand}"
                                    BackgroundColor="{StaticResource Danger}"
                                    TextColor="White"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Comments Section -->
                <Label Text="{Binding Post.CommentCount, StringFormat='Yorumlar ({0})'}" 
                       FontAttributes="Bold" 
                       FontSize="18" 
                       TextColor="{StaticResource TextPrimary}"
                       Margin="5,10,0,0"/>

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Post.Comments.Values}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Comment">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <ffimageloading:CachedImage Grid.Column="0"
                                                            Source="{Binding UserProfileImageUrl}" 
                                                            Aspect="AspectFill" 
                                                            HeightRequest="40" 
                                                            WidthRequest="40" 
                                                            LoadingPlaceholder="person_icon.svg" 
                                                            ErrorPlaceholder="person_icon.svg">
                                    <ffimageloading:CachedImage.Clip>
                                        <EllipseGeometry Center="20,20" RadiusX="20" RadiusY="20" />
                                    </ffimageloading:CachedImage.Clip>
                                </ffimageloading:CachedImage>

                                <Border Grid.Column="1" 
                                        StrokeShape="RoundRectangle 12" 
                                        StrokeThickness="0" 
                                        BackgroundColor="White" 
                                        Padding="12">
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Offset="0,1" Radius="5" Opacity="0.05"/>
                                    </Border.Shadow>
                                    <VerticalStackLayout Spacing="4">
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{Binding UserName}" 
                                                   FontAttributes="Bold" 
                                                   FontSize="13" 
                                                   TextColor="{StaticResource TextPrimary}"/>
                                            <Label Text="•" 
                                                   TextColor="{StaticResource TextSecondary}" 
                                                   FontSize="11"/>
                                            <Label Text="{Binding CreatedAt, Converter={StaticResource DateTimeToTimeAgoConverter}}" 
                                                   TextColor="{StaticResource TextSecondary}" 
                                                   FontSize="11"/>
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding Text}" 
                                               FontSize="14" 
                                               TextColor="{StaticResource TextPrimary}"/>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Comment Input Box -->
        <Border Grid.Row="1"
                StrokeThickness="0"
                Padding="15,10"
                BackgroundColor="White">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,-2" Radius="10" Opacity="0.1"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Border Grid.Column="0"
                        StrokeShape="RoundRectangle 20" 
                        Stroke="{StaticResource BorderColor}" 
                        StrokeThickness="1"
                        Padding="15,0" 
                        HeightRequest="50"
                        BackgroundColor="{StaticResource Background}">
                    <Entry Placeholder="Yorum yaz..." 
                           Text="{Binding Post.DraftComment}" 
                           ReturnCommand="{Binding AddCommentCommand}" 
                           BackgroundColor="Transparent"
                           TextColor="{StaticResource TextPrimary}"
                           PlaceholderColor="{StaticResource TextSecondary}"/>
                </Border>
                <Button Grid.Column="1"
                        Text="Gönder"
                        Command="{Binding AddCommentCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        CornerRadius="20"
                        HeightRequest="50"/>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
