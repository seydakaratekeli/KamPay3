<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="KamPay.Views.ImageViewerPage"
             x:Name="ImageViewerPageRoot"
             Title="Fotoğraf"
             BackgroundColor="#0A0F1E"
             Shell.NavBarIsVisible="False">

    <!-- Modern Tam Ekran Fotoğraf Görüntüleme - Pinch to Zoom -->
    
    <Grid>
        <!-- Animated Background Gradient -->
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0A0F1E" Offset="0.0" />
                    <GradientStop Color="#1A1F3A" Offset="0.5" />
                    <GradientStop Color="#0A0F1E" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- Rotating Background Circles -->
        <Grid x:Name="BackgroundCircles" IsVisible="True" Opacity="0.08">
            <shapes:Ellipse x:Name="Circle1"
                            Fill="#2196F3"
                            WidthRequest="300"
                            HeightRequest="300"
                            Opacity="0.2"
                            TranslationX="-100"
                            TranslationY="-150"
                            HorizontalOptions="Start"
                            VerticalOptions="Start" />
            
            <shapes:Ellipse x:Name="Circle2"
                            Fill="#64B5F6"
                            WidthRequest="250"
                            HeightRequest="250"
                            Opacity="0.15"
                            TranslationX="80"
                            TranslationY="200"
                            HorizontalOptions="End"
                            VerticalOptions="End" />
        </Grid>

        <!-- Main Content Container -->
        <Grid x:Name="MainContainer">
            <!-- Loading Indicator -->
            <Grid IsVisible="{Binding IsLoading}"
                  BackgroundColor="#80000000"
                  ZIndex="1000">
                <VerticalStackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="15">
                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       Color="#2196F3"
                                       WidthRequest="60"
                                       HeightRequest="60" />
                    <Label Text="Yükleniyor..."
                           FontSize="16"
                           TextColor="White"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Grid>

            <!-- Image Carousel for browsing multiple images -->
            <CarouselView x:Name="ImageCarousel"
                          ItemsSource="{Binding ProductImages}"
                          Position="{Binding SelectedIndex}"
                          Loop="False">
                <CarouselView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Image Source="{Binding .}"
                                   Aspect="AspectFit"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center"
                                   BackgroundColor="Transparent">
                                <Image.GestureRecognizers>
                                    <PinchGestureRecognizer PinchUpdated="OnPinchUpdated" />
                                    <PanGestureRecognizer PanUpdated="OnPanUpdated" />
                                    <TapGestureRecognizer Tapped="OnImageTapped" NumberOfTapsRequired="2" />
                                    <TapGestureRecognizer Tapped="OnSingleTap" NumberOfTapsRequired="1" />
                                </Image.GestureRecognizers>
                            </Image>
                        </Grid>
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>

            <!-- Top Control Bar -->
            <Border x:Name="TopBar"
                    HeightRequest="80"
                    VerticalOptions="Start"
                    HorizontalOptions="Fill"
                    Padding="0"
                    StrokeThickness="0"
                    BackgroundColor="Transparent">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#DD000000" Offset="0.0" />
                        <GradientStop Color="#00000000" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid Padding="15,30,15,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Close Button -->
                    <Border Grid.Column="1"
                            WidthRequest="40"
                            HeightRequest="40"
                            StrokeThickness="0"
                            BackgroundColor="#80000000">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20"/>
                        </Border.StrokeShape>
                        <Button Text="✕"
                                Command="{Binding CloseCommand}"
                                BackgroundColor="Transparent"
                                TextColor="White"
                                FontSize="20"
                                FontAttributes="Bold"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill"
                                Scale="1">
                            <Button.Triggers>
                                <Trigger TargetType="Button" Property="IsPressed" Value="True">
                                    <Setter Property="Scale" Value="0.9" />
                                    <Setter Property="Opacity" Value="0.7" />
                                </Trigger>
                            </Button.Triggers>
                        </Button>
                    </Border>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</ContentPage>
