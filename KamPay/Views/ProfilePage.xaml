<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KamPay.ViewModels"
             xmlns:models="clr-namespace:KamPay.Models"
             xmlns:converters="clr-namespace:KamPay.Converters"
             xmlns:res="clr-namespace:KamPay.Services"
             xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
             x:Class="KamPay.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F5F9FC">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#1E88E5</Color>
            <Color x:Key="PrimaryDark">#1565C0</Color>
            <Color x:Key="Surface">#FFFFFF</Color>
            <Color x:Key="Background">#F5F9FC</Color>
            <Color x:Key="TextPrimary">#212121</Color>
            <Color x:Key="TextSecondary">#757575</Color>
            <Color x:Key="BorderColor">#E0E0E0</Color>
            <Color x:Key="AccentOrange">#FF9800</Color>
            <Color x:Key="AccentPurple">darkred</Color>
            <Color x:Key="AccentRed">#F44336</Color>

            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
            <converters:ColorToLightConverter x:Key="ColorToLightConverter" />
            <converters:FirstCharConverter x:Key="FirstCharConverter" />
            <converters:StringToColorConverter x:Key="StringToColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- ✨ HEADER WITH GRADIENT BACKGROUND -->
        <Grid Grid.Row="0" RowDefinitions="Auto" x:Name="HeaderSection">
            <!-- Gradient Background -->
            <BoxView>
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1E88E5" Offset="0.0" />
                        <GradientStop Color="#1565C0" Offset="1.0" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

            <!-- Animated Background Circle -->
            <Ellipse x:Name="Circle1" 
                     WidthRequest="200" 
                     HeightRequest="200"
                     Fill="White"
                     Opacity="0.05"
                     HorizontalOptions="End"
                     VerticalOptions="Start"
                     Margin="0,-80,-80,0"/>

            <Grid Padding="20,50,20,30" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="15">

                <!-- Profile Picture with Edit Icon -->
                <Grid Grid.Row="0" HorizontalOptions="Center" x:Name="ProfileImageSection">
                    <Border StrokeThickness="4"
                            Stroke="White"
                            WidthRequest="110"
                            HeightRequest="110"
                            BackgroundColor="White">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="55"/>
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,4" Radius="15" Opacity="0.2"/>
                        </Border.Shadow>
                        <Grid>
                            <ffimageloading:CachedImage 
                                Source="{Binding CurrentUser.ProfileImageUrl}" 
                                Aspect="AspectFill"
                                IsVisible="{Binding HasProfileImage}"
                                LoadingPlaceholder="person_icon.svg"
                                ErrorPlaceholder="person_icon.svg"
                                DownsampleToViewSize="True"
                                CacheDuration="7">
                                <ffimageloading:CachedImage.Clip>
                                    <EllipseGeometry Center="55,55" RadiusX="55" RadiusY="55"/>
                                </ffimageloading:CachedImage.Clip>
                            </ffimageloading:CachedImage>

                            <Label Text="{Binding CurrentUser.FullName, Converter={StaticResource FirstCharConverter}}" 
                                   FontSize="42" 
                                   FontAttributes="Bold" 
                                   TextColor="{StaticResource Primary}" 
                                   HorizontalTextAlignment="Center" 
                                   VerticalTextAlignment="Center"
                                   IsVisible="{Binding HasProfileImage, Converter={StaticResource InvertedBoolConverter}}" />
                        </Grid>
                    </Border>

                    <!-- Edit Icon -->
                    <Border StrokeShape="RoundRectangle 18"
                            BackgroundColor="White"
                            WidthRequest="36"
                            HeightRequest="36"
                            StrokeThickness="0"
                            HorizontalOptions="End"
                            VerticalOptions="End"
                            Margin="0,0,0,0">
                        <Border.Shadow>
                            <Shadow Brush="{StaticResource Primary}" Offset="0,2" Radius="8" Opacity="0.3"/>
                        </Border.Shadow>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding EditProfileCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="✏️" 
                               FontSize="18" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- Name -->
                <Label Grid.Row="1" 
                       Text="{Binding CurrentUser.FullName}" 
                       FontSize="26" 
                       FontAttributes="Bold" 
                       TextColor="White" 
                       HorizontalTextAlignment="Center" 
                       x:Name="NameLabel"/>

                <!-- Email -->
                <Label Grid.Row="2" 
                       Text="{Binding CurrentUser.Email}" 
                       FontSize="14" 
                       TextColor="White" 
                       Opacity="0.9" 
                       HorizontalTextAlignment="Center"
                       x:Name="EmailLabel"/>

                <!-- Stats Grid -->
                <Grid Grid.Row="3" 
                      ColumnDefinitions="*,*,*" 
                      ColumnSpacing="12" 
                      Margin="0,5,0,0"
                      x:Name="StatsSection">
                    <Border Grid.Column="0" 
                            StrokeShape="RoundRectangle 15"
                            StrokeThickness="0"
                            BackgroundColor="White"
                            Padding="15">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.1"/>
                        </Border.Shadow>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="5">
                            <Label Text="{Binding UserStats.TotalProducts}" 
                                   FontSize="24" 
                                   FontAttributes="Bold" 
                                   TextColor="{StaticResource Primary}" 
                                   HorizontalTextAlignment="Center" />
                            <Label Text="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[Product]}" 
                                   FontSize="11" 
                                   TextColor="{StaticResource TextSecondary}" 
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" 
                            StrokeShape="RoundRectangle 15"
                            StrokeThickness="0"
                            BackgroundColor="White"
                            Padding="15">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.1"/>
                        </Border.Shadow>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="5">
                            <Label Text="{Binding UserStats.Points}" 
                                   FontSize="24" 
                                   FontAttributes="Bold" 
                                   TextColor="{StaticResource AccentOrange}" 
                                   HorizontalTextAlignment="Center" />
                            <Label Text="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[Points]}" 
                                   FontSize="11" 
                                   TextColor="{StaticResource TextSecondary}" 
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="2" 
                            StrokeShape="RoundRectangle 15"
                            StrokeThickness="0"
                            BackgroundColor="White"
                            Padding="15">
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.1"/>
                        </Border.Shadow>
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="5">
                            <Label Text="{Binding MyBadges.Count}" 
                                   FontSize="24" 
                                   FontAttributes="Bold" 
                                   TextColor="{StaticResource Primary}" 
                                   HorizontalTextAlignment="Center" />
                            <Label Text="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[Badge]}" 
                                   FontSize="11" 
                                   TextColor="{StaticResource TextSecondary}" 
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ✨ MAIN CONTENT -->
        <ScrollView Grid.Row="1" x:Name="ContentSection">
            <VerticalStackLayout Spacing="15" Padding="15">

                <!-- Edit Profile Button -->
                <Button Text="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[EditProfile]}"
                        Command="{Binding EditProfileCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="50">
                    <Button.Shadow>
                        <Shadow Brush="{StaticResource Primary}" Offset="0,4" Radius="8" Opacity="0.3"/>
                    </Button.Shadow>
                </Button>

                <!-- Badges Section -->
                <Border StrokeShape="RoundRectangle 16"
                        StrokeThickness="0"
                        BackgroundColor="White"
                        Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="10" Opacity="0.08"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="15">
                        <Grid ColumnDefinitions="*,Auto">
                            <HorizontalStackLayout Grid.Column="0" Spacing="8">
                                <Label Text="🏆" FontSize="20" />
                                <Label Text="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[MyBadges]}" 
                                       FontSize="18" 
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"/>
                            </HorizontalStackLayout>
                            <Button Grid.Column="1" 
                                    Text="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[All]}" 
                                    Command="{Binding ViewAllBadgesCommand}" 
                                    BackgroundColor="Transparent" 
                                    TextColor="{StaticResource Primary}" 
                                    FontSize="13" 
                                    Padding="0" />
                        </Grid>

                        <FlexLayout BindableLayout.ItemsSource="{Binding MyBadges}" 
                                    Wrap="Wrap" 
                                    JustifyContent="Start" 
                                    AlignItems="Start">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:UserBadge">
                                    <Border Padding="12" 
                                            Margin="5" 
                                            StrokeShape="RoundRectangle 12" 
                                            StrokeThickness="2"
                                            Stroke="{Binding BadgeColor, Converter={StaticResource StringToColorConverter}}" 
                                            BackgroundColor="{Binding BadgeColor, Converter={StaticResource ColorToLightConverter}}">
                                        <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                                            <Label Text="🏅" 
                                                   FontSize="32" 
                                                   HorizontalTextAlignment="Center" />
                                            <Label Text="{Binding BadgeName}" 
                                                   FontSize="10" 
                                                   FontAttributes="Bold" 
                                                   HorizontalTextAlignment="Center" 
                                                   MaxLines="2" 
                                                   LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                            <BindableLayout.EmptyView>
                                <Label Text="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[NoBadgesYet]}" 
                                       FontSize="14" 
                                       TextColor="{StaticResource TextSecondary}" 
                                       HorizontalTextAlignment="Center" 
                                       Margin="0,10" />
                            </BindableLayout.EmptyView>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Products Section -->
                <Border StrokeShape="RoundRectangle 16"
                        StrokeThickness="0"
                        BackgroundColor="White"
                        Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="10" Opacity="0.08"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="15">
                        <Grid ColumnDefinitions="*,Auto">
                            <HorizontalStackLayout Grid.Column="0" Spacing="8">
                                <Label Text="📦" FontSize="20" />
                                <Label Text="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[MyProducts]}" 
                                       FontSize="18" 
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"/>
                            </HorizontalStackLayout>
                            <Button Grid.Column="1" 
                                    Text="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[All]}" 
                                    Command="{Binding ViewAllProductsCommand}" 
                                    BackgroundColor="Transparent" 
                                    TextColor="{StaticResource Primary}" 
                                    FontSize="13" 
                                    Padding="0" />
                        </Grid>

                        <CollectionView ItemsSource="{Binding MyProducts}" 
                                        SelectionMode="None" 
                                        HeightRequest="200">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:Product">
                                    <Border StrokeShape="RoundRectangle 16" 
                                            StrokeThickness="0"
                                            WidthRequest="150" 
                                            BackgroundColor="White">
                                        <Border.Shadow>
                                            <Shadow Brush="Black" Offset="0,2" Radius="8" Opacity="0.08"/>
                                        </Border.Shadow>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProfileViewModel}}, Path=ProductTappedCommand}" 
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout>
                                            <Border StrokeShape="RoundRectangle 16,16,0,0"
                                                    StrokeThickness="0"
                                                    HeightRequest="120">
                                                <Image Source="{Binding ThumbnailUrl}" 
                                                       Aspect="AspectFill"/>
                                            </Border>
                                            <VerticalStackLayout Padding="12" Spacing="5">
                                                <Label Text="{Binding Title}" 
                                                       FontSize="14" 
                                                       FontAttributes="Bold" 
                                                       LineBreakMode="TailTruncation" 
                                                       MaxLines="1"
                                                       TextColor="{StaticResource TextPrimary}"/>
                                                <Label Text="{Binding PriceText}" 
                                                       FontSize="14" 
                                                       TextColor="{StaticResource Primary}" 
                                                       FontAttributes="Bold" />
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Label Text="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[NoProductsYet]}" 
                                       FontSize="14" 
                                       TextColor="{StaticResource TextSecondary}" 
                                       HorizontalTextAlignment="Center" 
                                       VerticalTextAlignment="Center" />
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- Actions Section -->
                <Border StrokeShape="RoundRectangle 16"
                        StrokeThickness="0"
                        BackgroundColor="White"
                        Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="10" Opacity="0.08"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="📜" FontSize="20" />
                            <Label Text="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[MyActions]}" 
                                   FontSize="18" 
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"/>
                        </HorizontalStackLayout>

                        <Button Text="❤️ Favoriler" 
                                Command="{Binding GoToFavoritesCommand}" 
                                BackgroundColor="#2196F3" 
                                TextColor="White"
                                CornerRadius="12"
                                HeightRequest="48"
                                FontAttributes="Bold">
                            <Button.Shadow>
                                <Shadow Brush="#2196F3" Offset="0,2" Radius="6" Opacity="0.3"/>
                            </Button.Shadow>
                        </Button>

                        <Button Text="🔔 Bildirimler" 
                                Command="{Binding GoToNotificationsCommand}" 
                                BackgroundColor="#4CAF50" 
                                TextColor="White"
                                CornerRadius="12"
                                HeightRequest="48"
                                FontAttributes="Bold">
                            <Button.Shadow>
                                <Shadow Brush="#4CAF50" Offset="0,2" Radius="6" Opacity="0.3"/>
                            </Button.Shadow>
                        </Button>

                        <Button Text="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[MyOffers]}" 
                                Command="{Binding GoToOffersCommand}" 
                                BackgroundColor="{StaticResource Primary}" 
                                TextColor="White"
                                CornerRadius="12"
                                HeightRequest="48"
                                FontAttributes="Bold">
                            <Button.Shadow>
                                <Shadow Brush="{StaticResource Primary}" Offset="0,2" Radius="6" Opacity="0.3"/>
                            </Button.Shadow>
                        </Button>

                        <Button Text="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[ServiceRequests]}" 
                                Command="{Binding GoToServiceRequestsCommand}"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                CornerRadius="12"
                                HeightRequest="48"
                                FontAttributes="Bold">
                            <Button.Shadow>
                                <Shadow Brush="{StaticResource Primary}" Offset="0,2" Radius="6" Opacity="0.3"/>
                            </Button.Shadow>
                        </Button>

                        <Button Text="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[LanguageDil]}"
                                Command="{Binding ChangeLanguageCommand}"
                                BackgroundColor="{StaticResource AccentPurple}"
                                TextColor="White"
                                CornerRadius="12"
                                HeightRequest="48"
                                FontAttributes="Bold">
                            <Button.Shadow>
                                <Shadow Brush="{StaticResource AccentPurple}" Offset="0,2" Radius="6" Opacity="0.3"/>
                            </Button.Shadow>
                        </Button>
                    </VerticalStackLayout>
                </Border>

                <!-- Logout Button -->
                <Button Text="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[Logout]}"
                        Command="{Binding LogoutCommand}"
                        BackgroundColor="{StaticResource AccentRed}"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="50"
                        FontAttributes="Bold">
                    <Button.Shadow>
                        <Shadow Brush="{StaticResource AccentRed}" Offset="0,4" Radius="8" Opacity="0.3"/>
                    </Button.Shadow>
                </Button>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="2"
              IsVisible="{Binding IsLoading}"
              BackgroundColor="#F5F9FC"
              ZIndex="1100"
              InputTransparent="False">
            <Border BackgroundColor="White"
                    WidthRequest="100"
                    HeightRequest="100"
                    StrokeThickness="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.15" Radius="15" Offset="0,8"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                    <ActivityIndicator IsRunning="True"
                                       Color="{StaticResource Primary}"
                                       WidthRequest="40"
                                       HeightRequest="40" />
                    <Label Text="Yükleniyor..."
                           TextColor="{StaticResource Primary}"
                           FontSize="13" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
