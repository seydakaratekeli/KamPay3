<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:vm="clr-namespace:KamPay.ViewModels"
               xmlns:models="clr-namespace:KamPay.Models"
               x:Class="KamPay.Views.TradeOfferView"
               x:DataType="vm:TradeOfferViewModel"
               x:Name="thisPopup"
               Color="#80000000">

    <Border BackgroundColor="White"
            StrokeThickness="0"
            Padding="0"
            WidthRequest="340"
            StrokeShape="RoundRectangle 24"
            VerticalOptions="Center"
            HorizontalOptions="Center">
        <Border.Shadow>
            <Shadow Brush="Black" Opacity="0.3" Radius="30" Offset="0,10"/>
        </Border.Shadow>

        <VerticalStackLayout Spacing="0">
            <!-- Header with Gradient -->
            <Grid HeightRequest="80">
                <BoxView>
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="{StaticResource Primary}" Offset="0.0" />
                            <GradientStop Color="{StaticResource PrimaryDark}" Offset="1.0" />
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>

                <VerticalStackLayout Spacing="6" VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Text="🔄" FontSize="32"/>
                    <Label Text="Takas Teklifi Gönder" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           TextColor="White"/>
                </VerticalStackLayout>
            </Grid>

            <!-- Content -->
            <VerticalStackLayout Spacing="20" Padding="20">
                
                <!-- Instruction -->
                <Label Text="Takas için bir ürününü seç" 
                       FontSize="15" 
                       TextColor="{StaticResource TextSecondary}"
                       HorizontalOptions="Center"/>

                <!-- Products List -->
                <Border StrokeShape="RoundRectangle 16"
                        Stroke="{StaticResource Divider}"
                        StrokeThickness="2"
                        Padding="0"
                        HeightRequest="280"
                        BackgroundColor="{StaticResource Background}">
                    <CollectionView ItemsSource="{Binding MyProducts}" 
                                    SelectionMode="Single"
                                    SelectedItem="{Binding SelectedProduct, Mode=TwoWay}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Product">
                                <Border Margin="8"
                                        StrokeShape="RoundRectangle 12"
                                        StrokeThickness="0"
                                        BackgroundColor="White"
                                        Padding="12">
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Opacity="0.05" Radius="8" Offset="0,2"/>
                                    </Border.Shadow>
                                    
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" 
                                                     Binding="{Binding IsSelected, Source={RelativeSource AncestorType={x:Type CollectionView}}}" 
                                                     Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryLightBg}"/>
                                            <Setter Property="Stroke" Value="{StaticResource Primary}"/>
                                            <Setter Property="StrokeThickness" Value="3"/>
                                        </DataTrigger>
                                    </Border.Triggers>

                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border Grid.Column="0"
                                                StrokeShape="RoundRectangle 10"
                                                Padding="0"
                                                WidthRequest="60"
                                                HeightRequest="60"
                                                StrokeThickness="0">
                                            <Image Source="{Binding ThumbnailUrl}" 
                                                   Aspect="AspectFill">
                                                <Image.Clip>
                                                    <RoundRectangleGeometry CornerRadius="10" Rect="0,0,60,60"/>
                                                </Image.Clip>
                                            </Image>
                                        </Border>
                                        
                                        <VerticalStackLayout Grid.Column="1" 
                                                             Spacing="4" 
                                                             VerticalOptions="Center">
                                            <Label Text="{Binding Title}" 
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource TextPrimary}"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="2"/>
                                            <Label Text="{Binding ., Converter={StaticResource ProductToPriceTextConverter}}" 
                                                   FontSize="13"
                                                   TextColor="{StaticResource Primary}"
                                                   FontAttributes="Bold"/>
                                        </VerticalStackLayout>

                                        <Label Grid.Column="2"
                                               Text="✓"
                                               FontSize="24"
                                               TextColor="{StaticResource Primary}"
                                               IsVisible="{Binding IsSelected, Source={RelativeSource AncestorType={x:Type CollectionView}}}"
                                               VerticalOptions="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Border>

                <!-- Message Editor -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Teklif Notu (İsteğe Bağlı)" 
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="{StaticResource TextSecondary}"/>
                    <Border StrokeShape="RoundRectangle 12"
                            Stroke="{StaticResource Divider}"
                            StrokeThickness="2"
                            Padding="12"
                            BackgroundColor="White">
                        <Editor Placeholder="Mesajınızı buraya yazın..." 
                                Text="{Binding OfferMessage}" 
                                HeightRequest="80"
                                FontSize="14"
                                TextColor="{StaticResource TextPrimary}"
                                PlaceholderColor="{StaticResource Gray400}"
                                BackgroundColor="Transparent"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Action Buttons -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,10,0,0">
                    <Button Grid.Column="0"
                            Text="İptal" 
                            Command="{Binding CancelCommand}" 
                            CommandParameter="{Binding Source={x:Reference thisPopup}}" 
                            BackgroundColor="{StaticResource Gray100}"
                            TextColor="{StaticResource TextSecondary}"
                            CornerRadius="12"
                            HeightRequest="50"
                            FontAttributes="Bold"/>
                    
                    <Button Grid.Column="1"
                            Text="Gönder" 
                            Command="{Binding SubmitOfferCommand}" 
                            CommandParameter="{Binding Source={x:Reference thisPopup}}" 
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            CornerRadius="12"
                            HeightRequest="50"
                            FontAttributes="Bold">
                        <Button.Shadow>
                            <Shadow Brush="{StaticResource Primary}" Opacity="0.4" Radius="10" Offset="0,4"/>
                        </Button.Shadow>
                    </Button>
                </Grid>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>
