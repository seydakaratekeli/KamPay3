<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:extensions="clr-namespace:KamPay.Extensions"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KamPay.ViewModels"
             xmlns:models="clr-namespace:KamPay.Models"
             xmlns:converters="clr-namespace:KamPay.Converters"
             xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
             xmlns:res="clr-namespace:KamPay.Services"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             x:Class="KamPay.Views.OffersPage"
             x:DataType="vm:OffersViewModel"
             x:Name="ThisPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}">

    <ContentPage.Resources>
        <ResourceDictionary>

            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
            <converters:IsAcceptedConverter x:Key="IsAcceptedConverter" />
            <converters:IsPendingConverter x:Key="IsPendingConverter" />
            <converters:IsPendingOrNegotiatingConverter x:Key="IsPendingOrNegotiatingConverter" />
            <converters:ConfirmDonationButtonVisibilityConverter x:Key="ConfirmDonationButtonVisibilityConverter"/>
            <converters:SimulatePaymentButtonVisibilityConverter x:Key="SimulatePaymentButtonVisibilityConverter"/>
             <converters:AllTrueConverter x:Key="AllTrueConverter"/>
            <converters:IsCurrentUserConverter x:Key="IsCurrentUserConverter"/>
            <converters:ProductTypeToEmojiConverter x:Key="ProductTypeToEmojiConverter"/>
            <converters:IsNegotiatingConverter x:Key="IsNegotiatingConverter"/>
            <converters:PaymentPendingConverter x:Key="PaymentPendingConverter"/>
            <converters:PaymentPaidConverter x:Key="PaymentPaidConverter"/>
            <converters:IsDonationConverter x:Key="IsDonationConverter"/>
            <converters:AnyTrueConverter x:Key="AnyTrueConverter"/>
            <converters:NegotiationStatusTextConverter x:Key="NegotiationStatusTextConverter"/>
            <converters:NegotiationTimerColorConverter x:Key="NegotiationTimerColorConverter"/>
            <converters:NegotiationTimerTextConverter x:Key="NegotiationTimerTextConverter"/>
            <converters:IsMyTurnConverter x:Key="IsMyTurnConverter"/>
            <converters:NegotiationRoundsLeftConverter x:Key="NegotiationRoundsLeftConverter"/>
            <converters:CanAcceptNegotiationConverter x:Key="CanAcceptNegotiationConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <Grid Grid.Row="0" x:Name="HeaderSection">
            <BoxView>
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{StaticResource Primary}" Offset="0.0" />
                        <GradientStop Color="{StaticResource PrimaryDark}" Offset="1.0" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

            <Ellipse x:Name="Circle1" 
                     WidthRequest="150" 
                     HeightRequest="150"
                     Fill="White"
                     Opacity="0.05"
                     HorizontalOptions="End"
                     VerticalOptions="Start"
                     Margin="0,-60,-60,0"/>

            <Label Text="{extensions:Translate OffersTitle}"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="White"
                   Margin="20,50,20,20"
                   HorizontalTextAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" 
              ColumnDefinitions="*,*" 
              Padding="15,10" 
              ColumnSpacing="10" 
              BackgroundColor="White"
              x:Name="TabSection">

            <Border Grid.Column="0"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="0"
                    HeightRequest="45"
                    BackgroundColor="{Binding IsIncomingSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='{StaticResource Primary}|White'}">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource Primary}" Offset="0,2" Radius="6" Opacity="0.3"/>
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectIncomingCommand}"/>
                </Border.GestureRecognizers>
                <Label Text="{extensions:Translate IncomingOffers}"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{Binding IsIncomingSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='White|{StaticResource Primary}'}"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"/>
            </Border>

            <Border Grid.Column="1"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="0"
                    HeightRequest="45"
                    BackgroundColor="{Binding IsOutgoingSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='{StaticResource Primary}|White'}">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource Primary}" Offset="0,2" Radius="6" Opacity="0.3"/>
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectOutgoingCommand}"/>
                </Border.GestureRecognizers>
                <Label Text="{extensions:Translate OutgoingOffers}"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{Binding IsOutgoingSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='White|{StaticResource Primary}'}"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"/>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <RefreshView Command="{Binding RefreshOffersCommand}"
                         IsRefreshing="{Binding IsRefreshing}"
                         RefreshColor="{StaticResource Primary}"
                         x:Name="ContentSection">

                <Grid>
                    <!-- ✅ INCOMING OFFERS - SfListView -->
                    <syncfusion:SfListView ItemsSource="{Binding IncomingOffers}"
                                           IsVisible="{Binding IsIncomingSelected}"
                                           Margin="15,10"
                                           SelectionMode="None"
                                           AutoFitMode="Height"
                                           ItemSpacing="0">

                        <syncfusion:SfListView.EmptyView>
                            <Grid VerticalOptions="Center" HorizontalOptions="Center" Padding="30">
                                <Border BackgroundColor="White"
                                        StrokeThickness="0"
                                        Padding="30"
                                        WidthRequest="280"
                                        HeightRequest="200">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20"/>
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Opacity="0.08" Radius="15" Offset="0,4"/>
                                    </Border.Shadow>
                                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label Text="📥" FontSize="60" HorizontalTextAlignment="Center"/>
                                        <Label Text="{extensions:Translate NoIncomingOffers}"
                                               FontSize="16"
                                               TextColor="{StaticResource TextSecondary}"
                                               HorizontalTextAlignment="Center"
                                               FontAttributes="Bold"/>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </syncfusion:SfListView.EmptyView>

                        <syncfusion:SfListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Transaction">
                                <Border Margin="0,0,0,12"
                                        StrokeShape="RoundRectangle 16"
                                        StrokeThickness="0"
                                        BackgroundColor="White"
                                        Padding="15">
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Offset="0,2" Radius="10" Opacity="0.08"/>
                                    </Border.Shadow>

                                    <VerticalStackLayout Spacing="12">
                                        <Grid ColumnDefinitions="90,*" ColumnSpacing="12">
                                            <Border Grid.Column="0"
                                                    StrokeShape="RoundRectangle 12"
                                                    StrokeThickness="0"
                                                    WidthRequest="90"
                                                    HeightRequest="90">
                                                <ffimageloading:CachedImage 
                                                    Source="{Binding ProductThumbnailUrl}"
                                                    Aspect="AspectFill"
                                                    LoadingPlaceholder="loading_image.png"
                                                    ErrorPlaceholder="error_image.png"/>
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Label Grid.Column="0"
                                                           Text="{Binding ProductTitle}"
                                                           TextColor="{StaticResource TextPrimary}"
                                                           FontAttributes="Bold"
                                                           FontSize="16"
                                                           LineBreakMode="TailTruncation"
                                                           MaxLines="1"/>
                                                    <Label Grid.Column="1"
                                                           Text="{Binding StatusText}"
                                                           FontSize="11"
                                                           TextColor="{StaticResource Primary}"
                                                           FontAttributes="Bold"/>
                                                </Grid>

                                                <Label Text="{Binding BuyerName, StringFormat='Talep Eden: {0}'}"
                                                       FontSize="13"
                                                       TextColor="{StaticResource TextSecondary}"/>

                                                <Label Text="{Binding Message}"
                                                       FontSize="13"
                                                       MaxLines="2"
                                                       LineBreakMode="TailTruncation"
                                                       TextColor="{StaticResource TextPrimary}"/>

                                                <Label Text="{Binding Price, StringFormat='{0} ₺'}"
                                                       TextColor="{StaticResource Primary}"
                                                       FontAttributes="Bold"
                                                       FontSize="18"/>
                                            </VerticalStackLayout>
                                        </Grid>

                                        <Border StrokeShape="RoundRectangle 12"
        StrokeThickness="0"
        BackgroundColor="{Binding ., Converter={StaticResource NegotiationTimerColorConverter}}"
        Padding="12">
                                            <Border.IsVisible>
                                                <MultiBinding Converter="{StaticResource AllTrueConverter}">
                                                    <Binding Path="IsNegotiating"/>
                                                    <Binding Path="IsNegotiationAllowed"/>
                                                </MultiBinding>
                                            </Border.IsVisible>
                                            <VerticalStackLayout Spacing="6">

                                                <Label Text="{Binding ., Converter={StaticResource NegotiationStatusTextConverter}}"
               TextColor="White"
               FontSize="13"
               FontAttributes="Bold"/>

                                                <Grid ColumnDefinitions="*,Auto">

                                                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                                                        <Label FontSize="11" TextColor="White" Opacity="0.9">
                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <Span Text="Teklif turu: "/>
                                                                    <Span Text="{Binding NegotiationRoundCount}" FontAttributes="Bold"/>
                                                                    <Span Text=" / 10"/>
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>

                                                        <HorizontalStackLayout Spacing="3">
                                                            <ProgressBar Progress="{Binding NegotiationRoundCount, Converter={StaticResource NegotiationRoundsLeftConverter}}"
                                 ProgressColor="White"
                                 BackgroundColor="#40FFFFFF"
                                 HeightRequest="6"
                                 WidthRequest="140"/>

                                                            <Label Text="{Binding ., Converter={StaticResource NegotiationTimerTextConverter}}"                           FontSize="10"
                           TextColor="White"
                           Opacity="0.85"
                           VerticalOptions="Center"/>
                                                        </HorizontalStackLayout>
                                                    </VerticalStackLayout>

                                                    <Border Grid.Column="1"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="#30FFFFFF"
                    Padding="8,4">

                                                        <Label Text="{Binding ., Converter={StaticResource IsMyTurnConverter}}"
                       FontSize="11"
                       FontAttributes="Bold"
                       TextColor="White"/>
                                                    </Border>

                                                </Grid>
                                            </VerticalStackLayout>
                                        </Border>

                                        <CollectionView ItemsSource="{Binding NegotiationOfferHistory}"
                                                        IsVisible="{Binding HasNegotiationOfferHistory}"
                                                        SelectionMode="None"
                                                        HeightRequest="86">
                                            <CollectionView.ItemsLayout>
                                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="4"/>
                                            </CollectionView.ItemsLayout>
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate x:DataType="models:NegotiationOffer">
                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                                          ColumnSpacing="8"
                                                          Padding="8,4"
                                                          BackgroundColor="{StaticResource PrimaryLightBg}">
                                                        <Label Grid.Column="0"
                                                               Text="{Binding RoundNumber, StringFormat='#{0}'}"
                                                               FontSize="11"
                                                               FontAttributes="Bold"
                                                               TextColor="{StaticResource Primary}"/>
                                                        <Label Grid.Column="1"
                                                               Text="{Binding ProposerName}"
                                                               FontSize="11"
                                                               TextColor="{StaticResource TextPrimary}"
                                                               LineBreakMode="TailTruncation"/>
                                                        <Label Grid.Column="2"
                                                               Text="{Binding Amount, StringFormat='{0:N2} ₺'}"
                                                               FontSize="11"
                                                               FontAttributes="Bold"
                                                               TextColor="{StaticResource TextPrimary}"/>
                                                        <Label Grid.Column="3"
                                                               Text="{Binding Status}"
                                                               FontSize="10"
                                                               TextColor="{StaticResource TextSecondary}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>
                                        
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,5,0,0">
                                            <HorizontalStackLayout Grid.Column="1" Spacing="8" HorizontalOptions="End">

                                                <Button Text="💬"
                                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.MessagePartnerCommand}"
                                                        CommandParameter="{Binding .}"
                                                        BackgroundColor="{StaticResource PrimaryLightBg}"
                                                        TextColor="{StaticResource Primary}"
                                                        WidthRequest="45"
                                                        HeightRequest="45"
                                                        CornerRadius="22"
                                                        FontSize="18"
                                                        Padding="0"/>

                                                <Button Text="📱"
                                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ManageDeliveryCommand}"
                                                        CommandParameter="{Binding .}"
                                                        BackgroundColor="{StaticResource Primary}"
                                                        TextColor="White"
                                                        WidthRequest="45"
                                                        HeightRequest="45"
                                                        CornerRadius="22"
                                                        FontSize="18"
                                                        Padding="0">
                                                    <Button.IsVisible>
                                                        <MultiBinding Converter="{StaticResource AllTrueConverter}">
                                                            <Binding Path="Type" Converter="{StaticResource EnumToBoolConverter}" ConverterParameter="Takas"/>
                                                            <Binding Path="Status" Converter="{StaticResource IsAcceptedConverter}"/>
                                                        </MultiBinding>
                                                    </Button.IsVisible>
                                                </Button>

                                                <Button Text="💰"
        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SendCounterOfferCommand}"
        CommandParameter="{Binding .}"
        BackgroundColor="{StaticResource WarningLightBg}"
        TextColor="{StaticResource AccentOrange}"
        WidthRequest="45" HeightRequest="45"
        CornerRadius="22" FontSize="18" Padding="0">
                                                    <Button.IsVisible>
                                                        <MultiBinding Converter="{StaticResource AllTrueConverter}">
                                                            <Binding Path="Type" Converter="{StaticResource EnumToBoolConverter}" ConverterParameter="Satis"/>
                                                            <Binding Path="IsNegotiationAllowed"/>
                                                            <MultiBinding Converter="{StaticResource AnyTrueConverter}">
                                                                <Binding Path="Status" Converter="{StaticResource IsPendingConverter}"/>
                                                                <Binding Path="IsNegotiating"/>
                                                            </MultiBinding>
                                                        </MultiBinding>
                                                    </Button.IsVisible>
                                                    <!-- ✅ YENI: Sıra satıcıda değilse disable et (alıcı son teklifi yaptıysa satıcı karşı teklif veremez) -->
                                                    <Button.IsEnabled>
                                                        <Binding Path="." Converter="{StaticResource IsMyTurnConverter}"
                 ConverterParameter="bool"/>
                                                    </Button.IsEnabled>
                                                    <Button.Opacity>
                                                        <Binding Path="." Converter="{StaticResource IsMyTurnConverter}"
                 ConverterParameter="opacity"/>
                                                    </Button.Opacity>
                                                </Button>
                                                <Button Text="✓"
                                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.AcceptOfferCommand}"
                                                        CommandParameter="{Binding .}"
                                                        BackgroundColor="{StaticResource AccentGreen}"
                                                        TextColor="White"
                                                        WidthRequest="45"
                                                        HeightRequest="45"
                                                        CornerRadius="22"
                                                        FontSize="20"
                                                        Padding="0"
                                                        IsVisible="{Binding Status, Converter={StaticResource IsPendingOrNegotiatingConverter}}"/>

                                                <Button Text="✕"
                                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.RejectOfferCommand}"
                                                        CommandParameter="{Binding .}"
                                                        BackgroundColor="{StaticResource AccentRed}"
                                                        TextColor="White"
                                                        WidthRequest="45"
                                                        HeightRequest="45"
                                                        CornerRadius="22"
                                                        FontSize="20"
                                                        Padding="0"
                                                        IsVisible="{Binding Status, Converter={StaticResource IsPendingOrNegotiatingConverter}}"/>
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </syncfusion:SfListView.ItemTemplate>
                    </syncfusion:SfListView>

                    <!-- ✅ OUTGOING OFFERS - SfListView -->
                    <syncfusion:SfListView ItemsSource="{Binding OutgoingOffers}"
                                           IsVisible="{Binding IsOutgoingSelected}"
                                           Margin="15,10"
                                           SelectionMode="None"
                                           AutoFitMode="Height"
                                           ItemSpacing="0">

                        <syncfusion:SfListView.EmptyView>
                            <Grid VerticalOptions="Center" HorizontalOptions="Center" Padding="30">
                                <Border BackgroundColor="White"
                                        StrokeThickness="0"
                                        Padding="30"
                                        WidthRequest="280"
                                        HeightRequest="200">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20"/>
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Opacity="0.08" Radius="15" Offset="0,4"/>
                                    </Border.Shadow>
                                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label Text="📤" FontSize="60" HorizontalTextAlignment="Center"/>
                                        <Label Text="{extensions:Translate NoOutgoingOffers}"
                                               FontSize="16"
                                               TextColor="{StaticResource TextSecondary}"
                                               HorizontalTextAlignment="Center"
                                               FontAttributes="Bold"/>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </syncfusion:SfListView.EmptyView>

                        <syncfusion:SfListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Transaction">
                                <Border Margin="0,0,0,12"
                                        StrokeShape="RoundRectangle 16"
                                        StrokeThickness="0"
                                        BackgroundColor="White"
                                        Padding="15">
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Offset="0,2" Radius="10" Opacity="0.08"/>
                                    </Border.Shadow>

                                    <VerticalStackLayout Spacing="12">
                                        <Grid ColumnDefinitions="90,*" ColumnSpacing="12">
                                            <Border Grid.Column="0"
                                                    StrokeShape="RoundRectangle 12"
                                                    StrokeThickness="0"
                                                    WidthRequest="90"
                                                    HeightRequest="90">
                                                <ffimageloading:CachedImage 
                                                    Source="{Binding ProductThumbnailUrl}"
                                                    Aspect="AspectFill"
                                                    LoadingPlaceholder="loading_image.png"
                                                    ErrorPlaceholder="error_image.png"/>
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <Label Grid.Column="0"
                                                           Text="{Binding ProductTitle}"
                                                           FontAttributes="Bold"
                                                           FontSize="16"
                                                           TextColor="{StaticResource TextPrimary}"
                                                           LineBreakMode="TailTruncation"
                                                           MaxLines="1"/>
                                                    <Label Grid.Column="1"
                                                           Text="{Binding StatusText}"
                                                           FontSize="11"
                                                           TextColor="{StaticResource Primary}"
                                                           FontAttributes="Bold"/>
                                                </Grid>

                                                <Label Text="{Binding SellerName, StringFormat='Satıcı: {0}'}"
                                                       FontSize="13"
                                                       TextColor="{StaticResource TextSecondary}"/>

                                                <Label Text="{Binding Message}"
                                                       FontSize="13"
                                                       MaxLines="2"
                                                       LineBreakMode="TailTruncation"
                                                       TextColor="{StaticResource TextPrimary}"/>

                                                <Label Text="{Binding Price, StringFormat='{0} ₺'}"
                                                       TextColor="{StaticResource Primary}"
                                                       FontAttributes="Bold"
                                                       FontSize="18"/>
                                            </VerticalStackLayout>
                                        </Grid>

                                        <Border StrokeShape="RoundRectangle 12"
        StrokeThickness="0"
        BackgroundColor="{Binding ., Converter={StaticResource NegotiationTimerColorConverter}}"
        Padding="12">
                                            <Border.IsVisible>
                                                <MultiBinding Converter="{StaticResource AllTrueConverter}">
                                                    <Binding Path="IsNegotiating"/>
                                                    <Binding Path="IsNegotiationAllowed"/>
                                                </MultiBinding>
                                            </Border.IsVisible>
                                            <VerticalStackLayout Spacing="6">

                                                <Label Text="{Binding ., Converter={StaticResource NegotiationStatusTextConverter}}"
               TextColor="White"
               FontSize="13"
               FontAttributes="Bold"/>

                                                <Grid ColumnDefinitions="*,Auto">

                                                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                                                        <Label FontSize="11" TextColor="White" Opacity="0.9">
                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <Span Text="Teklif turu: "/>
                                                                    <Span Text="{Binding NegotiationRoundCount}" FontAttributes="Bold"/>
                                                                    <Span Text=" / 10"/>
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>

                                                        <HorizontalStackLayout Spacing="3">
                                                            <ProgressBar Progress="{Binding NegotiationRoundCount, Converter={StaticResource NegotiationRoundsLeftConverter}}"
                                 ProgressColor="White"
                                 BackgroundColor="#40FFFFFF"
                                 HeightRequest="6"
                                 WidthRequest="140"/>

                                                            <Label Text="{Binding ., Converter={StaticResource NegotiationTimerTextConverter}}"                           FontSize="10"
                           TextColor="White"
                           Opacity="0.85"
                           VerticalOptions="Center"/>
                                                        </HorizontalStackLayout>
                                                    </VerticalStackLayout>

                                                    <Border Grid.Column="1"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="#30FFFFFF"
                    Padding="8,4">

                                                        <Label Text="{Binding ., Converter={StaticResource IsMyTurnConverter}}"
                       FontSize="11"
                       FontAttributes="Bold"
                       TextColor="White"/>
                                                    </Border>

                                                </Grid>
                                            </VerticalStackLayout>
                                        </Border>

                                        <CollectionView ItemsSource="{Binding NegotiationOfferHistory}"
                                                        IsVisible="{Binding HasNegotiationOfferHistory}"
                                                        SelectionMode="None"
                                                        HeightRequest="86">
                                            <CollectionView.ItemsLayout>
                                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="4"/>
                                            </CollectionView.ItemsLayout>
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate x:DataType="models:NegotiationOffer">
                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                                          ColumnSpacing="8"
                                                          Padding="8,4"
                                                          BackgroundColor="{StaticResource PrimaryLightBg}">
                                                        <Label Grid.Column="0"
                                                               Text="{Binding RoundNumber, StringFormat='#{0}'}"
                                                               FontSize="11"
                                                               FontAttributes="Bold"
                                                               TextColor="{StaticResource Primary}"/>
                                                        <Label Grid.Column="1"
                                                               Text="{Binding ProposerName}"
                                                               FontSize="11"
                                                               TextColor="{StaticResource TextPrimary}"
                                                               LineBreakMode="TailTruncation"/>
                                                        <Label Grid.Column="2"
                                                               Text="{Binding Amount, StringFormat='{0:N2} ₺'}"
                                                               FontSize="11"
                                                               FontAttributes="Bold"
                                                               TextColor="{StaticResource TextPrimary}"/>
                                                        <Label Grid.Column="3"
                                                               Text="{Binding Status}"
                                                               FontSize="10"
                                                               TextColor="{StaticResource TextSecondary}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>

                                        <Grid ColumnDefinitions="*,Auto" Margin="0,5,0,0">
                                            <HorizontalStackLayout Grid.Column="1" Spacing="8" HorizontalOptions="End">

                                                <Button Text="💬"
                                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.MessagePartnerCommand}"
                                                        CommandParameter="{Binding .}"
                                                        BackgroundColor="{StaticResource PrimaryLightBg}"
                                                        TextColor="{StaticResource Primary}"
                                                        WidthRequest="45"
                                                        HeightRequest="45"
                                                        CornerRadius="22"
                                                        FontSize="18"
                                                        Padding="0"/>

                                                <Button Text="📱"
                                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ManageDeliveryCommand}"
                                                        CommandParameter="{Binding .}"
                                                        BackgroundColor="{StaticResource Primary}"
                                                        TextColor="White"
                                                        WidthRequest="45"
                                                        HeightRequest="45"
                                                        CornerRadius="22"
                                                        FontSize="18"
                                                        Padding="0">
                                                    <Button.IsVisible>
                                                        <MultiBinding Converter="{StaticResource AllTrueConverter}">
                                                            <Binding Path="Type" Converter="{StaticResource EnumToBoolConverter}" ConverterParameter="Takas"/>
                                                            <Binding Path="Status" Converter="{StaticResource IsAcceptedConverter}"/>
                                                        </MultiBinding>
                                                    </Button.IsVisible>
                                                </Button>

                                                <Button Text="💰"
        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ProposePriceCommand}"
        CommandParameter="{Binding .}"
        BackgroundColor="{StaticResource WarningLightBg}"
        TextColor="{StaticResource AccentOrange}"
        WidthRequest="45" HeightRequest="45"
        CornerRadius="22" FontSize="18" Padding="0">
                                                    <Button.IsVisible>
                                                        <MultiBinding Converter="{StaticResource AllTrueConverter}">
                                                            <Binding Path="Type" Converter="{StaticResource EnumToBoolConverter}" ConverterParameter="Satis"/>
                                                            <Binding Path="IsNegotiationAllowed"/>
                                                            <MultiBinding Converter="{StaticResource AnyTrueConverter}">
                                                                <Binding Path="Status" Converter="{StaticResource IsPendingConverter}"/>
                                                                <Binding Path="IsNegotiating"/>
                                                            </MultiBinding>
                                                        </MultiBinding>
                                                    </Button.IsVisible>
                                                    <!-- ✅ YENI: Sıra alıcıda değilse disable -->
                                                    <Button.IsEnabled>
                                                        <Binding Path="." Converter="{StaticResource IsMyTurnConverter}"
                 ConverterParameter="bool"/>
                                                    </Button.IsEnabled>
                                                    <Button.Opacity>
                                                        <Binding Path="." Converter="{StaticResource IsMyTurnConverter}"
                 ConverterParameter="opacity"/>
                                                    </Button.Opacity>
                                                </Button>
                                                <Button Text="💵"
                                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ProposeAdditionalCashCommand}"
                                                        CommandParameter="{Binding .}"
                                                        BackgroundColor="{StaticResource SuccessLightBg}"
                                                        TextColor="{StaticResource AccentGreen}"
                                                        WidthRequest="45"
                                                        HeightRequest="45"
                                                        CornerRadius="22"
                                                        FontSize="18"
                                                        Padding="0">
                                                    <Button.IsVisible>
                                                        <MultiBinding Converter="{StaticResource AllTrueConverter}">
                                                            <Binding Path="Type" Converter="{StaticResource EnumToBoolConverter}" ConverterParameter="Takas"/>
                                                            <MultiBinding Converter="{StaticResource AnyTrueConverter}">
                                                                <Binding Path="Status" Converter="{StaticResource IsPendingConverter}"/>
                                                                <Binding Path="IsNegotiating"/>
                                                            </MultiBinding>
                                                        </MultiBinding>
                                                    </Button.IsVisible>
                                                </Button>

                                                <Button Text="✅"
                                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.AcceptNegotiatedPriceCommand}"
                                                        CommandParameter="{Binding .}"
                                                        BackgroundColor="{StaticResource Success}"
                                                        TextColor="White"
                                                        WidthRequest="45"
                                                        HeightRequest="45"
                                                        CornerRadius="22"
                                                        FontSize="18"
                                                        Padding="0"
                                                        IsVisible="{Binding ., Converter={StaticResource CanAcceptNegotiationConverter}}"/>

                                                <Button Text="💳"
                                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.CompletePaymentCommand}"
                                                        CommandParameter="{Binding .}"
                                                        BackgroundColor="{StaticResource AccentGreen}"
                                                        TextColor="White"
                                                        WidthRequest="45"
                                                        HeightRequest="45"
                                                        CornerRadius="22"
                                                        FontSize="18"
                                                        Padding="0">
                                                    <Button.IsVisible>
                                                        <MultiBinding Converter="{StaticResource AllTrueConverter}">
                                                            <Binding Path="Type" Converter="{StaticResource EnumToBoolConverter}" ConverterParameter="Satis"/>
                                                            <Binding Path="Status" Converter="{StaticResource IsAcceptedConverter}"/>
                                                            <Binding Path="PaymentStatus" Converter="{StaticResource PaymentPendingConverter}"/>
                                                        </MultiBinding>
                                                    </Button.IsVisible>
                                                </Button>

                                                <Button Text="✅"
                                                        Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ConfirmDonationCommand}"
                                                        CommandParameter="{Binding .}"
                                                        BackgroundColor="{StaticResource AccentGreen}"
                                                        TextColor="White"
                                                        WidthRequest="45"
                                                        HeightRequest="45"
                                                        CornerRadius="22"
                                                        FontSize="18"
                                                        Padding="0">
                                                    <Button.IsVisible>
                                                        <MultiBinding Converter="{StaticResource AllTrueConverter}">
                                                            <Binding Path="Type" Converter="{StaticResource IsDonationConverter}"/>
                                                            <Binding Path="Status" Converter="{StaticResource IsAcceptedConverter}"/>
                                                        </MultiBinding>
                                                    </Button.IsVisible>
                                                </Button>
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </syncfusion:SfListView.ItemTemplate>
                    </syncfusion:SfListView>
                </Grid>
            </RefreshView>

            <Grid IsVisible="{Binding IsLoading}"
                  BackgroundColor="{StaticResource Background}"
                  ZIndex="1100"
                  InputTransparent="False">
                <Border BackgroundColor="White"
                        WidthRequest="100"
                        HeightRequest="100"
                        StrokeThickness="0"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.15" Radius="15" Offset="0,8"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                        <ActivityIndicator IsRunning="True"
                                           Color="{StaticResource Primary}"
                                           WidthRequest="40"
                                           HeightRequest="40" />
                        <Label Text="{extensions:Translate OffersLoading}"
                               TextColor="{StaticResource Primary}"
                               FontSize="13" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>




