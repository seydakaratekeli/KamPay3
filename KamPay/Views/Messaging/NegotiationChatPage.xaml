<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:extensions="clr-namespace:KamPay.Extensions"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:KamPay.Models"
             xmlns:converters="clr-namespace:KamPay.Converters"
             xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             x:Class="KamPay.Views.NegotiationChatPage"
             x:Name="chatPageRoot"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
            <converters:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
        <Grid Grid.Row="0" x:Name="HeaderSection">
            <BoxView>
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF8A00" Offset="0.0"/>
                        <GradientStop Color="#E65100" Offset="1.0"/>
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

            <Ellipse x:Name="Circle1"
                     WidthRequest="150"
                     HeightRequest="150"
                     Fill="White"
                     Opacity="0.05"
                     HorizontalOptions="End"
                     VerticalOptions="Start"
                     Margin="0,-60,-60,0"/>

            <Grid Padding="15,10,15,15" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
                <Border Grid.Column="0"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="#FFFFFF33"
                        WidthRequest="40"
                        HeightRequest="40"
                        StrokeThickness="0"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="‹"
                           FontSize="32"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>

                <Border Grid.Column="1"
                        StrokeThickness="2"
                        Stroke="White"
                        WidthRequest="50"
                        HeightRequest="50"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="25"/>
                    </Border.StrokeShape>
                    <ffimageloading:CachedImage Source="{Binding OtherUserPhoto}"
                                                Aspect="AspectFill"
                                                LoadingPlaceholder="person_icon.svg"
                                                ErrorPlaceholder="person_icon.svg"
                                                DownsampleToViewSize="True"/>
                </Border>

                <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="2">
                    <Label Text="{Binding OtherUserName, FallbackValue='Yukleniyor...'}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White"
                           LineBreakMode="TailTruncation"
                           MaxLines="1"/>
                    <Label Text="{Binding OnlineStatusText}"
                           FontSize="12"
                           TextColor="White"
                           Opacity="0.85"/>
                </VerticalStackLayout>

                <Border Grid.Column="3"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="#FFF3E0"
                        StrokeThickness="0"
                        Padding="10,5"
                        VerticalOptions="Center">
                    <Label Text="Pazarlik"
                           FontSize="11"
                           TextColor="#E65100"
                           FontAttributes="Bold"/>
                </Border>
            </Grid>
        </Grid>

        <ScrollView Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    BackgroundColor="#FFF8F0"
                    Padding="10,7">
            <HorizontalStackLayout Spacing="8">
                <Border Padding="10,6"
                        StrokeShape="RoundRectangle 16"
                        Stroke="#FF8A00"
                        BackgroundColor="#FFE0B2">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectAllMessagesCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="Tum Mesajlar"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#E65100"/>
                </Border>

                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding ActiveTransactions}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Transaction">
                            <Border Padding="10,6"
                                    StrokeShape="RoundRectangle 16"
                                    Stroke="#FF8A00"
                                    BackgroundColor="White">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectTransactionChipCommand}"
                                                          CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="1">
                                    <Label Text="{Binding ProductTitle}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="#E65100"
                                           MaximumWidthRequest="140"
                                           LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding StatusText}"
                                           FontSize="10"
                                           TextColor="{StaticResource TextSecondary}"/>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </HorizontalStackLayout>
        </ScrollView>

        <Border Grid.Row="2"
                BackgroundColor="#FFF3E0"
                Padding="10,5"
                StrokeThickness="0"
                Margin="15,10,15,0"
                StrokeShape="RoundRectangle 8"
                IsVisible="{Binding HasActiveTransaction}">
            <Label Text="{Binding ActiveTransaction.RemainingRoundsText}"
                   FontSize="12"
                   TextColor="#E65100"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"/>
        </Border>

        <RefreshView Grid.Row="3"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshMessagesCommand}"
                     RefreshColor="#FF8A00"
                     IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
            <syncfusion:SfListView x:Name="MessagesListView"
                                   ItemsSource="{Binding FilteredMessages}"
                                   AutoFitMode="Height"
                                   SelectionMode="None"
                                   Margin="15,10">
                <syncfusion:SfListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Message">
                        <Grid Padding="0,4">
                            <Border Padding="12,8"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource SystemMessageBg}"
                                    HorizontalOptions="Center"
                                    MaximumWidthRequest="300"
                                    IsVisible="{Binding Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=System}">
                                <Label Text="{Binding Content}"
                                       TextColor="{StaticResource Primary}"
                                       FontSize="12"
                                       HorizontalTextAlignment="Center"
                                       FontAttributes="Bold"/>
                            </Border>

                            <Border Padding="12"
                                    StrokeShape="RoundRectangle 16"
                                    StrokeThickness="0"
                                    BackgroundColor="#FFF3E0"
                                    MaximumWidthRequest="290"
                                    HorizontalOptions="Center"
                                    IsVisible="{Binding Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Negotiation}">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="{Binding NegotiationAction}"
                                           FontAttributes="Bold"
                                           FontSize="12"
                                           TextColor="#E65100"
                                           HorizontalTextAlignment="Center"
                                           TextTransform="Uppercase"/>
                                    <Label Text="{Binding Content}"
                                           LineBreakMode="WordWrap"
                                           TextColor="{StaticResource TextPrimary}"
                                           FontSize="15"
                                           HorizontalTextAlignment="Center"
                                           FontAttributes="Bold"/>
                                    <HorizontalStackLayout Spacing="10"
                                                           HorizontalOptions="Center"
                                                           IsVisible="{Binding IsActiveOffer}">
                                        <Button Text="Kabul Et"
                                                BackgroundColor="#4CAF50"
                                                TextColor="White"
                                                HeightRequest="36"
                                                CornerRadius="18"
                                                FontSize="12"
                                                Padding="10,0"
                                                Command="{Binding Source={x:Reference chatPageRoot}, Path=BindingContext.AcceptOfferCommand}"
                                                CommandParameter="{Binding .}"/>
                                        <Button Text="Karsi Teklif"
                                                BackgroundColor="#FF8A00"
                                                TextColor="White"
                                                HeightRequest="36"
                                                CornerRadius="18"
                                                FontSize="12"
                                                Padding="10,0"
                                                Command="{Binding Source={x:Reference chatPageRoot}, Path=BindingContext.ProposeOfferCommand}"
                                                CommandParameter="{Binding .}"/>
                                        <Button Text="Reddet"
                                                BackgroundColor="#EF5350"
                                                TextColor="White"
                                                HeightRequest="36"
                                                CornerRadius="18"
                                                FontSize="12"
                                                Padding="10,0"
                                                Command="{Binding Source={x:Reference chatPageRoot}, Path=BindingContext.RejectOfferCommand}"
                                                CommandParameter="{Binding .}"/>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>

                            <Border Padding="12"
                                    StrokeShape="RoundRectangle 16"
                                    StrokeThickness="0"
                                    MaximumWidthRequest="280">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="HorizontalOptions" Value="Start"/>
                                        <Setter Property="BackgroundColor" Value="White"/>
                                        <Setter Property="IsVisible" Value="True"/>
                                        <Style.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding Type}" Value="System">
                                                <Setter Property="IsVisible" Value="False"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding Type}" Value="Negotiation">
                                                <Setter Property="IsVisible" Value="False"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSentByMe}" Value="True">
                                                <Setter Property="HorizontalOptions" Value="End"/>
                                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <VerticalStackLayout Spacing="6">
                                    <Grid IsVisible="{Binding Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Image}">
                                        <Image Source="{Binding ImageUrl}"
                                               Aspect="AspectFill"
                                               WidthRequest="240"
                                               HeightRequest="200">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={x:Reference chatPageRoot}, Path=BindingContext.ViewImageCommand}"
                                                                      CommandParameter="{Binding ImageUrl}"/>
                                            </Image.GestureRecognizers>
                                        </Image>
                                        <ActivityIndicator IsRunning="{Binding IsImageLoading}"
                                                           IsVisible="{Binding IsImageLoading}"
                                                           Color="#FF8A00"
                                                           VerticalOptions="Center"
                                                           HorizontalOptions="Center"/>
                                    </Grid>

                                    <Label Text="{Binding Content}"
                                           LineBreakMode="WordWrap"
                                           FontSize="15"
                                           IsVisible="{Binding Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Text}">
                                        <Label.Style>
                                            <Style TargetType="Label">
                                                <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsSentByMe}" Value="True">
                                                        <Setter Property="TextColor" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Label.Style>
                                    </Label>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </syncfusion:SfListView.ItemTemplate>
            </syncfusion:SfListView>
        </RefreshView>

        <Border Grid.Row="4"
                IsVisible="{Binding IsOtherUserTyping}"
                HorizontalOptions="Start"
                Margin="20,0,20,4"
                Padding="14,10"
                StrokeShape="RoundRectangle 18"
                StrokeThickness="0"
                BackgroundColor="White">
            <Label Text="yaziyor"
                   FontSize="12"
                   TextColor="{StaticResource TextSecondary}"
                   FontAttributes="Italic"/>
        </Border>

        <Border Grid.Row="5"
                Padding="15,12"
                StrokeThickness="0"
                BackgroundColor="White"
                x:Name="MessageInputSection">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                <Border Grid.Column="0"
                        StrokeShape="RoundRectangle 24"
                        BackgroundColor="#FFF3E0"
                        WidthRequest="48"
                        HeightRequest="48"
                        StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ProposeOfferCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="$"
                           FontSize="22"
                           TextColor="#E65100"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>

                <Border Grid.Column="1"
                        StrokeShape="RoundRectangle 24"
                        BackgroundColor="#E3F2FD"
                        WidthRequest="48"
                        HeightRequest="48"
                        StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PickImageCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="+"
                           FontSize="24"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>

                <Border Grid.Column="2"
                        Padding="14,0"
                        StrokeShape="RoundRectangle 24"
                        StrokeThickness="1"
                        Stroke="{StaticResource BorderColor}"
                        BackgroundColor="{StaticResource Background}"
                        MinimumHeightRequest="48">
                    <Entry Placeholder="{extensions:Translate TypeMessage}"
                           Text="{Binding MessageText}"
                           ReturnCommand="{Binding SendMessageCommand}"
                           MaxLength="1000"
                           VerticalOptions="Center"
                           FontSize="15"
                           TextColor="{StaticResource TextPrimary}"
                           PlaceholderColor="{StaticResource TextSecondary}"
                           BackgroundColor="Transparent"/>
                </Border>

                <Border Grid.Column="3"
                        StrokeShape="RoundRectangle 24"
                        BackgroundColor="#FF8A00"
                        WidthRequest="48"
                        HeightRequest="48"
                        StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SendMessageCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text=">"
                           FontSize="20"
                           TextColor="White"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.RowSpan="6"
              IsVisible="{Binding IsLoading}"
              BackgroundColor="{StaticResource Background}"
              ZIndex="1100"
              InputTransparent="False">
            <ActivityIndicator IsRunning="True"
                               Color="#FF8A00"
                               WidthRequest="48"
                               HeightRequest="48"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
        </Grid>
    </Grid>
</ContentPage>
