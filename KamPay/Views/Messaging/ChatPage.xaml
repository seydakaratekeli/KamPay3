<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:extensions="clr-namespace:KamPay.Extensions"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:KamPay.Models"
             xmlns:res="clr-namespace:KamPay.Services"
             xmlns:converters="clr-namespace:KamPay.Converters"
             xmlns:behaviors="clr-namespace:KamPay.Behaviors"
             xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             x:Class="KamPay.Views.ChatPage"
             x:Name="chatPageRoot"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
            <converters:EnumToBoolConverter x:Key="EnumToBoolConverter"/>

            <!-- ✅ FAZ4: Chip seçili mi? → bold border göster -->
            <Style x:Key="TransactionChipSelected" TargetType="Border">
                <Setter Property="StrokeThickness" Value="2"/>
                <Setter Property="Stroke" Value="{StaticResource Primary}"/>
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#1E88E5" Offset="0.0"/>
                            <GradientStop Color="#1565C0" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TransactionChipDefault" TargetType="Border">
                <Setter Property="StrokeThickness" Value="1"/>
                <Setter Property="Stroke" Value="{StaticResource Primary}"/>
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#E3F2FD" Offset="0.0"/>
                            <GradientStop Color="#BBDEFB" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- ✅ FAZ4: 6 satır — Header, Chips, Banner, Mesajlar, TypingIndicator, InputArea -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

        <!-- ✨ HEADER (Gradient + Profil) -->
        <Grid Grid.Row="0" RowDefinitions="Auto" x:Name="HeaderSection">
            <BoxView>
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{StaticResource Primary}" Offset="0.0"/>
                        <GradientStop Color="{StaticResource PrimaryDark}" Offset="1.0"/>
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

            <!-- Animated Background Circle -->
            <Ellipse x:Name="Circle1"
                     WidthRequest="150"
                     HeightRequest="150"
                     Fill="White"
                     Opacity="0.05"
                     HorizontalOptions="End"
                     VerticalOptions="Start"
                     Margin="0,-60,-60,0"/>

            <Grid Padding="15,10,15,15"
                  ColumnDefinitions="Auto,Auto,*,Auto"
                  ColumnSpacing="12">

                <!-- Geri Butonu -->
                <Border Grid.Column="0"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="LightGray"
                        WidthRequest="40"
                        HeightRequest="40"
                        StrokeThickness="0"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="↩"
                           FontSize="25"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           FontAttributes="Bold"/>
                </Border>

                <!-- Profil Fotoğrafı -->
                <Border Grid.Column="1"
                        StrokeThickness="2"
                        Stroke="White"
                        WidthRequest="50"
                        HeightRequest="50"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="25"/>
                    </Border.StrokeShape>
                    <Grid>
                        <ffimageloading:CachedImage
                            Source="{Binding OtherUserPhoto}"
                            Aspect="AspectFill"
                            LoadingPlaceholder="person_icon.svg"
                            ErrorPlaceholder="person_icon.svg"
                            DownsampleToViewSize="True"
                            CacheDuration="7"
                            RetryCount="3"
                            RetryDelay="250">
                            <ffimageloading:CachedImage.Clip>
                                <EllipseGeometry Center="25,25" RadiusX="25" RadiusY="25"/>
                            </ffimageloading:CachedImage.Clip>
                        </ffimageloading:CachedImage>

                        <!-- Online indicator -->
                        <Border WidthRequest="14"
                                HeightRequest="14"
                                BackgroundColor="#4CAF50"
                                StrokeThickness="2"
                                Stroke="White"
                                HorizontalOptions="End"
                                VerticalOptions="End"
                                Margin="0,0,-2,-2"
                                IsVisible="{Binding IsOtherUserOnline}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="7"/>
                            </Border.StrokeShape>
                        </Border>
                    </Grid>
                </Border>

                <!-- İsim + Durum -->
                <VerticalStackLayout Grid.Column="2"
                                     VerticalOptions="Center"
                                     Spacing="2">
                    <Label Text="{Binding OtherUserName, FallbackValue='Yükleniyor...'}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White"
                           LineBreakMode="TailTruncation"
                           MaxLines="1"/>

                    <!-- ✅ FAZ4: Typing indicator metni veya online durumu -->
                    <Label FontSize="12"
                           TextColor="White"
                           Opacity="0.85">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding IsOtherUserTyping}"
                                         Value="True">
                                <Setter Property="Text" Value="yazıyor..."/>
                                <Setter Property="TextColor" Value="#A5D6A7"/>
                                <Setter Property="FontAttributes" Value="Italic"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Label"
                                         Binding="{Binding IsOtherUserTyping}"
                                         Value="False">
                                <Setter Property="Text" Value="{Binding OnlineStatusText}"/>
                                <Setter Property="TextColor" Value="White"/>
                                <Setter Property="FontAttributes" Value="None"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>

                <!-- ✅ FAZ4: Filtre göstergesi (seçili işlem varsa) -->
                <Border Grid.Column="3"
                        IsVisible="{Binding ShowAllChipSelected, Converter={StaticResource InvertedBoolConverter}}"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="#FFF3E0"
                        StrokeThickness="0"
                        Padding="8,4"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectAllMessagesCommand}"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="4">
                        <Label Text="🔍" FontSize="12" VerticalOptions="Center"/>
                        <Label Text="Filtre" FontSize="11" TextColor="#F57C00" FontAttributes="Bold" VerticalOptions="Center"/>
                        <Label Text="✕" FontSize="11" TextColor="#F57C00" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Grid>

        <!-- ✅ FAZ4: TRANSACTION CHİP BANNER — Çoklu işlem + "Tüm Mesajlar" chip'i -->
        <Grid Grid.Row="1"
              BackgroundColor="#F5F9FC">
            <Grid.IsVisible>
                <MultiBinding Converter="{StaticResource AllTrueConverter}">
                    <Binding Path="HasActiveTransactions"/>
                    <Binding Path="IsNegotiationChat"/>
                </MultiBinding>
            </Grid.IsVisible>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Üst ince çizgi -->
            <BoxView Grid.Row="0" HeightRequest="1" BackgroundColor="#E0E0E0"/>

            <ScrollView Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never"
                        Padding="10,7,10,7">
                <HorizontalStackLayout Spacing="8">
                    <!-- 1. Sabit Chip: "Tüm Mesajlar" -->
                    <Border Padding="10,6" StrokeShape="RoundRectangle 16" StrokeThickness="1.5">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource TransactionChipDefault}">
                                <Style.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding ShowAllChipSelected}" Value="True">
                                        <Setter Property="Style" Value="{StaticResource TransactionChipSelected}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectAllMessagesCommand}"/>
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="💬" VerticalOptions="Center" FontSize="13"/>
                            <Label Text="Genel Sohbet" FontSize="12" FontAttributes="Bold" MaximumWidthRequest="120">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding ShowAllChipSelected}" Value="True">
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding ShowAllChipSelected}" Value="False">
                                        <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- 2. Dinamik Liste: İşlem (Ürün) Chipleri -->
                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding ActiveTransactions}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Transaction">
                                <Border Padding="10,6" StrokeShape="RoundRectangle 16" StrokeThickness="1.5">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource TransactionChipDefault}">
                                            <Style.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsChipSelected}" Value="True">
                                                    <Setter Property="Style" Value="{StaticResource TransactionChipSelected}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectTransactionChipCommand}" CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                        <Label Text="📦" VerticalOptions="Center" FontSize="13"/>
                                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                            <Label Text="{Binding ProductTitle}" FontSize="12" FontAttributes="Bold" MaximumWidthRequest="120" LineBreakMode="TailTruncation">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsChipSelected}" Value="True">
                                                        <Setter Property="TextColor" Value="White" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsChipSelected}" Value="False">
                                                        <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Label Text="{Binding StatusText}" FontSize="10">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsChipSelected}" Value="True">
                                                        <Setter Property="TextColor" Value="#E3F2FD" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsChipSelected}" Value="False">
                                                        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </HorizontalStackLayout>
            </ScrollView>

            <!-- Alt ince çizgi -->
            <BoxView Grid.Row="1" HeightRequest="1" BackgroundColor="#E0E0E0"/>
        </Grid>

        <!-- ✅ Kalan Tur Bilgisi Banner'ı -->
        <Border Grid.Row="2"
                BackgroundColor="#FFF3E0"
                Padding="10,5"
                StrokeThickness="0"
                Margin="15,10,15,0"
                StrokeShape="RoundRectangle 8">
            <Border.IsVisible>
                <MultiBinding Converter="{StaticResource AllTrueConverter}">
                    <Binding Path="HasActiveTransaction"/>
                    <Binding Path="IsNegotiationChat"/>
                </MultiBinding>
            </Border.IsVisible>
            <HorizontalStackLayout Spacing="5" HorizontalOptions="Center">
                <Label Text="ℹ️" VerticalOptions="Center"/>
                <Label Text="{Binding ActiveTransaction.RemainingRoundsText}" 
                       FontSize="12" 
                       TextColor="#F57C00" 
                       FontAttributes="Bold"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Border>

        <!-- ✨ MESAJ LİSTESİ -->
        <RefreshView Grid.Row="3"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshMessagesCommand}"
                     RefreshColor="{StaticResource Primary}"
                     IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">

            <syncfusion:SfListView x:Name="MessagesListView"
                                   ItemsSource="{Binding FilteredMessages}"
                                   AutoFitMode="Height"
                                   SelectionMode="None"
                                   Margin="15,10,15,10">
                <syncfusion:SfListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Message">
                        <Grid Padding="0,4">

                            <!-- System Mesajı -->
                            <Border Padding="12,8"
                                   StrokeShape="RoundRectangle 12"
                                   StrokeThickness="0"
                                   BackgroundColor="{StaticResource SystemMessageBg}"
                                   HorizontalOptions="Center"
                                   MaximumWidthRequest="300"
                                   IsVisible="{Binding Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=System}">
                                <Label Text="{Binding Content}"
                                       LineBreakMode="WordWrap"
                                       TextColor="{StaticResource Primary}"
                                       FontSize="12"
                                       HorizontalTextAlignment="Center"
                                       FontAttributes="Bold"/>
                            </Border>

                            <!-- 💰 PAZARLIK MESAJI (Negotiation) -->
                            <Border Padding="12"
                                   StrokeShape="RoundRectangle 16"
                                   StrokeThickness="0"
                                   MaximumWidthRequest="280"
                                   IsVisible="{Binding Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Negotiation}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="HorizontalOptions" Value="Center"/>
                                        <Setter Property="BackgroundColor" Value="#FFF3E0"/>
                                        <Setter Property="Shadow">
                                            <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.1"/>
                                        </Setter>
                                    </Style>
                                </Border.Style>

                                <VerticalStackLayout Spacing="8">
                                    <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                                        <Label Text="💰" FontSize="18" VerticalOptions="Center"/>
                                        <Label Text="{Binding NegotiationAction}"
                                               FontAttributes="Bold"
                                               FontSize="12"
                                               TextColor="#F57C00"
                                               VerticalOptions="Center"
                                               TextTransform="Uppercase"/>
                                    </HorizontalStackLayout>

                                    <Label Text="{Binding Content}"
                                           LineBreakMode="WordWrap"
                                           TextColor="{StaticResource TextPrimary}"
                                           FontSize="15"
                                           HorizontalTextAlignment="Center"
                                           FontAttributes="Bold"/>

                                    <!-- Butonlar: Sadece karşı tarafın tekliflerinde ve aktif teklifse -->
                                    <VerticalStackLayout IsVisible="{Binding IsActiveOffer}">
                                        <HorizontalStackLayout Spacing="10"
                                                               HorizontalOptions="Center"
                                                               Margin="0,5,0,0"
                                                               IsVisible="{Binding IsSentByMe, Converter={StaticResource InvertedBoolConverter}}">
                                            <Button Text="Kabul Et"
                                                    BackgroundColor="#4CAF50"
                                                    TextColor="White"
                                                    HeightRequest="36"
                                                    CornerRadius="18"
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    Padding="10,0"
                                                    Command="{Binding Source={x:Reference chatPageRoot}, Path=BindingContext.AcceptOfferCommand}"
                                                    CommandParameter="{Binding .}"/>

                                            <Button Text="Karşı Teklif"
                                                    BackgroundColor="{StaticResource Primary}"
                                                    TextColor="White"
                                                    HeightRequest="36"
                                                    CornerRadius="18"
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    Padding="10,0"
                                                    Command="{Binding Source={x:Reference chatPageRoot}, Path=BindingContext.ProposeOfferCommand}"
                                                    CommandParameter="{Binding .}">
                                                <Button.IsVisible>
                                                    <Binding Source="{x:Reference chatPageRoot}" Path="BindingContext.ActiveTransaction.IsNegotiationAllowed" FallbackValue="True"/>
                                                </Button.IsVisible>
                                            </Button>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>

                            <!-- 📦 İLAN KARTI (ProductCard) -->
                            <Border Padding="10"
                                   StrokeShape="RoundRectangle 16"
                                   StrokeThickness="1"
                                   Stroke="{StaticResource Primary}"
                                   BackgroundColor="#F8FBFF"
                                   MaximumWidthRequest="280"
                                   HorizontalOptions="Center"
                                   IsVisible="{Binding Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=ProductCard}">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.1"/>
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference chatPageRoot}, Path=BindingContext.NavigateToProductDetailCommand}" CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="6">
                                    <ffimageloading:CachedImage Source="{Binding ProductThumbnail}"
                                                                HeightRequest="120"
                                                                WidthRequest="260"
                                                                Aspect="AspectFill"
                                                                LoadingPlaceholder="product_placeholder.png"
                                                                ErrorPlaceholder="product_placeholder.png">
                                        <ffimageloading:CachedImage.Clip>
                                            <RoundRectangleGeometry CornerRadius="12" Rect="0,0,260,120"/>
                                        </ffimageloading:CachedImage.Clip>
                                    </ffimageloading:CachedImage>
                                    <Label Text="{Binding ProductTitle}" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource TextPrimary}" LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding ProductPrice, StringFormat='{0:N2} ₺'}" FontSize="14" FontAttributes="Bold" TextColor="#4CAF50"/>
                                    <Label Text="Tıklayarak ilana git ➔" FontSize="11" TextColor="{StaticResource Primary}" HorizontalOptions="End" FontAttributes="Italic"/>
                                </VerticalStackLayout>
                            </Border>

                            <!-- 🛠️ HİZMET KARTI (ServiceCard) -->
                            <Border Padding="12"
                                   StrokeShape="RoundRectangle 16"
                                   StrokeThickness="1"
                                   Stroke="#8E24AA"
                                   BackgroundColor="#FAF5FF"
                                   MaximumWidthRequest="280"
                                   HorizontalOptions="Center"
                                   IsVisible="{Binding Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=ServiceCard}">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.1"/>
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference chatPageRoot}, Path=BindingContext.NavigateToServiceOfferDetailCommand}" CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="6">
                                    <HorizontalStackLayout Spacing="8">
                                        <Border BackgroundColor="#E1BEE7" StrokeShape="RoundRectangle 20" WidthRequest="40" HeightRequest="40" StrokeThickness="0" VerticalOptions="Center">
                                            <Label Text="🛠️" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                        <VerticalStackLayout VerticalOptions="Center">
                                            <Label Text="{Binding ProductTitle}" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource TextPrimary}" LineBreakMode="TailTruncation" MaximumWidthRequest="200"/>
                                            <Label Text="{Binding ProductPrice, StringFormat='{0:N2} ₺'}" FontSize="13" FontAttributes="Bold" TextColor="#8E24AA"/>
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding Content}" FontSize="13" TextColor="{StaticResource TextSecondary}" LineBreakMode="TailTruncation" MaxLines="2"/>
                                    <Label Text="Tıklayarak hizmete git ➔" FontSize="11" TextColor="#8E24AA" HorizontalOptions="End" FontAttributes="Italic" Margin="0,4,0,0"/>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Normal Mesajlar -->
                            <Border Padding="12"
                                   StrokeShape="RoundRectangle 16"
                                   StrokeThickness="0"
                                   MaximumWidthRequest="280">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="HorizontalOptions" Value="Start"/>
                                        <Setter Property="BackgroundColor" Value="#FFFFFF"/>
                                        <Setter Property="IsVisible" Value="True"/>
                                        <Setter Property="Shadow">
                                            <Shadow Brush="Black" Offset="0,1" Radius="6" Opacity="0.08"/>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding Type}" Value="System">
                                                <Setter Property="IsVisible" Value="False"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding Type}" Value="Negotiation">
                                                <Setter Property="IsVisible" Value="False"/>
                                            </DataTrigger>
                                            <!-- ✅ FAZ 2: ProductCard ve ServiceCard için normal mesaj görünümünü gizle -->
                                            <DataTrigger TargetType="Border" Binding="{Binding Type}" Value="ProductCard">
                                                <Setter Property="IsVisible" Value="False"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding Type}" Value="ServiceCard">
                                                <Setter Property="IsVisible" Value="False"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border"
                                                         Binding="{Binding IsSentByMe}"
                                                         Value="True">
                                                <Setter Property="HorizontalOptions" Value="End"/>
                                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}"/>
                                                <Setter Property="Shadow">
                                                    <Shadow Brush="{StaticResource Primary}" Offset="0,2" Radius="8" Opacity="0.3"/>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <VerticalStackLayout Spacing="6">
                                    <!-- Fotoğraf Mesajı -->
                                    <Grid IsVisible="{Binding Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Image}">
                                        <Border StrokeThickness="0"
                                                StrokeShape="RoundRectangle 12"
                                                MaximumWidthRequest="240"
                                                MaximumHeightRequest="200">
                                            <Image Source="{Binding ImageUrl}"
                                                   Aspect="AspectFill"
                                                   WidthRequest="240"
                                                   HeightRequest="200">
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={x:Reference chatPageRoot}, Path=BindingContext.ViewImageCommand}"
                                                        CommandParameter="{Binding ImageUrl}"/>
                                                </Image.GestureRecognizers>
                                            </Image>
                                        </Border>
                                        <ActivityIndicator IsRunning="{Binding IsImageLoading}"
                                                           IsVisible="{Binding IsImageLoading}"
                                                           Color="{StaticResource Primary}"
                                                           VerticalOptions="Center"
                                                           HorizontalOptions="Center"/>
                                    </Grid>

                                    <!-- Text Mesajı -->
                                    <Label Text="{Binding Content}"
                                           LineBreakMode="WordWrap"
                                           FontSize="15"
                                           IsVisible="{Binding Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Text}">
                                        <Label.Style>
                                            <Style TargetType="Label">
                                                <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
                                                <Style.Triggers>
                                                    <DataTrigger TargetType="Label"
                                                                 Binding="{Binding IsSentByMe}"
                                                                 Value="True">
                                                        <Setter Property="TextColor" Value="White"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Label.Style>
                                    </Label>

                                    <!-- Zaman + ✅ FAZ4: WhatsApp-style Delivered/Read tik animasyonu -->
                                    <HorizontalStackLayout Spacing="4" HorizontalOptions="End">
                                        <Label Text="{Binding TimeText}" FontSize="10">
                                            <Label.Style>
                                                <Style TargetType="Label">
                                                    <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger TargetType="Label"
                                                                     Binding="{Binding IsSentByMe}"
                                                                     Value="True">
                                                            <Setter Property="TextColor" Value="#E3F2FD"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Label.Style>
                                        </Label>

                                        <!-- ✅ FAZ4: Seen/Delivered animasyonlu tik -->
                                        <Grid IsVisible="{Binding IsSentByMe}"
                                              WidthRequest="22"
                                              HeightRequest="16">

                                            <!-- Gönderildi (tek tik - gri) -->
                                            <Label Text="✓"
                                                   FontSize="11"
                                                   HorizontalOptions="Start"
                                                   VerticalOptions="Center"
                                                   IsVisible="{Binding IsDelivered, Converter={StaticResource InvertedBoolConverter}}">
                                                <Label.Style>
                                                    <Style TargetType="Label">
                                                        <Setter Property="TextColor" Value="#B0BEC5"/>
                                                    </Style>
                                                </Label.Style>
                                            </Label>

                                            <!-- Teslim edildi (çift tik) -->
                                            <HorizontalStackLayout Spacing="-6"
                                                                   IsVisible="{Binding IsDelivered}"
                                                                   HorizontalOptions="Start"
                                                                   VerticalOptions="Center">
                                                <!-- İlk tik -->
                                                <Label Text="✓" FontSize="11">
                                                    <Label.Style>
                                                        <Style TargetType="Label">
                                                            <Setter Property="TextColor" Value="#E3F2FD"/>
                                                            <Style.Triggers>
                                                                <DataTrigger TargetType="Label"
                                                                             Binding="{Binding IsRead}"
                                                                             Value="True">
                                                                    <Setter Property="TextColor" Value="#4FC3F7"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Label.Style>
                                                </Label>
                                                <!-- İkinci tik -->
                                                <Label Text="✓" FontSize="11">
                                                    <Label.Style>
                                                        <Style TargetType="Label">
                                                            <Setter Property="TextColor" Value="#E3F2FD"/>
                                                            <Style.Triggers>
                                                                <DataTrigger TargetType="Label"
                                                                             Binding="{Binding IsRead}"
                                                                             Value="True">
                                                                    <Setter Property="TextColor" Value="#4FC3F7"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Label.Style>
                                                </Label>
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </syncfusion:SfListView.ItemTemplate>
            </syncfusion:SfListView>
        </RefreshView>

        <!-- ✅ FAZ4: TYPING INDICATOR — WhatsApp-style "yazıyor..." balonu -->
        <Border Grid.Row="4"
                x:Name="TypingIndicatorBorder"
                IsVisible="{Binding IsOtherUserTyping}"
                HorizontalOptions="Start"
                Margin="20,0,20,4"
                Padding="14,10"
                StrokeShape="RoundRectangle 18"
                StrokeThickness="0"
                BackgroundColor="White">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,1" Radius="6" Opacity="0.1"/>
            </Border.Shadow>
            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                <!-- Animasyonlu noktalar -->
                <Ellipse x:Name="TypingDot1"
                         WidthRequest="7" HeightRequest="7"
                         Fill="{StaticResource TextSecondary}"
                         Opacity="0.4"/>
                <Ellipse x:Name="TypingDot2"
                         WidthRequest="7" HeightRequest="7"
                         Fill="{StaticResource TextSecondary}"
                         Opacity="0.7"/>
                <Ellipse x:Name="TypingDot3"
                         WidthRequest="7" HeightRequest="7"
                         Fill="{StaticResource TextSecondary}"
                         Opacity="1.0"/>
                <Label Text="yazıyor"
                       FontSize="12"
                       TextColor="{StaticResource TextSecondary}"
                       FontAttributes="Italic"
                       VerticalOptions="Center"
                       Margin="4,0,0,0"/>
            </HorizontalStackLayout>
        </Border>

        <!-- ✨ MESAJ GÖNDERME ALANI -->
        <Border Grid.Row="5"
               Padding="15,12"
               StrokeShape="RoundRectangle 0"
               StrokeThickness="0"
               BackgroundColor="White"
               x:Name="MessageInputSection">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,-2" Radius="10" Opacity="0.08"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto"
                  ColumnSpacing="8">

                <!-- Fotoğraf Butonu -->
                <Border Grid.Column="0"
                        StrokeShape="RoundRectangle 24"
                        BackgroundColor="#E3F2FD"
                        WidthRequest="48"
                        HeightRequest="48"
                        StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PickImageCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="📷"
                           FontSize="24"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>

                <!-- Teslimatı Onayla Butonu -->
                <Border Grid.Column="1"
                        StrokeShape="RoundRectangle 24"
                        BackgroundColor="#E8F5E9"
                        WidthRequest="48"
                        HeightRequest="48"
                        StrokeThickness="0"
                        IsVisible="{Binding IsDeliveryButtonVisible}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CompleteDeliveryFromChatCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="🛒"
                           FontSize="24"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>

                <!-- 💰 Teklif Ver Butonu — Sabit fiyatlı talepte gizlenir -->
                <Border Grid.Column="1"
        StrokeShape="RoundRectangle 24"
        BackgroundColor="#FFF3E0"
        WidthRequest="48"
        HeightRequest="48"
        StrokeThickness="0">
                    <Border.IsVisible>
                        <MultiBinding Converter="{StaticResource AllTrueConverter}">
                            <Binding Path="HasActiveTransaction"/>
                            <Binding Path="IsNegotiationChat"/>
                            <Binding Path="ActiveTransaction.IsFixedPriceRequest"
                     Converter="{StaticResource InvertedBoolConverter}"/>
                        </MultiBinding>
                    </Border.IsVisible>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ProposeOfferCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="💰"
           FontSize="24"
           HorizontalOptions="Center"
           VerticalOptions="Center"/>
                </Border>

                <!-- Mesaj Entry -->
                <Border Grid.Column="2"
                        Grid.ColumnSpan="2"
                       Padding="14,0"
                       StrokeShape="RoundRectangle 24"
                       StrokeThickness="1"
                       Stroke="{StaticResource BorderColor}"
                       BackgroundColor="{StaticResource Background}"
                       MinimumHeightRequest="48">
                    <Entry Placeholder="{extensions:Translate TypeMessage}"
                           Text="{Binding MessageText}"
                           ReturnCommand="{Binding SendMessageCommand}"
                           MaxLength="1000"
                           VerticalOptions="Center"
                           FontSize="15"
                           TextColor="{StaticResource TextPrimary}"
                           PlaceholderColor="{StaticResource TextSecondary}"
                           BackgroundColor="Transparent"
                           x:Name="MessageEntry">
                    </Entry>
                </Border>

                <!-- Gönder Butonu -->
                <Border Grid.Column="4"
                        StrokeShape="RoundRectangle 24"
                        BackgroundColor="{StaticResource Primary}"
                        WidthRequest="48"
                        HeightRequest="48"
                        StrokeThickness="0">
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource Primary}" Offset="0,3" Radius="8" Opacity="0.3"/>
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SendMessageCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="➤"
                           FontSize="20"
                           TextColor="White"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Margin="2,0,0,0"/>
                </Border>
            </Grid>
        </Border>

        <!-- ✨ Loading Overlay -->
        <Grid Grid.RowSpan="6"
              IsVisible="{Binding IsLoading}"
              BackgroundColor="{StaticResource Background}"
              ZIndex="1100"
              InputTransparent="False">
            <Border BackgroundColor="White"
                    WidthRequest="100"
                    HeightRequest="100"
                    StrokeThickness="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.15" Radius="15" Offset="0,8"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="10"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <ActivityIndicator IsRunning="True"
                                       Color="{StaticResource Primary}"
                                       WidthRequest="40"
                                       HeightRequest="40"/>
                    <Label Text="{extensions:Translate MessagesLoading}"
                           TextColor="{StaticResource Primary}"
                           FontSize="13"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
