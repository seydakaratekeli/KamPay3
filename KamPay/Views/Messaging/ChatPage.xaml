<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:extensions="clr-namespace:KamPay.Extensions"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:KamPay.Models"
             xmlns:res="clr-namespace:KamPay.Services"
             xmlns:converters="clr-namespace:KamPay.Converters"
             xmlns:behaviors="clr-namespace:KamPay.Behaviors"
             xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
             x:Class="KamPay.Views.ChatPage"
             x:Name="chatPageRoot"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Background}">

    <ContentPage.Resources>
        <ResourceDictionary>

            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
            <converters:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        
        <!--  âœ¨ Ã–ZEL HEADER (Gradient + Profil Bilgileri) -->
        <Grid Grid.Row="0" RowDefinitions="Auto" x:Name="HeaderSection">
            <!-- Gradient Background -->
            <BoxView>
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{StaticResource Primary}" Offset="0.0" />
                        <GradientStop Color="{StaticResource PrimaryDark}" Offset="1.0" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

            <!-- Animated Background Circle -->
            <Ellipse x:Name="Circle1" 
                     WidthRequest="150" 
                     HeightRequest="150"
                     Fill="White"
                     Opacity="0.05"
                     HorizontalOptions="End"
                     VerticalOptions="Start"
                     Margin="0,-60,-60,0"/>

            <Grid Padding="15,10,15,15"
                  ColumnDefinitions="Auto,Auto,*"
                  ColumnSpacing="12">
                
                <!-- Geri Butonu -->
                <Border Grid.Column="0"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="LightGray"
                        WidthRequest="40"
                        HeightRequest="40"
                        StrokeThickness="0"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="â†©"
                           FontSize="25"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           FontAttributes="Bold"/>
                </Border>
                
                <!-- Profil FotoÄŸrafÄ± -->
                <Border Grid.Column="1" 
                        StrokeThickness="2"
                        Stroke="White"
                        WidthRequest="50"
                        HeightRequest="50"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="25"/>
                    </Border.StrokeShape>
                    <Grid>
                        <ffimageloading:CachedImage 
                            Source="{Binding OtherUserPhoto}"
                            Aspect="AspectFill"
                            LoadingPlaceholder="person_icon.svg"
                            ErrorPlaceholder="person_icon.svg"
                            DownsampleToViewSize="True"
                            CacheDuration="7"
                            RetryCount="3"
                            RetryDelay="250">
                            <ffimageloading:CachedImage.Clip>
                                <EllipseGeometry Center="25,25" RadiusX="25" RadiusY="25"/>
                            </ffimageloading:CachedImage.Clip>
                        </ffimageloading:CachedImage>
                        
                        <!-- Online indicator -->
                        <Border WidthRequest="14" 
                                HeightRequest="14" 
                                BackgroundColor="Blue" 
                                StrokeThickness="2"
                                Stroke="White"
                                HorizontalOptions="End"
                                VerticalOptions="End"
                                Margin="0,0,-2,-2"
                                IsVisible="{Binding IsOtherUserOnline}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="7"/>
                            </Border.StrokeShape>
                        </Border>
                    </Grid>
                </Border>
                
                <!-- Ä°sim ve Son GÃ¶rÃ¼lme Durumu -->
                <VerticalStackLayout Grid.Column="2" 
                                     VerticalOptions="Center"
                                     Spacing="3">
                    <Label Text="{Binding OtherUserName, FallbackValue='YÃ¼kleniyor...'}"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White"
                           LineBreakMode="TailTruncation"
                           MaxLines="1"/>

                    <Label Text="{Binding OnlineStatusText, FallbackValue='BaÄŸlanÄ±yor...'}"
                           FontSize="12"
                           TextColor="White"
                           Opacity="0.85"/>
                </VerticalStackLayout>
            </Grid>
        </Grid>

        <!-- âœ¨ AKTÄ°F Ä°ÅLEMLER (TRANSACTION CHIPS) -->
        <Border Grid.Row="1"
                IsVisible="{Binding HasActiveTransactions}"
                BackgroundColor="#F8F9FA"
                StrokeThickness="0"
                Padding="0,8,0,8"
                ZIndex="5">
            <CollectionView ItemsSource="{Binding ActiveTransactions}"
                            HeightRequest="60"
                            SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Transaction">
                        <Border StrokeShape="RoundRectangle 20"
                                Stroke="{StaticResource Primary}"
                                StrokeThickness="1"
                                BackgroundColor="White"
                                Padding="12,6"
                                Margin="12,0,0,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectActiveTransactionCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Label Text="ğŸ“¦" VerticalOptions="Center" FontSize="14"/>
                                <Label Text="{Binding ProductName}" 
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       FontSize="12"
                                       TextColor="{StaticResource TextPrimary}" />
                                <Label Text="{Binding Price, StringFormat='{0:N2} â‚º'}"
                                       VerticalOptions="Center"
                                       FontSize="12"
                                       TextColor="{StaticResource Primary}"
                                       FontAttributes="Bold" />
                                <Border BackgroundColor="#E8F5E9" Padding="6,2" StrokeShape="RoundRectangle 10" StrokeThickness="0">
                                    <Label Text="{Binding Status}" FontSize="10" TextColor="#2E7D32" FontAttributes="Bold" />
                                </Border>
                            </HorizontalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>

        <!--  âœ¨ Mesaj Listesi -->
        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding RefreshMessagesCommand}"
                     RefreshColor="{StaticResource Primary}"
                     IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">

            <syncfusion:SfListView x:Name="MessagesListView"
                                   ItemsSource="{Binding Messages}"
                                   AutoFitMode="Height"
                                   SelectionMode="None"
                                   Margin="15,10,15,10">
                <syncfusion:SfListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Message">
                        <Grid Padding="0,4">
                            
                            <!--  System MesajÄ± - Mavi ton -->
                            <Border Padding="12,8"
                                   StrokeShape="RoundRectangle 12"
                                   StrokeThickness="0"
                                   BackgroundColor="{StaticResource SystemMessageBg}"
                                   HorizontalOptions="Center"
                                   MaximumWidthRequest="300"
                                   IsVisible="{Binding Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=System}">
                                <Label Text="{Binding Content}"
                                       LineBreakMode="WordWrap"
                                       TextColor="{StaticResource Primary}"
                                       FontSize="12"
                                       HorizontalTextAlignment="Center"
                                       FontAttributes="Bold"/>
                            </Border>
                            
                            <!-- ğŸ’° PAZARLIK MESAJI (Negotiation) -->
                            <Border Padding="12"
                                   StrokeShape="RoundRectangle 16"
                                   StrokeThickness="0"
                                   MaximumWidthRequest="280"
                                   IsVisible="{Binding Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Negotiation}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="HorizontalOptions" Value="Center" />
                                        <Setter Property="BackgroundColor" Value="#FFF3E0" /> <!-- Turuncumsu Arka Plan -->
                                        <Setter Property="Shadow">
                                            <Shadow Brush="Black" Offset="0,2" Radius="6" Opacity="0.1"/>
                                        </Setter>
                                    </Style>
                                </Border.Style>

                                <VerticalStackLayout Spacing="8">
                                    <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                                        <Label Text="ğŸ’°" FontSize="18" VerticalOptions="Center"/>
                                        <Label Text="{Binding NegotiationAction}" FontAttributes="Bold" FontSize="12" TextColor="#F57C00" VerticalOptions="Center" TextTransform="Uppercase"/>
                                    </HorizontalStackLayout>
                                    
                                    <Label Text="{Binding Content}"
                                           LineBreakMode="WordWrap"
                                           TextColor="{StaticResource TextPrimary}"
                                           FontSize="15"
                                           HorizontalTextAlignment="Center"
                                           FontAttributes="Bold"/>
                                    
                                    <!-- Butonlar kÄ±smÄ±: Sadece karÅŸÄ± tarafÄ±n gÃ¶nderdiÄŸi teklifler iÃ§in butonlarÄ± gÃ¶ster (Kendi teklifini kabul edemezsin) -->
                                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,5,0,0"
                                                           IsVisible="{Binding IsSentByMe, Converter={StaticResource InvertedBoolConverter}}">
                                        <Button Text="Kabul Et"
                                                BackgroundColor="#4CAF50"
                                                TextColor="White"
                                                HeightRequest="36"
                                                CornerRadius="18"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                Padding="10,0"
                                                Command="{Binding Source={x:Reference chatPageRoot}, Path=BindingContext.AcceptOfferCommand}"
                                                CommandParameter="{Binding .}" />
                                                
                                        <Button Text="KarÅŸÄ± Teklif"
                                                BackgroundColor="{StaticResource Primary}"
                                                TextColor="White"
                                                HeightRequest="36"
                                                CornerRadius="18"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                Padding="10,0"
                                                Command="{Binding Source={x:Reference chatPageRoot}, Path=BindingContext.ProposeOfferCommand}"
                                                CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                            
                            <!--  Normal Mesajlar -->
                            <Border Padding="12"
                                   StrokeShape="RoundRectangle 16"
                                   StrokeThickness="0"
                                   MaximumWidthRequest="280">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="HorizontalOptions" Value="Start" />
                                        <Setter Property="BackgroundColor" Value="#FFFFFF" />
                                        <Setter Property="IsVisible" Value="True" />
                                        <Setter Property="Shadow">
                                            <Shadow Brush="Black" Offset="0,1" Radius="6" Opacity="0.08"/>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding Type}" Value="System">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding Type}" Value="Negotiation">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border"
                                                         Binding="{Binding IsSentByMe}"
                                                         Value="True">
                                                <Setter Property="HorizontalOptions" Value="End" />
                                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                <Setter Property="Shadow">
                                                    <Shadow Brush="{StaticResource Primary}" Offset="0,2" Radius="8" Opacity="0.3"/>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <VerticalStackLayout Spacing="6">
                                    <!--  FotoÄŸraf MesajÄ± -->
                                    <Grid IsVisible="{Binding Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Image}">
                                        <Border StrokeThickness="0"
                                                StrokeShape="RoundRectangle 12"
                                                MaximumWidthRequest="240"
                                                MaximumHeightRequest="200">
                                            <Image Source="{Binding ImageUrl}"
                                                   Aspect="AspectFill"
                                                   WidthRequest="240"
                                                   HeightRequest="200">
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={x:Reference chatPageRoot}, Path=BindingContext.ViewImageCommand}"
                                                                          CommandParameter="{Binding ImageUrl}" />
                                                </Image.GestureRecognizers>
                                            </Image>
                                        </Border>
                                        <ActivityIndicator IsRunning="{Binding IsImageLoading}"
                                                           IsVisible="{Binding IsImageLoading}"
                                                           Color="{StaticResource Primary}"
                                                           VerticalOptions="Center"
                                                           HorizontalOptions="Center" />
                                    </Grid>

                                    <!--  Text MesajÄ± -->
                                    <Label Text="{Binding Content}"
                                           LineBreakMode="WordWrap"
                                           FontSize="15"
                                           IsVisible="{Binding Type, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Text}">
                                        <Label.Style>
                                            <Style TargetType="Label">
                                                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                                                <Style.Triggers>
                                                    <DataTrigger TargetType="Label"
                                                                 Binding="{Binding IsSentByMe}"
                                                                 Value="True">
                                                        <Setter Property="TextColor" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Label.Style>
                                    </Label>

                                    <!-- Zaman ve Durum -->
                                    <HorizontalStackLayout Spacing="4" HorizontalOptions="End">
                                        <Label Text="{Binding TimeText}"
                                               FontSize="10">
                                            <Label.Style>
                                                <Style TargetType="Label">
                                                    <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                                                    <Style.Triggers>
                                                        <DataTrigger TargetType="Label"
                                                                     Binding="{Binding IsSentByMe}"
                                                                     Value="True">
                                                            <Setter Property="TextColor" Value="#E3F2FD" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Label.Style>
                                        </Label>

                                        <Label FontSize="11"
                                               IsVisible="{Binding IsSentByMe}"
                                               TextColor="#E3F2FD">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" 
                                                            Binding="{Binding IsDelivered}" 
                                                            Value="False">
                                                    <Setter Property="Text" Value="â±" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" 
                                                            Binding="{Binding IsDelivered}" 
                                                            Value="True">
                                                    <Setter Property="Text" Value="âœ“âœ“" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </syncfusion:SfListView.ItemTemplate>
            </syncfusion:SfListView>
        </RefreshView>

        <!-- âœ¨ Mesaj GÃ¶nderme AlanÄ± -->
        <Border Grid.Row="3"
               Padding="15,12"
               StrokeShape="RoundRectangle 0"
               StrokeThickness="0"
               BackgroundColor="White"
               x:Name="MessageInputSection">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,-2" Radius="10" Opacity="0.08"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto"
                  ColumnSpacing="8">
                
                <!--  FotoÄŸraf Butonu -->
                <Border Grid.Column="0"
                        StrokeShape="RoundRectangle 24"
                        BackgroundColor="#E3F2FD"
                        WidthRequest="48"
                        HeightRequest="48"
                        StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PickImageCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="ğŸ“·"
                           FontSize="24"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>
                
                <!-- ğŸ›’ TeslimatÄ± Onayla Butonu -->
                <Border Grid.Column="1"
                        StrokeShape="RoundRectangle 24"
                        BackgroundColor="#E8F5E9"
                        WidthRequest="48"
                        HeightRequest="48"
                        StrokeThickness="0"
                        IsVisible="{Binding IsDeliveryButtonVisible}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CompleteDeliveryFromChatCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="ğŸ›’"
                           FontSize="24"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>
                <!-- ğŸ’° Teklif Ver Butonu (Sadece ActiveTransaction varsa) -->
                <Border Grid.Column="1"
                        StrokeShape="RoundRectangle 24"
                        BackgroundColor="#FFF3E0"
                        WidthRequest="48"
                        HeightRequest="48"
                        StrokeThickness="0"
                        IsVisible="{Binding HasActiveTransaction}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ProposeOfferCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="ğŸ’°"
                           FontSize="24"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>
                
                <!--  Mesaj Entry -->
                <Border Grid.Column="2"
                        Grid.ColumnSpan="2"
                       Padding="14,0"
                       StrokeShape="RoundRectangle 24"
                       StrokeThickness="1"
                       Stroke="{StaticResource BorderColor}"
                       BackgroundColor="{StaticResource Background}"
                       MinimumHeightRequest="48">
                    <Entry Placeholder="{extensions:Translate TypeMessage}"
                           Text="{Binding MessageText}"
                           ReturnCommand="{Binding SendMessageCommand}"
                           MaxLength="1000"
                           VerticalOptions="Center"
                           FontSize="15"
                           TextColor="{StaticResource TextPrimary}"
                           PlaceholderColor="{StaticResource TextSecondary}"
                           BackgroundColor="Transparent" />
                </Border>

                <!-- GÃ¶nder Butonu -->
                <Border Grid.Column="4"
                        StrokeShape="RoundRectangle 24"
                        BackgroundColor="{StaticResource Primary}"
                        WidthRequest="48"
                        HeightRequest="48"
                        StrokeThickness="0">
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource Primary}" Offset="0,3" Radius="8" Opacity="0.3"/>
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SendMessageCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="â¤"
                           FontSize="20"
                           TextColor="White"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Margin="2,0,0,0"/>
                </Border>
            </Grid>
        </Border>

        <!--  âœ¨ Loading Overlay -->
        <Grid Grid.RowSpan="4"
              IsVisible="{Binding IsLoading}"
              BackgroundColor="{StaticResource Background}"
              ZIndex="1100"
              InputTransparent="False">
            <Border BackgroundColor="White"
                    WidthRequest="100"
                    HeightRequest="100"
                    StrokeThickness="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.15" Radius="15" Offset="0,8"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                    <ActivityIndicator IsRunning="True"
                                       Color="{StaticResource Primary}"
                                       WidthRequest="40"
                                       HeightRequest="40" />
                    <Label Text="{extensions:Translate MessagesLoading}"
                           TextColor="{StaticResource Primary}"
                           FontSize="13" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>



