<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:KamPay.ViewModels"
             xmlns:models="clr-namespace:KamPay.Models"
             xmlns:conv="clr-namespace:KamPay.Converters"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
             xmlns:res="clr-namespace:KamPay.Services"
             x:Class="KamPay.Views.EditProductPage"
             Shell.NavBarIsVisible="False">

    <Grid>
        <!-- Gradient Background Header -->
        <BoxView VerticalOptions="Start" HeightRequest="180">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1E88E5" Offset="0.0" />
                    <GradientStop Color="#1565C0" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- Animated Background Circle -->
        <Ellipse x:Name="Circle1" 
                 WidthRequest="220" 
                 HeightRequest="220"
                 Fill="White"
                 Opacity="0.05"
                 HorizontalOptions="End"
                 VerticalOptions="Start"
                 Margin="0,-80,-80,0"/>

        <ScrollView>
            <VerticalStackLayout x:Name="MainContent" Spacing="0">

                <!-- Header Section -->
                <VerticalStackLayout x:Name="HeaderSection" Spacing="10" Padding="20,40,20,25">
                    <Label Text="✏️" FontSize="42" HorizontalOptions="Center"/>
                    <Label Text="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[EditProduct]}"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"/>
                    <Label Text="Ürününüzü güncelleyin"
                           FontSize="13"
                           TextColor="White"
                           Opacity="0.9"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Main Form Card -->
                <Border x:Name="FormCard"
                        BackgroundColor="White"
                        StrokeThickness="0"
                        Padding="20"
                        Margin="15,-15,15,20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.15" Radius="20" Offset="0,8"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">

                        <!-- Error Message -->
                        <Border IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}"
                                BackgroundColor="#FFEBEE"
                                StrokeThickness="0"
                                Padding="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Label Text="{Binding ErrorMessage}"
                                   TextColor="#EF5350"
                                   FontSize="13"
                                   FontAttributes="Bold"/>
                        </Border>

                        <!-- Product Info Section -->
                        <Label Text="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[ProductInfo]}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#212121"/>

                        <!-- Title Input -->
                        <Border BackgroundColor="#F5F9FC" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Entry Placeholder="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[ProductTitle]}"
                                   Text="{Binding Title}"
                                   MaxLength="100"
                                   FontSize="15"
                                   TextColor="#212121"
                                   PlaceholderColor="#9E9E9E"
                                   BackgroundColor="Transparent"
                                   HeightRequest="48"
                                   Margin="16,0"/>
                        </Border>

                        <!-- Description Input -->
                        <Border BackgroundColor="#F5F9FC" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Editor Placeholder="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[ProductDescription]}"
                                    Text="{Binding Description}"
                                    MinimumHeightRequest="100"
                                    MaxLength="1000"
                                    FontSize="15"
                                    TextColor="#212121"
                                    PlaceholderColor="#9E9E9E"
                                    BackgroundColor="Transparent"
                                    AutoSize="TextChanges"
                                    Margin="16,8"/>
                        </Border>

                        <!-- Category Picker -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[Category]}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#757575"/>
                            <Border BackgroundColor="#F5F9FC" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Picker ItemsSource="{Binding Categories}"
                                        SelectedItem="{Binding SelectedCategory}"
                                        ItemDisplayBinding="{Binding Name}"
                                        FontSize="15"
                                        TextColor="#212121"
                                        Title="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[SelectCategory]}"
                                        BackgroundColor="Transparent"
                                        Margin="16,0"
                                        HeightRequest="48"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Product Type Picker -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[ProductType]}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#757575"/>
                            <Border BackgroundColor="#F5F9FC" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Picker ItemsSource="{Binding ProductTypes}"
                                        SelectedItem="{Binding SelectedType}"
                                        FontSize="15"
                                        TextColor="#212121"
                                        Title="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[SelectType]}"
                                        BackgroundColor="Transparent"
                                        Margin="16,0"
                                        HeightRequest="48">
                                    <Picker.ItemDisplayBinding>
                                        <Binding>
                                            <Binding.Converter>
                                                <conv:ProductTypeConverter/>
                                            </Binding.Converter>
                                        </Binding>
                                    </Picker.ItemDisplayBinding>
                                </Picker>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Price Input -->
                        <Border IsVisible="{Binding ShowPriceField}"
                                BackgroundColor="#F5F9FC"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Grid Padding="16,0" ColumnDefinitions="*,Auto">
                                <Entry Grid.Column="0"
                                       Placeholder="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[Price]}"
                                       Text="{Binding Price}"
                                       Keyboard="Numeric"
                                       FontSize="15"
                                       TextColor="#212121"
                                       PlaceholderColor="#9E9E9E"
                                       BackgroundColor="Transparent"
                                       HeightRequest="48"/>
                                <Label Grid.Column="1"
                                       Text="₺"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="#1E88E5"
                                       VerticalOptions="Center"
                                       Margin="0,0,8,0"/>
                            </Grid>
                        </Border>

                        <!-- Exchange Preference -->
                        <Border IsVisible="{Binding ShowExchangeField}"
                                BackgroundColor="#F5F9FC"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Entry Placeholder="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[WhatToExchange]}"
                                   Text="{Binding ExchangePreference}"
                                   FontSize="15"
                                   TextColor="#212121"
                                   PlaceholderColor="#9E9E9E"
                                   BackgroundColor="Transparent"
                                   HeightRequest="48"
                                   Margin="16,0"/>
                        </Border>

                        <!-- Condition Picker -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[ProductCondition]}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#757575"/>
                            <Border BackgroundColor="#F5F9FC" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Picker ItemsSource="{Binding Conditions}"
                                        SelectedItem="{Binding SelectedCondition}"
                                        FontSize="15"
                                        TextColor="#212121"
                                        Title="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[SelectCondition]}"
                                        BackgroundColor="Transparent"
                                        Margin="16,0"
                                        HeightRequest="48">
                                    <Picker.ItemDisplayBinding>
                                        <Binding>
                                            <Binding.Converter>
                                                <conv:ProductConditionConverter/>
                                            </Binding.Converter>
                                        </Binding>
                                    </Picker.ItemDisplayBinding>
                                </Picker>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Location Section -->
                        <VerticalStackLayout Spacing="12">
                            <Label Text="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[Location]}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#757575"/>

                            <Border StrokeShape="RoundRectangle 16"
                                    StrokeThickness="0"
                                    HeightRequest="220">
                                <Border.Shadow>
                                    <Shadow Brush="Black" Opacity="0.08" Radius="8" Offset="0,2"/>
                                </Border.Shadow>
                                <Grid>
                                    <mapsui:MapControl x:Name="ProductMap"
                                                       VerticalOptions="FillAndExpand"
                                                       HorizontalOptions="FillAndExpand"/>

                                    <!-- Zoom Controls -->
                                    <VerticalStackLayout HorizontalOptions="End"
                                                        VerticalOptions="Start"
                                                        Margin="12"
                                                        Spacing="8">

                                        <Border StrokeShape="RoundRectangle 20"
                                                BackgroundColor="White"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                Padding="0">
                                            <Border.Shadow>
                                                <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.2"/>
                                            </Border.Shadow>
                                            <Button Text="+"
                                                    Clicked="OnZoomInClicked"
                                                    FontSize="22"
                                                    FontAttributes="Bold"
                                                    BackgroundColor="Transparent"
                                                    TextColor="#212121"
                                                    WidthRequest="40"
                                                    HeightRequest="40"
                                                    Padding="0"/>
                                        </Border>

                                        <Border StrokeShape="RoundRectangle 20"
                                                BackgroundColor="White"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                Padding="0">
                                            <Border.Shadow>
                                                <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.2"/>
                                            </Border.Shadow>
                                            <Button Text="−"
                                                    Clicked="OnZoomOutClicked"
                                                    FontSize="22"
                                                    FontAttributes="Bold"
                                                    BackgroundColor="Transparent"
                                                    TextColor="#212121"
                                                    WidthRequest="40"
                                                    HeightRequest="40"
                                                    Padding="0"/>
                                        </Border>

                                        <BoxView HeightRequest="1"
                                                 WidthRequest="30"
                                                 BackgroundColor="#E0E0E0"
                                                 HorizontalOptions="Center"
                                                 Margin="0,4"/>

                                        <Border StrokeShape="RoundRectangle 20"
                                                BackgroundColor="White"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                Padding="0">
                                            <Border.Shadow>
                                                <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.2"/>
                                            </Border.Shadow>
                                            <Button Text="📍"
                                                    Command="{Binding UseCurrentLocationCommand}"
                                                    FontSize="18"
                                                    BackgroundColor="Transparent"
                                                    TextColor="#1E88E5"
                                                    WidthRequest="40"
                                                    HeightRequest="40"
                                                    Padding="0"/>
                                        </Border>

                                        <Border StrokeShape="RoundRectangle 20"
                                                BackgroundColor="White"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                Padding="0">
                                            <Border.Shadow>
                                                <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.2"/>
                                            </Border.Shadow>
                                            <Button Text="🎯"
                                                    Clicked="OnResetLocationClicked"
                                                    FontSize="18"
                                                    BackgroundColor="Transparent"
                                                    TextColor="#2196F3"
                                                    WidthRequest="40"
                                                    HeightRequest="40"
                                                    Padding="0"/>
                                        </Border>
                                    </VerticalStackLayout>

                                    <!-- Location Display -->
                                    <Border StrokeShape="RoundRectangle 12"
                                            BackgroundColor="White"
                                            Padding="12"
                                            Margin="12"
                                            VerticalOptions="End"
                                            HorizontalOptions="FillAndExpand"
                                            IsVisible="{Binding HasLocation}">
                                        <Border.Shadow>
                                            <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.2"/>
                                        </Border.Shadow>
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="📌" FontSize="16" VerticalOptions="Center"/>
                                            <Label Text="{Binding Location}"
                                                   FontSize="12"
                                                   TextColor="#212121"
                                                   VerticalOptions="Center"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="2"
                                                   HorizontalOptions="FillAndExpand"/>
                                        </HorizontalStackLayout>
                                    </Border>
                                </Grid>
                            </Border>
                            <Label Text="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[MapLocationInfo]}"
                                   FontSize="12"
                                   TextColor="#9E9E9E"/>
                        </VerticalStackLayout>

                        <!-- Images Section -->
                        <VerticalStackLayout Spacing="12">
                            <Label Text="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[ProductImages]}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#757575"/>

                            <Button Text="📷 Resim Ekle"
                                    Command="{Binding PickImagesCommand}"
                                    BackgroundColor="#E3F2FD"
                                    TextColor="#1E88E5"
                                    FontAttributes="Bold"
                                    CornerRadius="12"
                                    HeightRequest="50"
                                    BorderColor="#1E88E5"
                                    BorderWidth="2"/>

                            <FlexLayout BindableLayout.ItemsSource="{Binding ImagePaths}"
                                        Wrap="Wrap"
                                        JustifyContent="Start">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border StrokeShape="RoundRectangle 12"
                                                StrokeThickness="0"
                                                WidthRequest="100"
                                                HeightRequest="100"
                                                Margin="4">
                                            <Border.Shadow>
                                                <Shadow Brush="Black" Opacity="0.1" Radius="4" Offset="0,2"/>
                                            </Border.Shadow>
                                            <Grid>
                                                <Image Source="{Binding .}" Aspect="AspectFill"/>
                                                <Button Text="✕"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EditProductViewModel}}, Path=RemoveImageCommand}"
                                                        CommandParameter="{Binding .}"
                                                        BackgroundColor="#EF5350"
                                                        TextColor="White"
                                                        FontSize="16"
                                                        FontAttributes="Bold"
                                                        WidthRequest="32"
                                                        HeightRequest="32"
                                                        CornerRadius="16"
                                                        Padding="0"
                                                        HorizontalOptions="End"
                                                        VerticalOptions="Start"
                                                        Margin="4"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>

                        <!-- Action Buttons -->
                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="12"
                              Margin="0,20,0,0">
                            <Button Grid.Column="0"
                                    Text="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[Cancel]}"
                                    Command="{Binding CancelCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="#757575"
                                    BorderColor="#E0E0E0"
                                    BorderWidth="2"
                                    CornerRadius="12"
                                    FontAttributes="Bold"
                                    HeightRequest="54"/>

                            <Button Grid.Column="1"
                                    Text="{Binding Source={x:Static res:LocalizationResourceManager.Instance}, Path=[Update]}"
                                    Command="{Binding SaveProductCommand}"
                                    BackgroundColor="#1E88E5"
                                    TextColor="White"
                                    CornerRadius="12"
                                    FontAttributes="Bold"
                                    HeightRequest="54">
                                <Button.Shadow>
                                    <Shadow Brush="#1E88E5" Opacity="0.3" Radius="10" Offset="0,4"/>
                                </Button.Shadow>
                            </Button>
                        </Grid>

                        <!-- Loading Indicator -->
                        <ActivityIndicator IsRunning="{Binding IsLoading}"
                                           IsVisible="{Binding IsLoading}"
                                           Color="#1E88E5"
                                           HeightRequest="40"
                                           Margin="0,10"/>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>