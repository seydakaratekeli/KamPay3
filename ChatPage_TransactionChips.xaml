<?xml version="1.0" encoding="utf-8" ?>
<Border xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
        xmlns:models="clr-namespace:KamPay.Models"
        Grid.Row="1"
        IsVisible="{Binding HasActiveTransactions}"
        BackgroundColor="#F8F9FA"
        StrokeThickness="0"
        Padding="0,8,0,8"
        ZIndex="5">
    <CollectionView ItemsSource="{Binding ActiveTransactions}"
                    HeightRequest="60"
                    SelectionMode="None">
        <CollectionView.ItemsLayout>
            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12" />
        </CollectionView.ItemsLayout>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:Transaction">
                <Border StrokeShape="RoundRectangle 20"
                        Stroke="{StaticResource Primary}"
                        StrokeThickness="1"
                        BackgroundColor="White"
                        Padding="12,6"
                        Margin="12,0,0,0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectActiveTransactionCommand}"
                                              CommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="ğŸ“¦" VerticalOptions="Center" FontSize="14"/>
                        <Label Text="{Binding ProductName}" 
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               FontSize="12"
                               TextColor="{StaticResource TextPrimary}" />
                        <Label Text="{Binding Price, StringFormat='{0:N2} â‚º'}"
                               VerticalOptions="Center"
                               FontSize="12"
                               TextColor="{StaticResource Primary}"
                               FontAttributes="Bold" />
                        <Border BackgroundColor="#E8F5E9" Padding="6,2" StrokeShape="RoundRectangle 10" StrokeThickness="0">
                            <Label Text="{Binding Status}" FontSize="10" TextColor="#2E7D32" FontAttributes="Bold" />
                        </Border>
                    </HorizontalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</Border>

